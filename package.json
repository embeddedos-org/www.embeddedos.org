{
  "name": "embeddedos-website",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "pnpm build:client && pnpm prerender && pnpm build:server",
    "build:client": "NODE_ENV=production vite build",
    "build:server": "NODE_ENV=production esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "prerender": "node scripts/prerender.mjs",
    "deploy:branch": "node scripts/deploy-branch.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "sync:stack": "node scripts/sync-stack-data.mjs",
    "audit:site": "node scripts/audit.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:perf": "vitest run tests/performance",
    "test:server": "vitest run server/",
    "test:e2e": "playwright test e2e/controls-interaction.spec.ts e2e/journeys.spec.ts e2e/links-and-controls.spec.ts e2e/link-destinations.spec.ts",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:regression": "playwright test e2e/regression.spec.ts",
    "test:a11y": "playwright test e2e/ui-ux.spec.ts",
    "test:acceptance": "playwright test e2e/acceptance-adgrants.spec.ts",
    "test:functional": "playwright test e2e/functional.spec.ts",
    "test:journeys": "playwright test e2e/journeys.spec.ts e2e/links-and-controls.spec.ts",
    "test:controls": "playwright test e2e/controls-interaction.spec.ts",
    "test:links": "LINK_SWEEP=1 playwright test e2e/link-destinations.spec.ts",
    "test:all": "pnpm check && pnpm lint && pnpm build && pnpm test && pnpm test:php && pnpm audit:site && pnpm audit:mobile && pnpm test:e2e:all",
    "test:php": "php tests/php/apply.test.php",
    "test:e2e:all": "playwright test"
  },
