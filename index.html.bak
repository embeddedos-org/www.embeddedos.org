"dropdown-menu" role="menu"><li role="none"><a href="research.html" role="menuitem">Neural Link Architecture</a></li><li role="none"><a href="neural-link-ai.html" role="menuitem">Neural Link &amp; AI Integration</a></li><li role="none"><a href="ai-os.html" role="menuitem">AI Operating Systems</a></li><li role="none"><a href="building-os.html" role="menuitem">Building OS with Linux/RTOS</a></li><li role="none"><a href="future-research.html" role="menuitem">Future Research</a></li></ul></li><li role="none"><a href="membership.html" role="menuitem" aria-haspopup="true" aria-expanded="false">Programs <span class="nav-caret" aria-hidden="true">▾</span></a><ul class="dropdown-menu" role="menu"><li role="none"><a href="membership.html" role="menuitem">Membership</a></li><li role="none"><a href="certification.html" role="menuitem">Certification</a></li><li role="none"><a href="internship.html" role="menuitem">Internship</a></li><li role="none"><a href="careers.html" role="menuitem">Careers</a></li></ul></li><li role="none"><a href="products.html" role="menuitem" aria-haspopup="true" aria-expanded="false">Products <span class="nav-caret" aria-hidden="true">▾</span></a><ul class="dropdown-menu" role="menu"><li role="none"><a href="product-eos.html" role="menuitem">EoS (RTOS)</a></li><li role="none"><a href="product-eos-platform.html" role="menuitem">eos-platform</a></li><li role="none"><a href="product-eboot.html" role="menuitem">eBootloader</a></li><li role="none"><a href="product-ebuild.html" role="menuitem">eBuild</a></li><li role="none"><a href="product-eai.html" role="menuitem">EAI</a></li><li role="none"><a href="product-eni.html" role="menuitem">ENI</a></li><li role="none"><a href="product-eipc.html" role="menuitem">EIPC</a></li><li role="none"><a href="product-eapps.html" role="menuitem">eApps</a></li><li role="none"><a href="product-eosim.html" role="menuitem">EoSim</a></li><li role="none"><a href="product-eostudio.html" role="menuitem">EoStudio</a></li><li role="none"><a href="product-edb.html" role="menuitem">eDB</a></li><li role="none"><a href="product-ebowser.html" role="menuitem">eBowser</a></li><li role="none"><a href="product-eoffice.html" role="menuitem">eOffice</a></li><li role="none"><a href="product-eserviceapps.html" role="menuitem">eServiceApps</a></li></ul></li><li role="none"><a href="ecosystem.html" role="menuitem">Ecosystem</a></li><li role="none"><a href="about.html" role="menuitem">About</a></li><li role="none"><a href="contact.html" role="menuitem">Contact</a></li><li role="none"><a href="membership.html" class="nav-cta" role="menuitem">Join Now</a></li></ul></nav><button class="mobile-menu-btn" aria-label="Toggle navigation menu" aria-controls="nav-links" aria-expanded="false"><span class="hamburger-line"></span></button></div></div></header><section class="top-hero" aria-label="Foundation hero"><picture class="top-hero__media"><source type="image/webp" srcset="img/photos/homepage-hero-640w.webp 640w, img/photos/homepage-hero-1024w.webp 1024w, img/photos/homepage-hero.webp 1600w" sizes="100vw"><source type="image/jpeg" srcset="img/photos/homepage-hero-640w.jpg 640w, img/photos/homepage-hero-1024w.jpg 1024w, img/photos/homepage-hero.jpg 1600w" sizes="100vw"><img src="img/photos/homepage-hero.jpg" alt="Macro of an embedded microcontroller — open-source embedded AI" width="2400" height="900" loading="eager" decoding="sync" fetchpriority="high"></picture><div class="top-hero__overlay"><div class="top-hero__inner"><span class="tech-eyebrow">EmbeddedOS · 501(c)(3) Foundation</span><h1 class="top-hero__title">Open-source embedded AI for the next decade</h3><p class="top-hero__lede">14 components. From bare-metal boot to on-device LLM inference. Built by the foundation, governed by the community, deployed everywhere from microcontrollers to neural interfaces.</p><div class="top-hero__cta"><a href="ecosystem.html" class="btn-primary">Explore the ecosystem</a><a href="news.html" class="btn-outline-light">Read the latest →</a></div></div></div></section><main id="main-content"><div class="pub-front"><div class="pub-front__main"><section aria-label="Featured"><a class="article-card article-card--hero" href="article-eos-platform-launch.html" data-topic="apps-platforms"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/platform-launch-640w.webp 640w, img/photos/platform-launch-1024w.webp 1024w, img/photos/platform-launch.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/platform-launch-640w.jpg 640w, img/photos/platform-launch-1024w.jpg 1024w, img/photos/platform-launch.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/platform-launch.jpg" alt="Glowing PCB and microcontroller — eos-platform 1.0 launch" width="1200" height="680" loading="eager" decoding="sync" fetchpriority="high"></picture></div><div class="article-card__body"><span class="kicker">Apps & Platforms</span><h3 class="article-card__title">eos-platform 1.0 lands: one toolchain, every EoS profile</h1><p class="article-card__dek">After eighteen months of incremental releases, the eos-platform meta-distribution reaches 1.0 with stable APIs, a unified package manifest, and reproducible builds across all 14 EoS components.</p><p class="article-card__byline">EoS Editorial · 2026-05-12 · 7 min read</p></div></a></section><section class="topic-strip mesh-bg" style="padding:1.5rem 0;border-bottom:1px solid var(--clr-g200)" aria-label="Foundation focus"><header class="topic-strip__head" style="border:none;padding-bottom:.4rem"><h2 style="font-size:1.05rem;letter-spacing:-.005em"><span class="tech-eyebrow">AI · ML · NEURAL · RTOS</span></h2><a href="research.html">Foundation research →</a></header><div class="tech-metrics"><div class="tech-metric"><div class="tech-metric__value">14</div><div class="tech-metric__label">Open-source components</div></div><div class="tech-metric"><div class="tech-metric__value">11 tok/s</div><div class="tech-metric__label">INT4 LLM @ 480 MHz M85</div></div><div class="tech-metric"><div class="tech-metric__value">1024-ch</div><div class="tech-metric__label">ENI neural pipeline @ 800 µs</div></div><div class="tech-metric"><div class="tech-metric__value">501(c)(3)</div><div class="tech-metric__label">Member-governed nonprofit</div></div></div></section><section class="pub-secondary" aria-label="Editor highlights"><a class="article-card article-card--lg" href="article-eai-llm-bench.html" data-topic="embedded-ai"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/ai-llm-chip-640w.webp 640w, img/photos/ai-llm-chip-1024w.webp 1024w, img/photos/ai-llm-chip.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/ai-llm-chip-640w.jpg 640w, img/photos/ai-llm-chip-1024w.jpg 1024w, img/photos/ai-llm-chip.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/ai-llm-chip.jpg" alt="Microcontroller close-up — INT4 LLM inference" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker kicker--purple">Embedded AI</span><h3 class="article-card__title">EAI 0.9 ships INT4 LLM runtime — 11 tok/s on a Cortex-M85</h3><p class="article-card__dek">EAI's new quantized inference path squeezes a 1.3B-parameter model into 312 MB of flash and runs at interactive speed on a 480 MHz microcontroller. We dig into the kernel scheduler that made it possible.</p><p class="article-card__byline">EoS Editorial · 2026-05-10 · 9 min read</p></div></a><a class="article-card article-card--lg" href="article-eni-1024-channel-pipeline.html" data-topic="neural-interface"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/neural-array-640w.webp 640w, img/photos/neural-array-1024w.webp 1024w, img/photos/neural-array.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/neural-array-640w.jpg 640w, img/photos/neural-array-1024w.jpg 1024w, img/photos/neural-array.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/neural-array.jpg" alt="Electrode-like circuit — 1024-channel neural pipeline" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker kicker--teal">Neural Interface</span><h3 class="article-card__title">ENI's 1,024-channel pipeline: deterministic spike sorting in 800 µs</h3><p class="article-card__dek">How the Embedded Neural Interface stack moves a thousand-electrode array through filtering, sorting, and decoding inside a single RTOS frame — and why the hardest part wasn't the math.</p><p class="article-card__byline">EoS Editorial · 2026-05-08 · 8 min read</p></div></a></section><section class="topic-strip" id="topic-rtos-kernel"><header class="topic-strip__head"><h2>RTOS & Kernel</h2><a href="news.html#topic-rtos-kernel">More in RTOS & Kernel →</a></header><div class="topic-strip__grid"><a class="article-card" href="article-eos-roadmap-2026.html" data-topic="rtos-kernel"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/kernel-roadmap-640w.webp 640w, img/photos/kernel-roadmap-1024w.webp 1024w, img/photos/kernel-roadmap.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/kernel-roadmap-640w.jpg 640w, img/photos/kernel-roadmap-1024w.jpg 1024w, img/photos/kernel-roadmap.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/kernel-roadmap.jpg" alt="Code on a screen — EoS RTOS roadmap 2026" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker kicker--purple">RTOS & Kernel</span><h3 class="article-card__title">EoS RTOS roadmap 2026: tickless idle, RT-IPC, formal verification</h3><p class="article-card__dek">Three large RTOS bets for 2026: a tickless scheduler with sub-microsecond wake latency, RT-IPC primitives sharing memory across security domains, and a formally verified context-switch path.</p><p class="article-card__byline">EoS Editorial · 2026-04-27 · 10 min read</p></div></a></div></section><section class="topic-strip" id="topic-embedded-ai"><header class="topic-strip__head"><h2>Embedded AI</h2><a href="news.html#topic-embedded-ai">More in Embedded AI →</a></header><div class="topic-strip__empty"><p class="byline" style="margin:0">Featured story this cycle covers this topic — see above. <a href="news.html#topic-embedded-ai">Browse all Embedded AI →</a></p></div></section><section class="topic-strip" id="topic-neural-interface"><header class="topic-strip__head"><h2>Neural Interface</h2><a href="news.html#topic-neural-interface">More in Neural Interface →</a></header><div class="topic-strip__empty"><p class="byline" style="margin:0">Featured story this cycle covers this topic — see above. <a href="news.html#topic-neural-interface">Browse all Neural Interface →</a></p></div></section><section class="topic-strip" id="topic-security-boot"><header class="topic-strip__head"><h2>Security & Boot</h2><a href="news.html#topic-security-boot">More in Security & Boot →</a></header><div class="topic-strip__grid"><a class="article-card" href="article-eboot-secure-boot-deepdive.html" data-topic="security-boot"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/secure-boot-640w.webp 640w, img/photos/secure-boot-1024w.webp 1024w, img/photos/secure-boot.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/secure-boot-640w.jpg 640w, img/photos/secure-boot-1024w.jpg 1024w, img/photos/secure-boot.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/secure-boot.jpg" alt="Secure chip with cryptographic engraving — eBoot deep-dive" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker kicker--green">Security & Boot</span><h3 class="article-card__title">eBootloader secure boot: a measured-launch walkthrough</h3><p class="article-card__dek">An end-to-end tour of eBoot's chain of trust — root-of-trust keys, immutable stage 0, signed manifests, anti-rollback counters, and the runtime attestation hooks EAI consumes during model load.</p><p class="article-card__byline">EoS Editorial · 2026-05-06 · 11 min read</p></div></a><a class="article-card" href="article-edb-encryption-at-rest.html" data-topic="security-boot"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/encryption-storage-640w.webp 640w, img/photos/encryption-storage-1024w.webp 1024w, img/photos/encryption-storage.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/encryption-storage-640w.jpg 640w, img/photos/encryption-storage-1024w.jpg 1024w, img/photos/encryption-storage.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/encryption-storage.jpg" alt="Storage chip macro — eDB AES-XTS encryption" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker">Security & Boot</span><h3 class="article-card__title">eDB ships AES-XTS at-rest encryption — even on 64 KB devices</h3><p class="article-card__dek">eDB's new storage layer adds page-level AES-XTS encryption with hardware-key offload on supported MCUs. The catch: it had to fit in 6 KB of code on the smallest target. Here's how.</p><p class="article-card__byline">EoS Editorial · 2026-05-02 · 7 min read</p></div></a></div></section><section class="topic-strip" id="topic-tools-sim"><header class="topic-strip__head"><h2>Tools & Sim</h2><a href="news.html#topic-tools-sim">More in Tools & Sim →</a></header><div class="topic-strip__grid"><a class="article-card" href="article-eosim-hil-bridge.html" data-topic="tools-sim"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/hil-bridge-640w.webp 640w, img/photos/hil-bridge-1024w.webp 1024w, img/photos/hil-bridge.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/hil-bridge-640w.jpg 640w, img/photos/hil-bridge-1024w.jpg 1024w, img/photos/hil-bridge.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/hil-bridge.jpg" alt="Hardware test bench with breadboard — EoSim HIL bridge" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker kicker--orange">Tools & Sim</span><h3 class="article-card__title">EoSim 2.4 HIL bridge: virtual peripherals talking to real silicon</h3><p class="article-card__dek">EoSim 2.4 introduces a bidirectional hardware-in-the-loop bridge: drive simulated EoS images from a real PHY, or drive real boards from a simulated MMIO bus. We walk through the new ezbus protocol.</p><p class="article-card__byline">EoS Editorial · 2026-05-04 · 6 min read</p></div></a></div></section><section class="topic-strip" id="topic-apps-platforms"><header class="topic-strip__head"><h2>Apps & Platforms</h2><a href="news.html#topic-apps-platforms">More in Apps & Platforms →</a></header><div class="topic-strip__empty"><p class="byline" style="margin:0">Featured story this cycle covers this topic — see above. <a href="news.html#topic-apps-platforms">Browse all Apps & Platforms →</a></p></div></section><section class="topic-strip" id="topic-community"><header class="topic-strip__head"><h2>Community</h2><a href="news.html#topic-community">More in Community →</a></header><div class="topic-strip__grid"><a class="article-card" href="article-foundation-membership-2026.html" data-topic="community"><div class="article-card__media"><picture><source type="image/webp" srcset="img/photos/members-day-640w.webp 640w, img/photos/members-day-1024w.webp 1024w, img/photos/members-day.webp 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><source type="image/jpeg" srcset="img/photos/members-day-640w.jpg 640w, img/photos/members-day-1024w.jpg 1024w, img/photos/members-day.jpg 1600w" sizes="(min-width: 1100px) 600px, (min-width: 700px) 50vw, 100vw"><img src="img/photos/members-day.jpg" alt="Foundation members assembly room — 2026 membership" width="1200" height="680" loading="lazy" decoding="async"></picture></div><div class="article-card__body"><span class="kicker kicker--pink">Community</span><h3 class="article-card__title">Foundation 2026 membership: governance, voting, working groups</h3><p class="article-card__dek">The 2026 membership cycle opens with three new working groups (Safety-Certified, Embedded AI Ethics, and Neural Interface Standards) and a refreshed governance charter. Here's what changed and how to participate.</p><p class="article-card__byline">EoS Editorial · 2026-04-29 · 5 min read</p></div></a></div></section><section class="topic-strip" aria-label="Ecosystem"><header class="topic-strip__head"><h2>The ecosystem — 14 components</h2><a href="ecosystem.html">Explore all →</a></header><div class="eco-snapshot"><a href="product-eos.html"><span class="eco-snapshot__name">EoS</span><span class="eco-snapshot__tag">RTOS</span></a><a href="product-eos-platform.html"><span class="eco-snapshot__name">eos-platform</span><span class="eco-snapshot__tag">Profiles</span></a><a href="product-eboot.html"><span class="eco-snapshot__name">eBoot</span><span class="eco-snapshot__tag">Bootloader</span></a><a href="product-ebuild.html"><span class="eco-snapshot__name">eBuild</span><span class="eco-snapshot__tag">Build sys</span></a><a href="product-eai.html"><span class="eco-snapshot__name">EAI</span><span class="eco-snapshot__tag">Embedded AI</span></a><a href="product-eni.html"><span class="eco-snapshot__name">ENI</span><span class="eco-snapshot__tag">Neural I/F</span></a><a href="product-eipc.html"><span class="eco-snapshot__name">EIPC</span><span class="eco-snapshot__tag">IPC</span></a><a href="product-eapps.html"><span class="eco-snapshot__name">eApps</span><span class="eco-snapshot__tag">60+ apps</span></a><a href="product-eosim.html"><span class="eco-snapshot__name">EoSim</span><span class="eco-snapshot__tag">Simulator</span></a><a href="product-eostudio.html"><span class="eco-snapshot__name">EoStudio</span><span class="eco-snapshot__tag">IDE</span></a><a href="product-edb.html"><span class="eco-snapshot__name">eDB</span><span class="eco-snapshot__tag">Database</span></a><a href="product-ebowser.html"><span class="eco-snapshot__name">eBowser</span><span class="eco-snapshot__tag">Browser</span></a><a href="product-eoffice.html"><span class="eco-snapshot__name">eOffice</span><span class="eco-snapshot__tag">Productivity</span></a><a href="product-eserviceapps.html"><span class="eco-snapshot__name">eServiceApps</span><span class="eco-snapshot__tag">Services</span></a></div></section><section class="topic-strip" aria-label="Upcoming events"><header class="topic-strip__head"><h2><span class="tech-eyebrow">UPCOMING</span> Events &amp; partner sessions</h2><a href="events.html">All events →</a></header><div class="events-strip"><a class="event-mini" href="events.html#eos-embedded-world-na-2026"><span class="event-mini__date">Jun 8 – 10</span><h3 class="event-mini__title">EoS Foundation @ Embedded World NA 2026</h3><p class="event-mini__meta"><span class="event-mini__mode event-mini__mode--offline">OFFLINE</span><span>· Nashville, USA</span></p></a><a class="event-mini" href="events.html#eos-embedded-online-int4"><span class="event-mini__date">Aug 12</span><h3 class="event-mini__title">Webinar: 1.3B-parameter LLM at 11 tok/s on a microcontroller</h3><p class="event-mini__meta"><span class="event-mini__mode event-mini__mode--online">ONLINE</span><span>· Embedded Online Conf.</span></p></a><a class="event-mini" href="events.html#toradex-eos-joint-workshop"><span class="event-mini__date">Sep 30</span><h3 class="event-mini__title">Toradex × EoS Joint Workshop: Boot to Inference</h3><p class="event-mini__meta"><span class="event-mini__mode event-mini__mode--hybrid">HYBRID</span><span>· Lausanne / Live</span></p></a></div><p class="partners-strip" style="margin-top:1rem"><strong>Co-host with the EoS Foundation:</strong> we partner with conference organizers, hardware vendors, publishers and academic societies to bring embedded AI/ML/Neural research to global audiences. <a href="contact.html">Propose a session →</a></p></section><section class="topic-strip" aria-label="Industry and community"><header class="topic-strip__head"><h2>Industry &amp; community</h2><a href="resources.html">More partners →</a></header><div class="industry-strip"><a class="industry-card" href="https://www.embedded.com/" target="_blank" rel="noopener" title="News & analysis"><span class="industry-card__name">Embedded.com <span class="ext-arrow" aria-hidden="true">↗</span></span><span class="industry-card__tag">News & analysis</span></a><a class="industry-card" href="https://embeddedsummit.com/" target="_blank" rel="noopener" title="Annual community summit"><span class="industry-card__name">Embedded Summit <span class="ext-arrow" aria-hidden="true">↗</span></span><span class="industry-card__tag">Annual community summit</span></a><a class="industry-card" href="https://www.embedded-india.com/" target="_blank" rel="noopener" title="Asia-Pacific community"><span class="industry-card__name">Embedded India <span class="ext-arrow" aria-hidden="true">↗</span></span><span class="industry-card__tag">Asia-Pacific community</span></a><a class="industry-card" href="https://www.toradex.com/" target="_blank" rel="