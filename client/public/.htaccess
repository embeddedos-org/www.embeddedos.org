# Apache configuration for the prerendered static build.
#
# Lives in client/public/ so vite copies it into dist/public on every build.
# It was previously added by hand to the deploy branch only, which meant any
# rebuild of that branch silently dropped it.
#
# No SPA rewrite here on purpose. scripts/prerender.mjs writes every one of the
# application's routes to <route>/index.html, so Apache's ordinary file and
# directory resolution already serves them. Rewriting unmatched paths to
# /index.html — which this file used to do — answers every unknown URL with
# HTTP 200 and the homepage, a soft 404 that search engines index as a real
# page. ErrorDocument returns the prerendered 404 page with a genuine 404
# status instead, matching the express handler in server/_core/vite.ts that the
# e2e suite exercises.

# Send the apex to www, once, with a 301.
#
# embeddedos.org and www.embeddedos.org both answered 200 with byte-identical
# content, so the site had two addresses. That splits inbound links between
# them, and analytics counts them as separate hostnames: a visitor crossing
# from one to the other starts a new session and is attributed to "direct".
# The GA4 data stream is defined as https://www.embeddedos.org, and the pages
# already declare <link rel="canonical" href="https://www.embeddedos.org/">,
# so www is the address the site claims — this makes the server agree.
#
# The condition is anchored to the bare apex rather than negating www. A rule
# written as "if host is not www, redirect to www" also matches www itself on
# any request Apache re-enters, which is the usual way this becomes a loop.
#
# HTTPS is already handled upstream: http://www.embeddedos.org answers 301 to
# https before this file is consulted, so there is no scheme rewrite here.
# Verified live 2026-09-18: http://www → 301 https://www, and
# https://embeddedos.org → 301 https://www.embeddedos.org (this rule), so the
# full chain is HTTP → HTTPS → www with a single permanent redirect at each
# hop and no same-host redirect needed at the file level.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^embeddedos\.org$ [NC]
RewriteRule ^(.*)$ https://www.embeddedos.org/$1 [R=301,L]

Options -Indexes

ErrorDocument 404 /404.html

# Compression + long-term caching (F-06).
#
# The production homepage critical path (entry + vendors + CSS) measured
# ~1012 KB raw / ~241 KB brotli with no guaranteed compression: without
# these directives every visitor downloads the full raw weight. All
# dist/public/assets/* files are content-hashed, so they can be immutable;
# HTML documents are short-lived so crawlers and visitors see fresh meta.
#
# The host runs LiteSpeed. LiteSpeed honors mod_deflate/mod_expires-style
# directives from .htaccess where the corresponding feature is enabled, and
# silently ignores <IfModule>-guarded blocks for modules it does not load —
# so each block below is a safe no-op rather than a 500 on hosts without it.
# Verified 2026-09-18 that the live chain serves brotli for text assets; if
# response headers ever stop showing content-encoding, re-check here first.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets: immutable for a year.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  <FilesMatch "\.(js|css|woff2?|avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML documents: revalidate every visit so edited meta/JSON-LD is fresh.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Fallback for hosts without mod_expires: the same cache policy via
# mod_headers alone.
<IfModule !mod_expires.c>
  <IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|avif|webp|png|jpe?g|gif|svg|ico)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
      Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
  </IfModule>
</IfModule>

# Do not add <Limit> or <LimitExcept> here.
#
# This file previously carried:
#
#     <Files "apply.php">
#         <LimitExcept POST>
#             Require all denied
#         </LimitExcept>
#     </Files>
#
# to stop a GET returning the endpoint's source on a host without PHP. On
# Apache 2.4 that behaved exactly as intended — GET 403, POST executed — and it
# was tested there. This host runs LiteSpeed, which denied *every* method
# including POST, so /api/apply.php answered 403 to the form itself and every
# application fell back to the mail draft.
#
# Measured against the live site, which is what settled it: GET and POST both
# 403, while /api/nonexistent.php returned 404 and POST to a static file
# returned 200 — so the denial was scoped to this rule rather than a
# server-wide policy.
#
# The method restriction was never load-bearing. apply.php answers a non-POST
# with 405 itself, and it holds no credential, because sending goes through the
# local MTA rather than authenticated SMTP. Protecting the source of an
# open-source file was not worth a directive whose meaning changes between the
# server it was tested on and the server it runs on.
