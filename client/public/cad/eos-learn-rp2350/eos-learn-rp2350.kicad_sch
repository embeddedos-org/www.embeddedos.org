	(text "EoS Learn RP2350, rev A. Designed by Kartikeydheer Srivastava.\nCopyright (c) 2026 Kartikeydheer Srivastava. All rights reserved; see LICENSE.txt.\nCircuit values follow Raspberry Pi's 'Hardware design with RP2350' and the RP2350 datasheet.\nCore regulator: L1 3.3 uH polarity-marked, C6/C7/C9 4.7 uF, R6 33 ohm, footprints, positions and\ncopper exactly as Raspberry Pi's RP2350A Minimal Design R4 (MIT), as datasheet Figure 26 requires.\nCrystal: ABM8-272-T3 with C3/C4 15 pF and R10 1 kohm, tuned for IOVDD = 3.3 V.\nR7 (QSPI_SS pull-up) is not fitted, as the guide recommends for the W25Q128JV."
		(exclude_from_sim no)
		(at 280 345 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "ac36fa26-79c2-5e85-8283-fc57858caeaf")
	)
