# Hashed build assets only (www #120).
#
# Every file under dist/public/assets/ is content-hashed by the build, so
# a 1-year unrevalidating lifetime is safe HERE — and only here. The root
# .htaccess must never set it: FilesMatch matches filenames only, never
# paths, so a year-long rule in the root file would also cover unhashed
# /media files and root icons, leaving replaced images stale for a year.
# This file rides into the document root inside the assets/ directory
# copy (see .cpanel.yml, which also copies it by name).
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule !mod_expires.c>
  <IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|avif|webp|png|jpe?g|gif|svg|ico)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
  </IfModule>
</IfModule>
