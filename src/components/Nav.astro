---
// Unified top navigation — single source of truth for the whole site.
// Renders as static HTML; dropdowns use <details> so the menu works with
// zero JavaScript. A tiny progressive-enhancement script adds the mobile
// drawer toggle and single-open dropdown behaviour.
import { MENU, normalizePath, isActive as isActiveFn, groupActive as groupActiveFn } from '../lib/menu.mjs';

const cur = normalizePath(Astro.url.pathname);
const isActive = (href) => isActiveFn(href, cur);
const groupActive = (items) => groupActiveFn(items, cur);
---
<header class="navbar" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/index.html" class="logo"><span class="logo-icon">EoS</span> EmbeddedOS</a>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false">&#9776;</button>
    <div class="nav-links" id="nav-links">
      {MENU.map((m) => m.type === 'link' ? (
        <a href={m.href} class={isActive(m.href) ? 'active' : undefined}>{m.label}</a>
      ) : (
        <details class="nav-dropdown">
          <summary>{m.label}</summary>
          <div class="nav-dropdown__menu">
            {m.items.map((it) => (
              <a href={it.href} class={isActive(it.href) ? 'active' : undefined}>{it.label}</a>
            ))}
          </div>
        </details>
      ))}
      <a href="/donate.html" class="nav-github nav-donate">Donate</a>
      <a href="/membership.html" class="nav-cta">Join Now</a>
    </div>
  </div>
</header>

<script>
  const bar = document.querySelector('header.navbar');
  const toggle = bar?.querySelector('.nav-toggle');
  const links = bar?.querySelector('.nav-links');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  const dds = bar ? bar.querySelectorAll('details.nav-dropdown') : [];
  dds.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) dds.forEach((o) => { if (o !== d) o.open = false; });
  }));
</script>
