import Base from "../layouts/Base.astro";
const rawHead = "<meta content=\"EmbeddedOS Foundation — Open Source Licenses — EmbeddedOS Foundation. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"Licenses governing the EmbeddedOS open-source projects (MIT, MIT, BSD), trademark guidelines, and third-party attributions.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, legal, policy, licenses\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"Open Source Licenses — EmbeddedOS\" property=\"og:title\"><meta content=\"Licenses governing the EmbeddedOS open-source projects (MIT, MIT, BSD), trademark guidelines, and third-party attributions.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/licenses\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/licenses\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"Open Source Licenses — EmbeddedOS\" name=\"twitter:title\"><meta content=\"Licenses governing the EmbeddedOS open-source projects (MIT, MIT, BSD), trademark guidelines, and third-party attributions.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>Open Source Licenses — EmbeddedOS Foundation</title>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.embeddedos.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Open Source Licenses\",\"item\":\"https://www.embeddedos.org/licenses\"}]}</script> <link href=\"https://www.embeddedos.org/licenses.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"hero-licenses\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <span>Open Source Licenses</span></nav><span class=\"lang-badge\"><span class=\"dot\"></span>Last updated: 2026-05-12</span><h1 id=\"hero-licenses\">Open Source Licenses</h1><p class=\"lede\">The licenses governing each EmbeddedOS open-source project, third-party attributions, and trademark guidelines.</p></div></section><section class=\"section\"><div class=\"container\" style=\"max-width: 820px;\"><article class=\"prose\"><h2>EmbeddedOS open-source licenses</h2><p>Most EmbeddedOS projects are licensed under the <strong>Apache License, Version 2.0</strong>. Some legacy / vendor-derived components carry additional licenses; the canonical license file in each repository is authoritative.</p><h2>Project license overview</h2><table class=\"repo-tag-table\" style=\"width:100%; border-collapse: collapse;\"><thead><tr style=\"text-align:left; border-bottom: 2px solid var(--border-color);\"><th scope=\"col\" style=\"padding: 10px 8px;\">Project</th><th scope=\"col\" style=\"padding: 10px 8px;\">License</th><th scope=\"col\" style=\"padding: 10px 8px;\">Repository</th></tr></thead><tbody><tr><td>EoS (RTOS)</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eos\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eos</a></td></tr><tr><td>eos-platform</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eos-platform\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eos-platform</a></td></tr><tr><td>eBootloader</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eboot\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eboot</a></td></tr><tr><td>eBuild</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/ebuild\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/ebuild</a></td></tr><tr><td>EAI</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eai\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eai</a></td></tr><tr><td>ENI</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eni\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eni</a></td></tr><tr><td>EIPC</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eipc\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eipc</a></td></tr><tr><td>eApps</td><td>MIT (per-app may vary)</td><td><a href=\"https://github.com/embeddedos-org/eApps\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eApps</a></td></tr><tr><td>EoSim</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eosim\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eosim</a></td></tr><tr><td>EoStudio</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eostudio\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eostudio</a></td></tr><tr><td>eDB</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/edb\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/edb</a></td></tr><tr><td>eBowser</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/ebowser\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/ebowser</a></td></tr><tr><td>eOffice</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eoffice\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eoffice</a></td></tr><tr><td>eServiceApps</td><td>MIT</td><td><a href=\"https://github.com/embeddedos-org/eserviceapps\" rel=\"noopener noreferrer\" target=\"_blank\">embeddedos-org/eserviceapps</a></td></tr></tbody></table><h2>Third-party attributions</h2><p>The site uses the following third-party assets and libraries:</p><ul><li><strong>Inter</strong> typeface by Rasmus Andersson — <a href=\"https://github.com/rsms/inter/blob/master/LICENSE.txt\" rel=\"noopener noreferrer\" target=\"_blank\">SIL Open Font License 1.1</a>.</li><li><strong>Google Fonts CDN</strong> — service terms apply when fonts are loaded from fonts.googleapis.com.</li><li>Per-project third-party licenses are listed in the <code>THIRD_PARTY_NOTICES</code> file inside each repository.</li></ul><h2>Site content</h2><p>The textual content on www.embeddedos.org (excluding open-source code) is © EmbeddedOS Research Foundation and licensed under <a href=\"https://creativecommons.org/licenses/by/4.0/\" rel=\"noopener noreferrer\" target=\"_blank\">CC BY 4.0</a> unless otherwise noted.</p><h2>Trademarks</h2><p>The EmbeddedOS, EoS, and project component names and associated logos are trademarks of the EmbeddedOS Research Foundation. See the <a href=\"terms.html#trademark\">Trademark Guidelines</a>.</p><h2>Reporting a license issue</h2><p>If you believe a license header is missing, incorrect, or inconsistent in any project, please email <a href=\"mailto:legal@embeddedos.org\">legal@embeddedos.org</a> or open an issue in the relevant repository.</p></article></div></section></main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
---
