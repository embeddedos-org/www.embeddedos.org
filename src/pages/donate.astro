const rawHead = "<meta content=\"EmbeddedOS Foundation — Donate &amp; Support — EmbeddedOS Foundation. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"@embeddedos\" name=\"twitter:site\"><meta content=\"Donate &amp; Support — EmbeddedOS Foundation\" name=\"twitter:title\"><meta content=\"Donate to the EmbeddedOS Research Foundation, a 501(c)(3) nonprofit advancing open-source embedded AI operating systems.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/og-image.png\" name=\"twitter:image\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"Donate to the EmbeddedOS Research Foundation, a 501(c)(3) nonprofit advancing open-source embedded AI operating systems.\" name=\"description\"><title>Donate &amp; Support — EmbeddedOS Foundation</title>\n<meta content=\"Donate — Support the EmbeddedOS Foundation\" property=\"og:title\"><meta content=\"Donate to the EmbeddedOS Research Foundation, a 501(c)(3) nonprofit advancing open-source embedded AI operating systems.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/donate\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"> <link href=\"https://www.embeddedos.org/donate.html\" rel=\"canonical\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"frame-src https://www.zeffy.com; default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self';\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a><span class=\"separator\">›</span><span class=\"current\">Donate</span></nav><main id=\"main-content\"><section class=\"hero\"><div aria-hidden=\"true\" class=\"hero__orb hero__orb--2\"></div>\n<div aria-hidden=\"true\" class=\"hero__orb hero__orb--1\"></div>\n<div aria-hidden=\"true\" class=\"hero__grid\"></div>\n<div aria-hidden=\"true\" class=\"hero__bg\"></div><div class=\"hero-container\"><div class=\"hero-content section-header\"><span class=\"badge badge-green\">NON-PROFIT</span><h1 class=\"mt-2\">Support Open <span>Research</span></h1><p>Your donation directly funds cutting-edge research in AI operating systems, neural link security, and autonomous system development. As a 501(c)(3) non-profit, all contributions are tax-deductible.</p><div class=\"hero-buttons\"><a class=\"btn btn-primary\" href=\"#donate-now\">Donate Now</a><a class=\"btn btn-secondary\" href=\"#corporate\">Corporate Giving</a></div></div></div></section><div class=\"stats-bar\"><div class=\"stats-grid\"><div class=\"stat-item-large\"><div class=\"number\">$2.1M</div><div class=\"label\">Raised to Date</div></div><div class=\"stat-item-large\"><div class=\"number\">1,500+</div><div class=\"label\">Individual Donors</div></div><div class=\"stat-item-large\"><div class=\"number\">95%</div><div class=\"label\">Goes to Research</div></div><div class=\"stat-item-large\"><div class=\"number\">100%</div><div class=\"label\">Tax Deductible</div></div></div></div><section class=\"section section--dark\" id=\"donate-now\" aria-label=\"Donation form\">\n  <div class=\"container\">\n    <div class=\"section-header\" style=\"margin-bottom:2.5rem;\">\n      <span class=\"overline section__eyebrow\">Give Today</span>\n      <h2 class=\"section__title\">Make a Donation</h2>\n      <p class=\"section__sub\">100% of your donation goes directly to advancing open-source AI and embedded systems research.</p>\n    </div>\n\n    <!-- Zeffy Donation Form Embed -->\n    <div class=\"zeffy-embed-wrap\" style=\"\n      background: rgba(14,20,40,0.7);\n      border: 1px solid rgba(255,255,255,0.1);\n      border-radius: 20px;\n      overflow: hidden;\n      box-shadow: 0 8px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(59,130,246,0.1);\n      max-width: 820px;\n      margin: 0 auto;\n      backdrop-filter: blur(16px);\n    \">\n      <iframe title=\"Donation form\" src=\"https://www.zeffy.com/embed/donation-form/donate-to-change-lives-17596\" style=\"\n          width: 100%;\n          min-height: 700px;\n          border: none;\n          display: block;\n          border-radius: 20px;\n        \" allowpaymentrequest=\"\" allow=\"payment\" loading=\"lazy\"></iframe>\n    </div>\n\n    <!-- Trust signals below the form -->\n    <div class=\"zeffy-trust\" style=\"\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 2rem;\n      margin-top: 1.75rem;\n      flex-wrap: wrap;\n    \">\n      <span style=\"display:flex;align-items:center;gap:.45rem;font-size:.82rem;color:#64748b;\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n        Secure payment\n      </span>\n      <span style=\"display:flex;align-items:center;gap:.45rem;font-size:.82rem;color:#64748b;\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2.5\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n        0% platform fees\n      </span>\n      <span style=\"display:flex;align-items:center;gap:.45rem;font-size:.82rem;color:#64748b;\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2.5\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>\n        SSL encrypted\n      </span>\n      <span style=\"display:flex;align-items:center;gap:.45rem;font-size:.82rem;color:#64748b;\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg>\n        Tax receipt by email\n      </span>\n    </div>\n  </div>\n</section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Transparency</span><h2>Where Your Money Goes</h2><p>We're committed to maximizing research impact with every dollar</p></div><div class=\"cards-grid cards-grid-4\"><div class=\"feature-card text-center\"><div>70%</div><h3>Research</h3><p>Direct funding for research projects, publications, and experiments</p></div><div class=\"feature-card text-center\"><div>15%</div><h3>Education</h3><p>Internships, certifications, documentation, and community programs</p></div><div class=\"feature-card text-center\"><div>10%</div><h3>Infrastructure</h3><p>Servers, development tools, CI/CD systems, and open-source hosting</p></div><div class=\"feature-card text-center\"><div>5%</div><h3>Operations</h3><p>Administration, legal, accounting, and organizational overhead</p></div></div></div></section><section class=\"section section-white\" id=\"corporate\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Corporate Partners</span><h2>Corporate Giving</h2><p>Partner with us to advance AI and embedded systems research</p></div><div class=\"two-col\"><div class=\"two-col-content\"><h3>Corporate Sponsorship</h3><p>Corporate sponsors receive recognition and benefits while supporting vital open-source research. Your company's contribution helps ensure that AI operating system technology remains open and accessible to all.</p><h4 class=\"mt-3\">Sponsorship Tiers:</h4><ul><li><strong>Platinum ($100,000+)</strong> - Board seat, logo on all materials, keynote at annual conference</li><li><strong>Gold ($50,000+)</strong> - Advisory role, prominent logo placement, speaking opportunity</li><li><strong>Silver ($25,000+)</strong> - Logo on website, mention in publications, event tickets</li><li><strong>Bronze ($10,000+)</strong> - Logo on website, newsletter mention, event tickets</li></ul><a class=\"btn btn-primary mt-2\" href=\"mailto:sponsors@embeddedos.org\">Contact Sponsorship Team</a></div><div class=\"two-col-image\"><div aria-hidden=\"true\" class=\"hero-img-wrap\" style=\"width:100%;border-radius:12px;overflow:hidden\"><svg aria-label=\"corporate-partnersdonate\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" viewBox=\"0 0 800 400\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"uns_ffa0f5f7\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#0066cc\"></stop><stop offset=\"55%\" stop-color=\"#0099ff\"></stop><stop offset=\"100%\" stop-color=\"#00d4ff\"></stop></linearGradient></defs><rect fill=\"url(#uns_ffa0f5f7)\" height=\"400\" width=\"800\"></rect><g fill=\"none\" opacity=\".5\" stroke=\"rgba(255,255,255,.4)\" stroke-width=\"1.5\"><line x1=\"0\" x2=\"0\" y1=\"0\" y2=\"400\"></line><line x1=\"48\" x2=\"48\" y1=\"0\" y2=\"400\"></line><line x1=\"96\" x2=\"96\" y1=\"0\" y2=\"400\"></line><line x1=\"144\" x2=\"144\" y1=\"0\" y2=\"400\"></line><line x1=\"192\" x2=\"192\" y1=\"0\" y2=\"400\"></line><line x1=\"240\" x2=\"240\" y1=\"0\" y2=\"400\"></line><line x1=\"288\" x2=\"288\" y1=\"0\" y2=\"400\"></line><line x1=\"336\" x2=\"336\" y1=\"0\" y2=\"400\"></line><line x1=\"384\" x2=\"384\" y1=\"0\" y2=\"400\"></line><line x1=\"432\" x2=\"432\" y1=\"0\" y2=\"400\"></line><line x1=\"480\" x2=\"480\" y1=\"0\" y2=\"400\"></line><line x1=\"528\" x2=\"528\" y1=\"0\" y2=\"400\"></line><line x1=\"576\" x2=\"576\" y1=\"0\" y2=\"400\"></line><line x1=\"624\" x2=\"624\" y1=\"0\" y2=\"400\"></line><line x1=\"672\" x2=\"672\" y1=\"0\" y2=\"400\"></line><line x1=\"720\" x2=\"720\" y1=\"0\" y2=\"400\"></line><line x1=\"768\" x2=\"768\" y1=\"0\" y2=\"400\"></line><line x1=\"0\" x2=\"800\" y1=\"0\" y2=\"0\"></line><line x1=\"0\" x2=\"800\" y1=\"48\" y2=\"48\"></line><line x1=\"0\" x2=\"800\" y1=\"96\" y2=\"96\"></line><line x1=\"0\" x2=\"800\" y1=\"144\" y2=\"144\"></line><line x1=\"0\" x2=\"800\" y1=\"192\" y2=\"192\"></line><line x1=\"0\" x2=\"800\" y1=\"240\" y2=\"240\"></line><line x1=\"0\" x2=\"800\" y1=\"288\" y2=\"288\"></line><line x1=\"0\" x2=\"800\" y1=\"336\" y2=\"336\"></line><line x1=\"0\" x2=\"800\" y1=\"384\" y2=\"384\"></line></g><text fill=\"rgba(255,255,255,.95)\" font-family=\"Inter,system-ui\" font-size=\"64\" font-weight=\"800\" text-anchor=\"middle\" x=\"400\" y=\"220\">EoS</text><text fill=\"rgba(255,255,255,.6)\" font-family=\"JetBrains Mono,monospace\" font-size=\"14\" letter-spacing=\"3\" text-anchor=\"middle\" x=\"400\" y=\"280\">EMBEDDEDOS</text></svg></div></div></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"two-col\"><div class=\"two-col-image\"><div aria-hidden=\"true\" class=\"hero-img-wrap\" style=\"width:100%;border-radius:12px;overflow:hidden\"><svg aria-label=\"matching-giftsdonate\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" viewBox=\"0 0 800 400\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"uns_24c1e26e\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#0066cc\"></stop><stop offset=\"55%\" stop-color=\"#0099ff\"></stop><stop offset=\"100%\" stop-color=\"#00d4ff\"></stop></linearGradient></defs><rect fill=\"url(#uns_24c1e26e)\" height=\"400\" width=\"800\"></rect><g fill=\"none\" opacity=\".5\" stroke=\"rgba(255,255,255,.4)\" stroke-width=\"1.5\"><line x1=\"0\" x2=\"0\" y1=\"0\" y2=\"400\"></line><line x1=\"48\" x2=\"48\" y1=\"0\" y2=\"400\"></line><line x1=\"96\" x2=\"96\" y1=\"0\" y2=\"400\"></line><line x1=\"144\" x2=\"144\" y1=\"0\" y2=\"400\"></line><line x1=\"192\" x2=\"192\" y1=\"0\" y2=\"400\"></line><line x1=\"240\" x2=\"240\" y1=\"0\" y2=\"400\"></line><line x1=\"288\" x2=\"288\" y1=\"0\" y2=\"400\"></line><line x1=\"336\" x2=\"336\" y1=\"0\" y2=\"400\"></line><line x1=\"384\" x2=\"384\" y1=\"0\" y2=\"400\"></line><line x1=\"432\" x2=\"432\" y1=\"0\" y2=\"400\"></line><line x1=\"480\" x2=\"480\" y1=\"0\" y2=\"400\"></line><line x1=\"528\" x2=\"528\" y1=\"0\" y2=\"400\"></line><line x1=\"576\" x2=\"576\" y1=\"0\" y2=\"400\"></line><line x1=\"624\" x2=\"624\" y1=\"0\" y2=\"400\"></line><line x1=\"672\" x2=\"672\" y1=\"0\" y2=\"400\"></line><line x1=\"720\" x2=\"720\" y1=\"0\" y2=\"400\"></line><line x1=\"768\" x2=\"768\" y1=\"0\" y2=\"400\"></line><line x1=\"0\" x2=\"800\" y1=\"0\" y2=\"0\"></line><line x1=\"0\" x2=\"800\" y1=\"48\" y2=\"48\"></line><line x1=\"0\" x2=\"800\" y1=\"96\" y2=\"96\"></line><line x1=\"0\" x2=\"800\" y1=\"144\" y2=\"144\"></line><line x1=\"0\" x2=\"800\" y1=\"192\" y2=\"192\"></line><line x1=\"0\" x2=\"800\" y1=\"240\" y2=\"240\"></line><line x1=\"0\" x2=\"800\" y1=\"288\" y2=\"288\"></line><line x1=\"0\" x2=\"800\" y1=\"336\" y2=\"336\"></line><line x1=\"0\" x2=\"800\" y1=\"384\" y2=\"384\"></line></g><text fill=\"rgba(255,255,255,.95)\" font-family=\"Inter,system-ui\" font-size=\"64\" font-weight=\"800\" text-anchor=\"middle\" x=\"400\" y=\"220\">EoS</text><text fill=\"rgba(255,255,255,.6)\" font-family=\"JetBrains Mono,monospace\" font-size=\"14\" letter-spacing=\"3\" text-anchor=\"middle\" x=\"400\" y=\"280\">EMBEDDEDOS</text></svg></div></div><div class=\"two-col-content\"><span class=\"overline\">Double Your Impact</span><h2>Employer Matching</h2><p>Many employers match charitable contributions made by their employees. Check if your company offers a matching gift program to double or even triple your donation!</p><h3 class=\"mt-3\">Companies That Match:</h3><div><span class=\"badge badge-blue\">Google</span><span class=\"badge badge-blue\">Microsoft</span><span class=\"badge badge-blue\">Apple</span><span class=\"badge badge-blue\">Meta</span><span class=\"badge badge-blue\">Amazon</span><span class=\"badge badge-blue\">Intel</span><span class=\"badge badge-blue\">NVIDIA</span><span class=\"badge badge-blue\">Qualcomm</span></div><p class=\"mt-2\">Contact your HR department to learn about your company's matching gift program.</p></div></div></div></section><section class=\"section section-white\" id=\"grants\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Foundations &amp; Grants</span><h2>Grant Funding</h2><p>We actively pursue research grants and welcome foundation partnerships</p></div><div class=\"cards-grid cards-grid-3\"><div class=\"card\"><div class=\"card-image\"><div class=\"card-icon\"><svg aria-hidden=\"true\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\"><defs><linearGradient id=\"govGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><path d=\"M24 4L4 14v4h40v-4L24 4zM8 22v18h6V22H8zm10 0v18h6V22h-6zm10 0v18h6V22h-6zm10 0v18h6V22h-6zM4 44h40v4H4v-4z\" fill=\"url(#govGradient)\"></path></svg></div></div><div class=\"card-content\"><h3>Government Grants</h3><p>We pursue NSF, DARPA, and other government research grants for fundamental AI and systems research.</p></div></div><div class=\"card\"><div class=\"card-image\"><div class=\"card-icon\"><svg aria-hidden=\"true\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\"><defs><linearGradient id=\"buildingGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><path d=\"M6 44V10h14v6h16v28H6zm4-30v4h4v-4h-4zm0 8v4h4v-4h-4zm0 8v4h4v-4h-4zm0 8v4h4v-4h-4zm10-16v4h4v-4h-4zm0 8v4h4v-4h-4zm0 8v4h4v-4h-4zm10-16v4h4v-4h-4zm0 8v4h4v-4h-4zm0 8v4h4v-4h-4z\" fill=\"url(#buildingGradient)\"></path></svg></div></div><div class=\"card-content\"><h3>Foundation Grants</h3><p>Partnerships with private foundations supporting technology research and open-source development.</p></div></div><div class=\"card\"><div class=\"card-image\"><div class=\"card-icon\"><svg aria-hidden=\"true\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\"><defs><linearGradient id=\"handshakeGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><path d=\"M8 20l6-6 8 4 8-6 6 4v16l-6 4-8-4-8 6-6-4V20zm4 2v10l4 2.5 6-4.5 2 1 2-1 6 4.5 4-2.5V22l-4-2.5-6 4.5-2-1-2 1-6-4.5-4 2.5zm6 1a2 2 0 100 4 2 2 0 000-4zm12 0a2 2 0 100 4 2 2 0 000-4z\" fill=\"url(#handshakeGradient)\"></path></svg></div></div><div class=\"card-content\"><h3>Industry Research</h3><p>Collaborative research agreements with industry partners on specific technical challenges.</p></div></div></div><div class=\"text-center mt-3\"><p>Interested in funding specific research? Contact us to discuss directed grants.</p><a class=\"btn btn-outline\" href=\"mailto:grants@embeddedos.org\">Contact Grants Team</a></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">More Options</span><h2>Other Ways to Give</h2><p>Multiple ways to support our mission</p></div><div class=\"cards-grid cards-grid-4\"><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" height=\"40\" viewBox=\"0 0 40 40\" width=\"40\"><defs><linearGradient id=\"mobileGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><rect fill=\"url(#mobileGradient)\" height=\"32\" rx=\"3\" width=\"20\" x=\"10\" y=\"4\"></rect><rect fill=\"white\" height=\"20\" rx=\"1\" width=\"16\" x=\"12\" y=\"8\"></rect><circle cx=\"20\" cy=\"32\" fill=\"white\" r=\"2\"></circle></svg></div><h3>Stock Donations</h3><p>Donate appreciated securities and avoid capital gains tax while supporting research.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" height=\"40\" viewBox=\"0 0 40 40\" width=\"40\"><defs><linearGradient id=\"bankGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><path d=\"M20 4L4 12v2h32v-2L20 4zM6 16v16h4V16H6zm8 0v16h4V16h-4zm8 0v16h4V16h-4zm8 0v16h4V16h-4zM4 34v4h32v-4H4z\" fill=\"url(#bankGradient)\"></path></svg></div><h3>DAF Contributions</h3><p>Give through your Donor Advised Fund for immediate tax benefits.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" height=\"40\" viewBox=\"0 0 40 40\" width=\"40\"><defs><linearGradient id=\"scrollGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><path d=\"M10 4c-2.2 0-4 1.8-4 4v24c0 2.2 1.8 4 4 4h20c2.2 0 4-1.8 4-4V12l-10-8H10zm12 2l8 8h-8V6zM12 18h16v2H12v-2zm0 6h16v2H12v-2zm0 6h10v2H12v-2z\" fill=\"url(#scrollGradient)\"></path></svg></div><h3>Planned Giving</h3><p>Include EmbeddedOS Research Foundation in your estate plans for lasting impact.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" height=\"40\" viewBox=\"0 0 40 40\" width=\"40\"><defs><linearGradient id=\"cryptoGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><circle cx=\"20\" cy=\"20\" fill=\"url(#cryptoGradient)\" r=\"16\"></circle><path d=\"M21 12v2h2v2h-2v2h2v2h-2v2c2.8 0 5 1.8 5 4s-2.2 4-5 4v2h-2v-2h-2v2h-2v-2h-2v-2h2v-8h-2v-2h2v-2h2v-2h-2v-2h2v-2h2zm-2 6v8h2c1.7 0 3-.9 3-2s-1.3-2-3-2h-2v-2h2c1.1 0 2-.7 2-1.5S22.1 17 21 17h-2z\" fill=\"white\"></path></svg></div><h3>Cryptocurrency</h3><p>We accept Bitcoin, Ethereum, and other major cryptocurrencies.</p></div></div></div></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Accountability</span><h2>Financial Transparency</h2><p>We're committed to full transparency in how we use your donations</p></div><div class=\"stack-diagram text-center\"><h3 class=\"mb-3\">Our Commitments</h3><div class=\"cards-grid cards-grid-3\"><div><div><svg aria-hidden=\"true\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\"><defs><linearGradient id=\"chartGradient\" x1=\"0%\" x2=\"100%\" y1=\"100%\" y2=\"0%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><rect fill=\"url(#chartGradient)\" height=\"14\" rx=\"2\" width=\"8\" x=\"6\" y=\"28\"></rect><rect fill=\"url(#chartGradient)\" height=\"22\" rx=\"2\" width=\"8\" x=\"18\" y=\"20\"></rect><rect fill=\"url(#chartGradient)\" height=\"32\" rx=\"2\" width=\"8\" x=\"30\" y=\"10\"></rect><path d=\"M6 14l12 8 12-10 12 4\" fill=\"none\" stroke=\"url(#chartGradient)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><circle cx=\"6\" cy=\"14\" fill=\"url(#chartGradient)\" r=\"3\"></circle><circle cx=\"18\" cy=\"22\" fill=\"url(#chartGradient)\" r=\"3\"></circle><circle cx=\"30\" cy=\"12\" fill=\"url(#chartGradient)\" r=\"3\"></circle><circle cx=\"42\" cy=\"16\" fill=\"url(#chartGradient)\" r=\"3\"></circle></svg></div><h4>Annual Reports</h4><p>Detailed financial statements published annually</p></div><div><div><svg aria-hidden=\"true\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\"><defs><linearGradient id=\"searchGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><circle cx=\"20\" cy=\"20\" fill=\"none\" r=\"12\" stroke=\"url(#searchGradient)\" stroke-width=\"4\"></circle><line stroke=\"url(#searchGradient)\" stroke-linecap=\"round\" stroke-width=\"5\" x1=\"29\" x2=\"40\" y1=\"29\" y2=\"40\"></line><circle cx=\"20\" cy=\"20\" fill=\"url(#searchGradient)\" opacity=\"0.3\" r=\"6\"></circle></svg></div><h4>Independent Audit</h4><p>Annual audit by independent CPA firm</p></div><div><div><svg aria-hidden=\"true\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\"><defs><linearGradient id=\"checkGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-stop-opacity:1\"></stop><stop offset=\"100%\" style=\"stop-stop-opacity:1\"></stop></linearGradient></defs><circle cx=\"24\" cy=\"24\" fill=\"url(#checkGradient)\" r=\"20\"></circle><path d=\"M14 24l7 7 13-14\" fill=\"none\" stroke=\"white\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"4\"></path></svg></div><h4>Form 990</h4><p>IRS filings publicly available</p></div></div><div class=\"mt-4\"><a class=\"btn btn-outline\" href=\"contact.html\">View 2023 Annual Report</a><a class=\"btn btn-outline ml-2\" href=\"contact.html\">Download Form 990</a></div></div></div></section><section class=\"cta-section\"><h2>Every Dollar Makes a Difference</h2><p>Join 1,500+ donors who are advancing the future of AI operating systems and open-source research.</p><div class=\"cta-buttons\"><a class=\"btn btn-dark\" href=\"#donate-now\">Donate Now</a><a class=\"btn btn-secondary\" href=\"mailto:donate@embeddedos.org\">Contact Us</a></div></section></main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
