---
import Base from "../layouts/Base.astro";
const rawHead = "<title>Product Ecosystem — EmbeddedOS Foundation</title>\n<meta content=\"Explore the complete EmbeddedOS product ecosystem: 14 open-source products from bare-metal kernel to AI inference to browser, all built to work together.\" name=\"description\">\n<meta content=\"EmbeddedOS Ecosystem — 14 Products, One Unified Stack\" property=\"og:title\">\n<meta content=\"From EoS RTOS kernel to EAI neural inference to eDB embedded database — the complete open-source embedded OS stack.\" property=\"og:description\">\n<meta content=\"website\" property=\"og:type\">\n<meta content=\"summary_large_image\" name=\"twitter:card\">\n<meta content=\"EmbeddedOS Ecosystem\" name=\"twitter:title\">\n<meta content=\"14 open-source products. One unified embedded OS stack.\" name=\"twitter:description\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n<div class=\"live-bar\" role=\"status\">\n<span aria-hidden=\"true\" class=\"live-pulse\"></span>\n<span>EAI 0.9 — INT4 LLM inference at 11 tok/s on Cortex-M85 &nbsp;·&nbsp; <a href=\"article-eai-llm-bench.html\">Read the benchmark →</a></span>\n</div>\n\n<main id=\"main-content\">\n<div class=\"page-header\">\n<div class=\"page-header__bg\"></div>\n<div class=\"container\">\n<nav aria-label=\"Breadcrumb\" class=\"breadcrumb\">\n<a href=\"index.html\">Home</a>\n<span aria-hidden=\"true\">›</span>\n<span aria-current=\"page\">Ecosystem</span>\n</nav>\n<h1>The <span class=\"grad\">EmbeddedOS Ecosystem</span></h1>\n<p class=\"page-header__sub\">14 open-source products built to work together — from bare-metal kernel to AI inference engine to full IDE. Every layer of the embedded stack, free forever.</p>\n</div>\n</div>\n<!-- Visual Stack Diagram -->\n<section class=\"section section--surface\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">Architecture</span>\n<h2 class=\"section__title\">Full-Stack Embedded Platform</h2>\n<p class=\"section__sub\" style=\"margin:0 auto;\">Every product is designed to integrate seamlessly. Use one product or the entire stack.</p>\n</div>\n<div class=\"eco-full-stack\">\n<!-- Layer 5: Applications -->\n<div class=\"eco-layer eco-layer--apps\">\n<div class=\"eco-layer__label\">Application Layer</div>\n<div class=\"eco-layer__products\">\n<a class=\"eco-product-chip\" href=\"product-eapps.html\">\n<span class=\"eco-product-chip__icon\">📱</span>\n<span>eApps</span>\n<small>App Framework</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-ebowser.html\">\n<span class=\"eco-product-chip__icon\">🌐</span>\n<span>eBowser</span>\n<small>Browser</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-eoffice.html\">\n<span class=\"eco-product-chip__icon\">📄</span>\n<span>eOffice</span>\n<small>Office Suite</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-eserviceapps.html\">\n<span class=\"eco-product-chip__icon\">⚙️</span>\n<span>eServiceApps</span>\n<small>Services</small>\n</a>\n</div>\n</div>\n<!-- Layer 4: AI & Intelligence -->\n<div class=\"eco-layer eco-layer--ai\">\n<div class=\"eco-layer__label\">AI &amp; Intelligence Layer</div>\n<div class=\"eco-layer__products\">\n<a class=\"eco-product-chip eco-product-chip--featured\" href=\"product-eai.html\">\n<span class=\"eco-product-chip__icon\">🧠</span>\n<span>EAI</span>\n<small>AI Inference Engine</small>\n</a>\n<a class=\"eco-product-chip eco-product-chip--featured\" href=\"product-eni.html\">\n<span class=\"eco-product-chip__icon\">🧬</span>\n<span>ENI</span>\n<small>Neural Interface</small>\n</a>\n</div>\n</div>\n<!-- Layer 3: Services & IPC -->\n<div class=\"eco-layer eco-layer--services\">\n<div class=\"eco-layer__label\">Services Layer</div>\n<div class=\"eco-layer__products\">\n<a class=\"eco-product-chip\" href=\"product-eipc.html\">\n<span class=\"eco-product-chip__icon\">⚡</span>\n<span>EIPC</span>\n<small>IPC Bus</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-edb.html\">\n<span class=\"eco-product-chip__icon\">🗄</span>\n<span>eDB</span>\n<small>Database</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-eos-platform.html\">\n<span class=\"eco-product-chip__icon\">🏗</span>\n<span>EoS Platform</span>\n<small>Platform SDK</small>\n</a>\n</div>\n</div>\n<!-- Layer 2: Dev Tools -->\n<div class=\"eco-layer eco-layer--tools\">\n<div class=\"eco-layer__label\">Developer Tools Layer</div>\n<div class=\"eco-layer__products\">\n<a class=\"eco-product-chip\" href=\"product-eostudio.html\">\n<span class=\"eco-product-chip__icon\">💻</span>\n<span>EoStudio</span>\n<small>IDE</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-ebuild.html\">\n<span class=\"eco-product-chip__icon\">🔧</span>\n<span>eBuild</span>\n<small>Build System</small>\n</a>\n<a class=\"eco-product-chip\" href=\"product-eosim.html\">\n<span class=\"eco-product-chip__icon\">🖥</span>\n<span>EoSim</span>\n<small>Simulator</small>\n</a>\n</div>\n</div>\n<!-- Layer 1: Kernel & Boot -->\n<div class=\"eco-layer eco-layer--kernel\">\n<div class=\"eco-layer__label\">Kernel &amp; Boot Layer</div>\n<div class=\"eco-layer__products\">\n<a class=\"eco-product-chip eco-product-chip--core\" href=\"product-eos.html\">\n<span class=\"eco-product-chip__icon\">🔮</span>\n<span>EoS</span>\n<small>RTOS Kernel</small>\n</a>\n<a class=\"eco-product-chip eco-product-chip--core\" href=\"product-eboot.html\">\n<span class=\"eco-product-chip__icon\">🔐</span>\n<span>eBootloader</span>\n<small>Secure Boot</small>\n</a>\n</div>\n</div>\n<!-- Layer 0: Hardware -->\n<div class=\"eco-layer eco-layer--hw\">\n<div class=\"eco-layer__label\">Hardware</div>\n<div class=\"eco-layer__products\">\n<div class=\"eco-hw-chip\">ARM Cortex-M/A</div>\n<div class=\"eco-hw-chip\">RISC-V</div>\n<div class=\"eco-hw-chip\">x86 / x86-64</div>\n<div class=\"eco-hw-chip\">Custom SoC</div>\n<div class=\"eco-hw-chip\">FPGA</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Product Cards Grid -->\n<section class=\"section section--dark\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">All Products</span>\n<h2 class=\"section__title\">Every Product, Explained</h2>\n</div>\n<div class=\"mkt-eco-grid\">\n<a class=\"mkt-eco-card mkt-eco-card--core\" href=\"product-eos.html\">\n<div class=\"mkt-eco-card__icon\">🔮</div>\n<div class=\"mkt-eco-card__name\">EoS</div>\n<div class=\"mkt-eco-card__tag\">Core RTOS Kernel</div>\n<p class=\"mkt-eco-card__desc\">Real-time kernel with capability-based security, SMP/AMP support, deterministic scheduling, and a hardware abstraction layer for 50+ MCU families.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>≤10μs context switch</span>\n<span>ARM · RISC-V · x86</span>\n<span>C11 standard</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eboot.html\">\n<div class=\"mkt-eco-card__icon\">🔐</div>\n<div class=\"mkt-eco-card__name\">eBootloader</div>\n<div class=\"mkt-eco-card__tag\">Secure Boot Chain</div>\n<p class=\"mkt-eco-card__desc\">5-stage verified boot with hardware root of trust, rollback protection, A/B partition updates, and cryptographic signature verification.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>Ed25519 signatures</span>\n<span>A/B updates</span>\n<span>&lt;64KB footprint</span>\n</div>\n</a>\n<a class=\"mkt-eco-card mkt-eco-card--ai\" href=\"product-eai.html\">\n<div class=\"mkt-eco-card__icon\">🧠</div>\n<div class=\"mkt-eco-card__name\">EAI</div>\n<div class=\"mkt-eco-card__tag\">AI Inference Engine</div>\n<p class=\"mkt-eco-card__desc\">On-device neural inference at sub-1ms latency. Runs quantised LLMs, CNNs, and transformers on microcontrollers with as little as 256KB RAM.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>&lt;1ms inference</span>\n<span>INT8/INT4 quant</span>\n<span>256KB min RAM</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eni.html\">\n<div class=\"mkt-eco-card__icon\">🧬</div>\n<div class=\"mkt-eco-card__name\">ENI</div>\n<div class=\"mkt-eco-card__tag\">Neural Interface</div>\n<p class=\"mkt-eco-card__desc\">1,024-channel neural signal acquisition at 30kHz with 24-bit ADC, real-time spike sorting, and low-latency BCI output for brain-computer interfaces.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>1,024 channels</span>\n<span>30kHz sample rate</span>\n<span>24-bit ADC</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eipc.html\">\n<div class=\"mkt-eco-card__icon\">⚡</div>\n<div class=\"mkt-eco-card__name\">EIPC</div>\n<div class=\"mkt-eco-card__tag\">IPC Bus</div>\n<p class=\"mkt-eco-card__desc\">Zero-copy inter-process communication with capability tokens, message queues, shared memory, and sub-microsecond latency between isolated processes.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>&lt;1μs latency</span>\n<span>Zero-copy</span>\n<span>Capability tokens</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-ebuild.html\">\n<div class=\"mkt-eco-card__icon\">🔧</div>\n<div class=\"mkt-eco-card__name\">eBuild</div>\n<div class=\"mkt-eco-card__tag\">Build System</div>\n<p class=\"mkt-eco-card__desc\">Declarative cross-compilation build system with reproducible builds, SDK generation, and support for 20+ toolchains including GCC, Clang, and LLVM.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>Reproducible builds</span>\n<span>20+ toolchains</span>\n<span>SDK generation</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eosim.html\">\n<div class=\"mkt-eco-card__icon\">🖥</div>\n<div class=\"mkt-eco-card__name\">EoSim</div>\n<div class=\"mkt-eco-card__tag\">System Simulator</div>\n<p class=\"mkt-eco-card__desc\">QEMU-based full-system simulator with virtual peripherals, GDB integration, hardware-in-the-loop bridge, and cycle-accurate timing for deterministic testing.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>QEMU backend</span>\n<span>HIL bridge</span>\n<span>GDB integration</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eostudio.html\">\n<div class=\"mkt-eco-card__icon\">💻</div>\n<div class=\"mkt-eco-card__name\">EoStudio</div>\n<div class=\"mkt-eco-card__tag\">IDE</div>\n<p class=\"mkt-eco-card__desc\">RTOS-aware IDE with live task inspector, memory map visualiser, one-click flash, integrated EoSim, and real-time CPU/memory profiling dashboards.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>RTOS task view</span>\n<span>Memory map</span>\n<span>One-click flash</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-edb.html\">\n<div class=\"mkt-eco-card__icon\">🗄</div>\n<div class=\"mkt-eco-card__name\">eDB</div>\n<div class=\"mkt-eco-card__tag\">Embedded Database</div>\n<p class=\"mkt-eco-card__desc\">Full SQL embedded database with AES-XTS encryption at rest, write-ahead logging for crash safety, B-tree indexing, and a 64KB minimum footprint.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>AES-XTS encryption</span>\n<span>WAL crash safety</span>\n<span>64KB footprint</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eos-platform.html\">\n<div class=\"mkt-eco-card__icon\">🏗</div>\n<div class=\"mkt-eco-card__name\">EoS Platform</div>\n<div class=\"mkt-eco-card__tag\">Platform SDK</div>\n<p class=\"mkt-eco-card__desc\">Unified platform SDK that integrates all EoS products into a single development environment with shared APIs, documentation, and tooling.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>Unified API</span>\n<span>All products</span>\n<span>One SDK</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eapps.html\">\n<div class=\"mkt-eco-card__icon\">📱</div>\n<div class=\"mkt-eco-card__name\">eApps</div>\n<div class=\"mkt-eco-card__tag\">App Framework</div>\n<p class=\"mkt-eco-card__desc\">Lightweight application framework for building embedded UIs and services on EoS, with a component model, event system, and hardware-accelerated rendering.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>Component model</span>\n<span>HW-accelerated</span>\n<span>Event system</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-ebowser.html\">\n<div class=\"mkt-eco-card__icon\">🌐</div>\n<div class=\"mkt-eco-card__name\">eBowser</div>\n<div class=\"mkt-eco-card__tag\">Embedded Browser</div>\n<p class=\"mkt-eco-card__desc\">Lightweight web browser for embedded devices with HTML5, CSS3, and JavaScript support. Runs on devices with as little as 4MB RAM.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>HTML5 / CSS3</span>\n<span>4MB min RAM</span>\n<span>JavaScript</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eoffice.html\">\n<div class=\"mkt-eco-card__icon\">📄</div>\n<div class=\"mkt-eco-card__name\">eOffice</div>\n<div class=\"mkt-eco-card__tag\">Office Suite</div>\n<p class=\"mkt-eco-card__desc\">Embedded office suite with document viewer, spreadsheet engine, and presentation renderer. Compatible with standard office formats.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>DOCX / XLSX</span>\n<span>PDF renderer</span>\n<span>Offline first</span>\n</div>\n</a>\n<a class=\"mkt-eco-card\" href=\"product-eserviceapps.html\">\n<div class=\"mkt-eco-card__icon\">⚙️</div>\n<div class=\"mkt-eco-card__name\">eServiceApps</div>\n<div class=\"mkt-eco-card__tag\">System Services</div>\n<p class=\"mkt-eco-card__desc\">Collection of system service applications: network manager, update daemon, logging service, health monitor, and remote management agent.</p>\n<div class=\"mkt-eco-card__specs\">\n<span>OTA updates</span>\n<span>Health monitor</span>\n<span>Remote mgmt</span>\n</div>\n</a>\n</div>\n</div>\n</section>\n<!-- Use Cases -->\n<section class=\"section section--surface\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">Use Cases</span>\n<h2 class=\"section__title\">Where EmbeddedOS Powers the World</h2>\n</div>\n<div class=\"mkt-usecase-grid\">\n<div class=\"mkt-usecase-card\">\n<div class=\"mkt-usecase-card__icon\">🏥</div>\n<h3>Medical Devices</h3>\n<p>Pacemakers, insulin pumps, neural implants, and surgical robots. EoS + ENI + EAI provide the safety-critical stack for FDA-grade medical devices.</p>\n<div class=\"mkt-usecase-card__products\">\n<span>EoS</span><span>ENI</span><span>EAI</span><span>eBootloader</span>\n</div>\n</div>\n<div class=\"mkt-usecase-card\">\n<div class=\"mkt-usecase-card__icon\">🚗</div>\n<h3>Automotive</h3>\n<p>ADAS, infotainment, body control modules, and EV battery management. ISO 26262 ASIL-B compliant profiles available.</p>\n<div class=\"mkt-usecase-card__products\">\n<span>EoS</span><span>EIPC</span><span>eDB</span><span>EAI</span>\n</div>\n</div>\n<div class=\"mkt-usecase-card\">\n<div class=\"mkt-usecase-card__icon\">🛰</div>\n<h3>Aerospace &amp; Space</h3>\n<p>Satellite firmware, drone flight controllers, and space-grade OS profiles. Radiation-tolerant builds for LEO and GEO missions.</p>\n<div class=\"mkt-usecase-card__products\">\n<span>EoS</span><span>eBootloader</span><span>eBuild</span><span>EoSim</span>\n</div>\n</div>\n<div class=\"mkt-usecase-card\">\n<div class=\"mkt-usecase-card__icon\">🏭</div>\n<h3>Industrial IoT</h3>\n<p>PLCs, SCADA systems, factory automation, and predictive maintenance. Real-time determinism with OTA update capability.</p>\n<div class=\"mkt-usecase-card__products\">\n<span>EoS</span><span>EIPC</span><span>eServiceApps</span><span>eDB</span>\n</div>\n</div>\n<div class=\"mkt-usecase-card\">\n<div class=\"mkt-usecase-card__icon\">🧠</div>\n<h3>Brain-Computer Interfaces</h3>\n<p>Neural signal acquisition, spike sorting, and closed-loop stimulation for next-generation BCI devices and neuroprosthetics.</p>\n<div class=\"mkt-usecase-card__products\">\n<span>ENI</span><span>EAI</span><span>EoS</span><span>EIPC</span>\n</div>\n</div>\n<div class=\"mkt-usecase-card\">\n<div class=\"mkt-usecase-card__icon\">🤖</div>\n<h3>Robotics &amp; AI</h3>\n<p>Autonomous robots, collaborative arms, and AI-powered edge devices. EAI brings on-device intelligence to microcontrollers.</p>\n<div class=\"mkt-usecase-card__products\">\n<span>EAI</span><span>EoS</span><span>ENI</span><span>EoStudio</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- CTA -->\n<section class=\"mkt-fundraise-banner\" style=\"padding:5rem 0;\">\n<div class=\"mkt-fundraise-banner__bg\"></div>\n<div class=\"container mkt-fundraise-banner__inner\">\n<div class=\"mkt-fundraise-banner__text\">\n<h2>Start Building Today</h2>\n<p>All 14 products are free, open-source, and production-ready. Get started with the EoS Platform SDK or explore individual products.</p>\n</div>\n<div class=\"mkt-fundraise-banner__actions\">\n<a class=\"btn-primary\" href=\"documentation.html\">Get Started →</a>\n<a class=\"btn-secondary\" href=\"fundraising.html\">💛 Support the Mission</a>\n</div>\n</div>\n</section>\n</main>";
---
<Base lang="en" legacy={false} cssHref="/css/style.v7.css" bodyClass="page-ecosystem" rawHead={rawHead}>
<Fragment set:html={content} />
<script is:inline src="js/main.js" defer></script>
</Base>
