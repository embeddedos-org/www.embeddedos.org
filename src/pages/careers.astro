import Base from "../layouts/Base.astro";
const rawHead = "<meta content=\"EmbeddedOS Foundation — Careers — EmbeddedOS Foundation. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"@embeddedos\" name=\"twitter:site\"><meta content=\"Careers — EmbeddedOS Foundation\" name=\"twitter:title\"><meta content=\"Open roles at the EmbeddedOS Research Foundation. Join us in advancing open-source embedded AI operating systems.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/og-image.png\" name=\"twitter:image\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"Open roles at the EmbeddedOS Research Foundation. Join us in advancing open-source embedded AI operating systems.\" name=\"description\"><title>Careers — EmbeddedOS Foundation</title>\n<meta content=\"Careers — EmbeddedOS Research Foundation\" property=\"og:title\"><meta content=\"Open roles at the EmbeddedOS Research Foundation. Join us in advancing open-source embedded AI operating systems.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/careers\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"> <link href=\"https://www.embeddedos.org/careers.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a><span class=\"separator\">›</span><a href=\"contact.html\">Programs</a><span class=\"separator\">›</span><span class=\"current\">Careers</span></nav><main id=\"main-content\"><section class=\"page-header\"><div aria-hidden=\"true\" class=\"hero__bg\"><div class=\"hero__orb hero__orb--1\"></div><div class=\"hero__orb hero__orb--2\"></div></div><h1>Careers</h1><p class=\"lede\">Join our team and shape the future of AI operating systems and neural link technology</p></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Why Join Us</span><h2>Build the Future with Us</h2><p>Be part of a mission-driven organization advancing open-source technology</p></div><div class=\"cards-grid cards-grid-4\"><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"globeGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><circle cx=\"24\" cy=\"24\" fill=\"none\" r=\"20\" stroke=\"url(#globeGradient)\" stroke-width=\"2.5\"></circle><ellipse cx=\"24\" cy=\"24\" fill=\"none\" rx=\"8\" ry=\"20\" stroke=\"url(#globeGradient)\" stroke-width=\"2\"></ellipse><path d=\"M4 24h40\" stroke=\"url(#globeGradient)\" stroke-width=\"2\"></path><path d=\"M8 12h32\" stroke=\"url(#globeGradient)\" stroke-width=\"1.5\"></path><path d=\"M8 36h32\" stroke=\"url(#globeGradient)\" stroke-width=\"1.5\"></path></svg></div><h3>Global Impact</h3><p>Work on technology that affects millions of devices and users worldwide.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"researchGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><circle cx=\"18\" cy=\"14\" fill=\"none\" r=\"10\" stroke=\"url(#researchGradient)\" stroke-width=\"2.5\"></circle><circle cx=\"18\" cy=\"14\" fill=\"url(#researchGradient)\" opacity=\"0.3\" r=\"4\"></circle><path d=\"M25 21l6 6\" stroke=\"url(#researchGradient)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M29 25l8 14\" stroke=\"url(#researchGradient)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M33 43l6-4\" stroke=\"url(#researchGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path><path d=\"M33 43l-2 4\" stroke=\"url(#researchGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path></svg></div><h3>Cutting-Edge Research</h3><p>Collaborate with leading researchers in AI, neural interfaces, and embedded systems.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"growthGradient\" x1=\"0%\" x2=\"100%\" y1=\"100%\" y2=\"0%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 44V24\" stroke=\"url(#growthGradient)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M24 24c0-8 6-12 12-14\" fill=\"none\" stroke=\"url(#growthGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path><path d=\"M24 28c0-6-5-9-10-10\" fill=\"none\" stroke=\"url(#growthGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path><ellipse cx=\"36\" cy=\"10\" fill=\"url(#growthGradient)\" opacity=\"0.8\" rx=\"6\" ry=\"8\" transform=\"rotate(30 36 10)\"></ellipse><ellipse cx=\"14\" cy=\"18\" fill=\"url(#growthGradient)\" opacity=\"0.8\" rx=\"5\" ry=\"7\" transform=\"rotate(-30 14 18)\"></ellipse><ellipse cx=\"24\" cy=\"8\" fill=\"url(#growthGradient)\" opacity=\"0.6\" rx=\"5\" ry=\"7\"></ellipse></svg></div><h3>Growth &amp; Learning</h3><p>Continuous learning opportunities, conference attendance, and skill development.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"balanceGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 6v36\" stroke=\"url(#balanceGradient)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M24 10L8 18\" stroke=\"url(#balanceGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path><path d=\"M24 10L40 18\" stroke=\"url(#balanceGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path><path d=\"M4 18c0 0 2 8 4 8h0c2 0 4-8 4-8\" fill=\"none\" stroke=\"url(#balanceGradient)\" stroke-width=\"2\"></path><path d=\"M36 18c0 0 2 8 4 8h0c2 0 4-8 4-8\" fill=\"none\" stroke=\"url(#balanceGradient)\" stroke-width=\"2\"></path><circle cx=\"24\" cy=\"6\" fill=\"url(#balanceGradient)\" r=\"3\"></circle><path d=\"M18 42h12\" stroke=\"url(#balanceGradient)\" stroke-linecap=\"round\" stroke-width=\"3\"></path></svg></div><h3>Work-Life Balance</h3><p>Flexible schedules, remote options, and generous time-off policies.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Engineering</span><h2>Technical Positions</h2><p>Build the next generation of intelligent embedded systems</p></div><div class=\"positions-list\"><div class=\"position-card\"><h3>EoS Build System Engineer</h3><p class=\"type\">Full-time • Remote / San Francisco Bay Area</p><p>Design and maintain the EoS build system, Ninja backend integration, YAML configuration, and cross-compilation targets (ARM, x86, RISC-V).</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div><div class=\"position-card\"><h3>EIPC Security Engineer</h3><p class=\"type\">Full-time • Remote / San Francisco Bay Area</p><p>Develop and maintain EIPC secure IPC framework, capability-based authorization, audit logging, replay protection, and transport security.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div><div class=\"position-card\"><h3>eBootloader / Firmware Engineer</h3><p class=\"type\">Full-time • Remote / San Francisco Bay Area</p><p>Design staged boot architecture, A/B slot management, CRC/signature verification, and firmware upgrade APIs.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div></div></div></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Research</span><h2>Research Positions</h2><p>Advance the frontiers of knowledge in AI and neural systems</p></div><div class=\"positions-list\"><div class=\"position-card\"><h3>EAI Runtime Researcher</h3><p class=\"type\">Full-time • Remote / San Francisco Bay Area</p><p>Research and develop EAI-Min edge runtime and EAI-Framework industrial AI platform, including llama.cpp/ONNX/TFLite optimization.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div><div class=\"position-card\"><h3>ENI Integration Researcher</h3><p class=\"type\">Full-time • Remote / San Francisco Bay Area</p><p>Research vendor-neutral BCI interfaces, neural signal processing, and ENI-Framework multi-lane routing.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Leadership</span><h2>Management &amp; Operations</h2><p>Lead our organization and advance our mission</p></div><div class=\"positions-list\"><div class=\"position-card\"><h3>Fundraising Manager</h3><p class=\"type\">Full-time • Remote / San Francisco Bay Area</p><p>Lead fundraising initiatives, build relationships with donors, and develop grant proposals to support our research mission.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div><div class=\"position-card\"><h3>General Manager - Programs</h3><p class=\"type\">Full-time • San Francisco</p><p>Oversee membership, certification, and internship programs. Drive growth and ensure excellent participant experiences.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div><div class=\"position-card\"><h3>Community Manager</h3><p class=\"type\">Full-time • Remote</p><p>Build and engage our global community of researchers, engineers, and enthusiasts. Manage events, forums, and outreach programs.</p><a class=\"btn btn-outline mt-2\" href=\"contact.html\">Apply Now</a></div></div></div></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Benefits</span><h2>What We Offer</h2><p>Comprehensive benefits for our team members</p></div><div class=\"cards-grid cards-grid-3\"><div class=\"card\"><div class=\"card-content\"><h3><svg aria-hidden=\"true\" fill=\"none\" height=\"28\" style=\"vertical-align: middle; margin-right: 8px;\" viewBox=\"0 0 48 48\" width=\"28\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"moneyGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><circle cx=\"24\" cy=\"24\" fill=\"none\" r=\"20\" stroke=\"url(#moneyGradient)\" stroke-width=\"2.5\"></circle><path d=\"M24 12v24\" stroke=\"url(#moneyGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path><path d=\"M18 18c0-2 2-4 6-4s6 2 6 4-2 4-6 4-6 2-6 4 2 4 6 4 6-2 6-4\" fill=\"none\" stroke=\"url(#moneyGradient)\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path></svg> Competitive Compensation </h3><p>Market-rate salaries with annual reviews, plus opportunities for equity participation in spin-off ventures.</p></div></div><div class=\"card\"><div class=\"card-content\"><h3><svg aria-hidden=\"true\" fill=\"none\" height=\"28\" style=\"vertical-align: middle; margin-right: 8px;\" viewBox=\"0 0 48 48\" width=\"28\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"healthGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 42s-16-10-16-22c0-6 4-10 10-10 4 0 6 3 6 3s2-3 6-3c6 0 10 4 10 10 0 12-16 22-16 22z\" fill=\"url(#healthGradient)\"></path><path d=\"M18 22h12M24 16v12\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path></svg> Health &amp; Wellness </h3><p>Comprehensive medical, dental, and vision insurance. Mental health support and wellness stipends.</p></div></div><div class=\"card\"><div class=\"card-content\"><h3><svg aria-hidden=\"true\" fill=\"none\" height=\"28\" style=\"vertical-align: middle; margin-right: 8px;\" viewBox=\"0 0 48 48\" width=\"28\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"palmGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 44V20\" stroke=\"#92400e\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M24 20c-4-6-12-8-18-4 6-1 12 2 18 8\" fill=\"url(#palmGradient)\"></path><path d=\"M24 20c4-6 12-8 18-4-6-1-12 2-18 8\" fill=\"url(#palmGradient)\"></path><path d=\"M24 18c-2-8-8-14-14-14 4 2 10 8 14 18\" fill=\"url(#palmGradient)\"></path><path d=\"M24 18c2-8 8-14 14-14-4 2-10 8-14 18\" fill=\"url(#palmGradient)\"></path><path d=\"M24 16c0-10-2-14-2-14s-2 4-2 14\" fill=\"url(#palmGradient)\"></path></svg> Time Off </h3><p>Generous PTO, paid holidays, sabbatical opportunities, and parental leave.</p></div></div><div class=\"card\"><div class=\"card-content\"><h3><svg aria-hidden=\"true\" fill=\"none\" height=\"28\" style=\"vertical-align: middle; margin-right: 8px;\" viewBox=\"0 0 48 48\" width=\"28\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"booksGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#booksGradient)\" height=\"32\" rx=\"1\" width=\"10\" x=\"6\" y=\"8\"></rect><rect fill=\"url(#booksGradient)\" height=\"28\" opacity=\"0.8\" rx=\"1\" width=\"10\" x=\"18\" y=\"12\"></rect><rect fill=\"url(#booksGradient)\" height=\"34\" opacity=\"0.6\" rx=\"1\" width=\"10\" x=\"30\" y=\"6\"></rect><path d=\"M8 12h6M8 16h6M8 20h6\" opacity=\"0.5\" stroke=\"white\" stroke-width=\"1.5\"></path></svg> Learning &amp; Development </h3><p>Conference attendance, training budget, and access to online learning platforms.</p></div></div><div class=\"card\"><div class=\"card-content\"><h3><svg aria-hidden=\"true\" fill=\"none\" height=\"28\" style=\"vertical-align: middle; margin-right: 8px;\" viewBox=\"0 0 48 48\" width=\"28\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"homeGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M6 22L24 6l18 16\" fill=\"none\" stroke=\"url(#homeGradient)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"></path><path d=\"M10 20v20h28V20\" fill=\"none\" stroke=\"url(#homeGradient)\" stroke-width=\"2.5\"></path><rect fill=\"url(#homeGradient)\" height=\"12\" opacity=\"0.3\" width=\"12\" x=\"18\" y=\"28\"></rect><path d=\"M24 28v12M18 34h12\" stroke=\"url(#homeGradient)\" stroke-width=\"2\"></path></svg> Flexible Work </h3><p>Remote-first culture with optional co-working spaces. Flexible hours that work for you.</p></div></div><div class=\"card\"><div class=\"card-content\"><h3><svg aria-hidden=\"true\" fill=\"none\" height=\"28\" style=\"vertical-align: middle; margin-right: 8px;\" viewBox=\"0 0 48 48\" width=\"28\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"giftGradient\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"none\" height=\"26\" rx=\"2\" stroke=\"url(#giftGradient)\" stroke-width=\"2.5\" width=\"36\" x=\"6\" y=\"18\"></rect><rect fill=\"url(#giftGradient)\" height=\"8\" opacity=\"0.3\" rx=\"2\" width=\"36\" x=\"6\" y=\"18\"></rect><path d=\"M24 18v26\" stroke=\"url(#giftGradient)\" stroke-width=\"2.5\"></path><path d=\"M24 18c0-6-4-10-8-10s-6 4 0 10\" fill=\"none\" stroke=\"url(#giftGradient)\" stroke-width=\"2.5\"></path><path d=\"M24 18c0-6 4-10 8-10s6 4 0 10\" fill=\"none\" stroke=\"url(#giftGradient)\" stroke-width=\"2.5\"></path></svg> Additional Perks </h3><p>Home office setup stipend, latest development hardware, and team retreats.</p></div></div></div></div></section><section class=\"cta-section\"><h2>Ready to Join Our Team?</h2><p>Explore open positions or reach out to learn about upcoming opportunities.</p><div class=\"cta-buttons\"><a class=\"btn btn-dark\" href=\"contact.html\">Contact HR</a><a class=\"btn btn-secondary\" href=\"internship.html\">View Internships</a></div></section></main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
