const rawHead = "<meta content=\"EmbeddedOS Foundation — EAI — Embedded AI Runtime | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"EAI is the embedded AI runtime: 12 LLM models, ReAct agents, LoRA fine-tuning, federated learning, and on-device inference. C11.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, EAI, C11, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"EAI — Embedded AI Runtime — EmbeddedOS\" property=\"og:title\"><meta content=\"EAI is the embedded AI runtime: 12 LLM models, ReAct agents, LoRA fine-tuning, federated learning, and on-device inference. C11.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-eai\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-eai\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"EAI — Embedded AI Runtime — EmbeddedOS\" name=\"twitter:title\"><meta content=\"EAI is the embedded AI runtime: 12 LLM models, ReAct agents, LoRA fine-tuning, federated learning, and on-device inference. C11.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>EAI — Embedded AI Runtime | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"EAI\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"EAI is the EoS embedded AI runtime — twelve curated LLM and small-model variants, ReAct agent orchestration, on-device LoRA fine-tuning, and federated-learning rounds, all engineered to run inside an edge-class power and memory envelope.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-eai\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"EAI\", \"item\": \"https://www.embeddedos.org/product-eai\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-eai.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-eai\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>EAI</span></nav><div class=\"product-hero__visual\"><img alt=\"Neural network glow — EAI\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-eai.svg\" width=\"1200\"></div><span class=\"lang-badge lang-c\"><span class=\"dot\"></span>C11 · v0.1.0</span><h1 id=\"ph-eai\">EAI — Embedded AI Runtime</h1><p class=\"lede\">EAI is the EoS embedded AI runtime — twelve curated LLM and small-model variants, ReAct agent orchestration, on-device LoRA fine-tuning, and federated-learning rounds, all engineered to run inside an edge-class power and memory envelope.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/eai\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">12</div><div class=\"stat-label\">Bundled LLMs</div></div><div class=\"stat-tile\"><div class=\"stat-num\">ReAct</div><div class=\"stat-label\">Agent loop</div></div><div class=\"stat-tile\"><div class=\"stat-num\">LoRA</div><div class=\"stat-label\">On-device tuning</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Federated</div><div class=\"stat-label\">Multi-device learning</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What EAI is</h2></div><div class=\"prose\"><p>EAI ships with twelve quantized model variants spanning 50 M to 7 B parameters, each tuned for embedded inference: 4-bit / 8-bit weight formats, fused operators, and zero-copy tensor handoff to EoS HAL accelerators (NPU, GPU, DSP).</p><p>Beyond raw inference, EAI provides a ReAct-style agent loop with tool use, an on-device LoRA trainer for personalisation, and a federated-learning client so devices can collectively improve a shared model without ever uploading raw data.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of EAI at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>12 Bundled Models</h3><p>Family includes 50 M, 350 M, 1.3 B, 3 B, and 7 B variants — 4-bit and 8-bit quantized.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>ReAct Agent Loop</h3><p>Reasoning + acting framework with structured tool-call grammar and trace logging.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>On-Device LoRA</h3><p>Fine-tune adapter weights from local data; merge or hot-swap at runtime.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Federated Learning</h3><p>Secure-aggregation client; participates in cross-device training rounds with differential privacy.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Accelerator HAL</h3><p>Zero-copy dispatch to NPU, GPU, DSP, and CPU SIMD via the EoS HAL.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Streaming I/O</h3><p>Token-by-token streaming responses; integrates with eApps and eBowser.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Memory-Mapped Weights</h3><p>Demand-paged weight access for SoCs with limited RAM.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Safe-Output Filters</h3><p>Built-in content / PII filters, jailbreak-resistant system-prompt vault.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Bench &amp; Profiler</h3><p>Per-op latency / power profiler; export to flame graphs and CSV.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>EAI is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/eai</h3><p>On-device LLM inference, ReAct agents, LoRA, and federated learning — at edge power budgets.</p><div class=\"repo-tags\"><span class=\"repo-tag\">C11</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/eai\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>EAI is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"#60a5fa\" height=\"36\" rx=\"8\" stroke=\"#60a5fa\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that EAI commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eni.html\"><span class=\"cl-name\">ENI</span><span class=\"cl-blurb\">Production-grade neural-link interface: 1024 channels, 30 kHz, intent decoding.</span></a><a class=\"cross-link\" href=\"product-eipc.html\"><span class=\"cl-name\">EIPC</span><span class=\"cl-blurb\">Capability-secured IPC fabric: predictable latency, HMAC-authenticated messages.</span></a><a class=\"cross-link\" href=\"product-eos.html\"><span class=\"cl-name\">EoS</span><span class=\"cl-blurb\">The foundation: a deterministic real-time embedded OS for everything from the bootloader up.</span></a></div></div></section><section aria-labelledby=\"arch-diag\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Architecture</span>\n<h2 id=\"arch-diag\">EAI Runtime Pipeline</h2>\n<p>The six-stage AI inference pipeline from model input through quantization, graph optimization, kernel dispatch, SIMD execution, and output tensor, with hardware acceleration targets and quantization benchmarks.</p>\n</div>\n<div class=\"diagram-wrap\">\n<img alt=\"EAI Runtime Pipeline\" class=\"arch-diagram\" height=\"520\" loading=\"lazy\" src=\"img/diagrams/diag-eai.svg\" width=\"860\">\n</div>\n</div>\n</section>\n<section aria-labelledby=\"specs-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Technical Specifications</span>\n<h2 id=\"specs-h\">EAI at a Glance</h2>\n</div>\n<div class=\"specs-table-wrap\">\n<table aria-label=\"EAI at a Glance\" class=\"specs-table\"><thead><tr><th scope=\"row\">Minimum Precision</th><td>INT4 (4-bit integer quantization)</td></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Supported Precisions</th><td>INT4, INT8, FP16, FP32</td></tr>\n<tr><th scope=\"row\">LLM Performance</th><td>11.2 tok/s on ARM Cortex-M85 @ 480 MHz (INT4)</td></tr>\n<tr><th scope=\"row\">Vision Performance</th><td>28.6 fps MobileNetV3-Small INT4 on Cortex-M85</td></tr>\n<tr><th scope=\"row\">Runtime RAM</th><td>&lt; 16 KB for INT4 MobileNetV3-Small</td></tr>\n<tr><th scope=\"row\">Supported Model Formats</th><td>TFLite Micro, ONNX Runtime, PyTorch Mobile, CMSIS-NN, GGUF / llama.cpp, Custom IR</td></tr>\n<tr><th scope=\"row\">Hardware Acceleration</th><td>ARM Helium MVE (M55/M85), NEON SIMD (A55/A78), RISC-V V-extension, NPU/DSP, OpenCL GPU</td></tr>\n<tr><th scope=\"row\">Quantization</th><td>Post-training quantization (PTQ) and quantization-aware training (QAT) support</td></tr>\n<tr><th scope=\"row\">Model Compression</th><td>Pruning, weight sharing, knowledge distillation toolchain</td></tr>\n<tr><th scope=\"row\">Operator Coverage</th><td>200+ operators (Conv2D, LSTM, Transformer attention, depthwise separable, …)</td></tr>\n<tr><th scope=\"row\">License</th><td>MIT — commercial use permitted without royalty</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"code-h\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Quick Start</span>\n<h2 id=\"code-h\">Running Inference with EAI</h2>\n</div>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\"><span class=\"code-lang\">C</span><span class=\"code-copy-hint\">Quick Start</span></div>\n<pre class=\"code-block\"><code>#include \"eai/eai.h\"\n#include \"eai/models/mobilenet_v3_int4.h\"\n\n/* Load and run MobileNetV3-Small INT4 */\nint main(void) {\n    /* Initialize EAI runtime with INT4 backend */\n    eai_runtime_t *rt = eai_runtime_init(EAI_BACKEND_HELIUM_MVE);\n\n    /* Load pre-quantized model from flash */\n    eai_model_t *model = eai_model_load_flash(\n        mobilenet_v3_int4_data,\n        mobilenet_v3_int4_size\n    );\n\n    /* Prepare input tensor (224×224 RGB image) */\n    eai_tensor_t input = {\n        .data   = image_buffer,\n        .shape  = {1, 224, 224, 3},\n        .dtype  = EAI_DTYPE_UINT8,\n    };\n\n    /* Run inference */\n    eai_tensor_t output;\n    eai_infer(rt, model, &amp;input, &amp;output);\n\n    /* Get top-1 class */\n    int class_id = eai_argmax(&amp;output);\n    printf(\"Class: %d (%.1f%%)\\n\",\n           class_id, eai_softmax_max(&amp;output) * 100.0f);\n\n    eai_runtime_free(rt);\n    return 0;\n}</code></pre>\n<p class=\"code-note\">Compile with: <code>ebuild build --profile cortex-m85-helium --feature eai</code></p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"usecases-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Applications</span>\n<h2 id=\"usecases-h\">Where EAI Runs</h2>\n</div>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">👁️</div>\n<h3>Computer Vision</h3>\n<p>Object detection, person detection, and anomaly inspection on microcontrollers — no cloud round-trip required.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🎙️</div>\n<h3>Keyword Spotting</h3>\n<p>Always-on wake-word detection with &lt; 1 ms latency and &lt; 100 µA average current on Cortex-M33.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🧠</div>\n<h3>On-Device LLM</h3>\n<p>Run quantized language models (TinyLlama-1.1B INT4) directly on Cortex-M85 for local NLP without connectivity.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏥</div>\n<h3>Medical Diagnostics</h3>\n<p>ECG arrhythmia detection, SpO₂ analysis, and fall detection on wearable medical devices with battery life measured in weeks.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏭</div>\n<h3>Predictive Maintenance</h3>\n<p>Vibration signature analysis and anomaly detection on industrial sensors with millisecond response times.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🚗</div>\n<h3>ADAS Perception</h3>\n<p>Pedestrian and lane detection on automotive-grade SoCs with functional safety (ISO 26262) compliance.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with EAI?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/eai\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-eai-inference\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
