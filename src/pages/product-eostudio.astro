const rawHead = "<meta content=\"EmbeddedOS Foundation — EoStudio — Embedded IDE | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"EoStudio is the EoS integrated development environment: 12 editors, 30+ generators, profile-aware build, simulator integration. Python.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, EoStudio, Python, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"EoStudio — Embedded IDE — EmbeddedOS\" property=\"og:title\"><meta content=\"EoStudio is the EoS integrated development environment: 12 editors, 30+ generators, profile-aware build, simulator integration. Python.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-eostudio\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-eostudio\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"EoStudio — Embedded IDE — EmbeddedOS\" name=\"twitter:title\"><meta content=\"EoStudio is the EoS integrated development environment: 12 editors, 30+ generators, profile-aware build, simulator integration. Python.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>EoStudio — Embedded IDE | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"EoStudio\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"EoStudio is the integrated development environment for EoS — twelve domain-specific editors, thirty-plus code generators, profile-aware build configuration, and one-click EoSim debugging in a single workspace.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-eostudio\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"EoStudio\", \"item\": \"https://www.embeddedos.org/product-eostudio\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-eostudio.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-eostudio\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>EoStudio</span></nav><div class=\"product-hero__visual\"><img alt=\"IDE and code editor — EoStudio\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-eostudio.svg\" width=\"1200\"></div><span class=\"lang-badge lang-py\"><span class=\"dot\"></span>Python · v0.1.0</span><h1 id=\"ph-eostudio\">EoStudio — Embedded IDE</h1><p class=\"lede\">EoStudio is the integrated development environment for EoS — twelve domain-specific editors, thirty-plus code generators, profile-aware build configuration, and one-click EoSim debugging in a single workspace.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/eostudio\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">12</div><div class=\"stat-label\">Domain editors</div></div><div class=\"stat-tile\"><div class=\"stat-num\">30+</div><div class=\"stat-label\">Code generators</div></div><div class=\"stat-tile\"><div class=\"stat-num\">EoSim</div><div class=\"stat-label\">Integrated debug</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Python</div><div class=\"stat-label\">Plug-in API</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What EoStudio is</h2></div><div class=\"prose\"><p>Where a generic IDE forces you to learn the EoS toolchain through trial and error, EoStudio surfaces the entire stack: a board picker, a profile composer, a HAL configurator, a device-tree visualizer, an EIPC topology editor, an EAI prompt designer, and more — each one a first-class editor with code-gen wired in.</p><p>Hit Run and EoStudio drives eBuild to produce an artifact, hands it to EoSim, and drops you into a kernel-aware debugger with eIPC traffic visualized live.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of EoStudio at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Board Picker</h3><p>Browse the 24 supported boards; pin a workspace to one with one click.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Profile Composer</h3><p>Visual editor for product profiles: features, drivers, services, footprint.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>HAL Configurator</h3><p>GUI over the 33-peripheral HAL: configure pins, clocks, peripherals.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Device-Tree Visualizer</h3><p>Inspect and patch the active DT graphically.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>EIPC Topology Editor</h3><p>Draw services, ports, and capabilities; generate stub code.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>EAI Prompt Designer</h3><p>Iterate on agent prompts with side-by-side trace + token cost.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>30+ Code Generators</h3><p>From C scaffolding to systemd-style unit files to test harnesses.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>EoSim-Aware Debugger</h3><p>Step through firmware running in EoSim with kernel-aware variables.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Python Plug-in API</h3><p>Extend any panel; ship internal tooling as a workspace plug-in.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>EoStudio is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/eostudio</h3><p>An IDE built for EoS: 12 editors, 30+ generators, simulator-aware debugging.</p><div class=\"repo-tags\"><span class=\"repo-tag\">Python</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/eostudio\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>EoStudio is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"#67e8f9\" height=\"36\" rx=\"8\" stroke=\"#67e8f9\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that EoStudio commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-ebuild.html\"><span class=\"cl-name\">eBuild</span><span class=\"cl-blurb\">One CLI to configure, build, package, and ship EoS firmware to any of 14 targets.</span></a><a class=\"cross-link\" href=\"product-eosim.html\"><span class=\"cl-name\">EoSim</span><span class=\"cl-blurb\">Simulate, fuzz, and CI-test EoS firmware against 52+ virtual platforms.</span></a><a class=\"cross-link\" href=\"product-eos.html\"><span class=\"cl-name\">EoS</span><span class=\"cl-blurb\">The foundation: a deterministic real-time embedded OS for everything from the bootloader up.</span></a></div></div></section><section aria-labelledby=\"arch-diag\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Architecture</span>\n<h2 id=\"arch-diag\">EoStudio IDE Architecture</h2>\n<p>The EoStudio IDE showing the file explorer, code editor with syntax highlighting, integrated terminal, and RTOS-aware debug panel with task states, registers, and breakpoints.</p>\n</div>\n<div class=\"diagram-wrap\">\n<img alt=\"EoStudio IDE Architecture\" class=\"arch-diagram\" height=\"520\" loading=\"lazy\" src=\"img/diagrams/diag-eostudio.svg\" width=\"860\">\n</div>\n</div>\n</section>\n<section aria-labelledby=\"specs-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Technical Specifications</span>\n<h2 id=\"specs-h\">EoStudio at a Glance</h2>\n</div>\n<div class=\"specs-table-wrap\">\n<table aria-label=\"EoStudio at a Glance\" class=\"specs-table\"><thead><tr><th scope=\"row\">Base Platform</th><td>Visual Studio Code Extension (VS Code 1.85+)</td></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Debug Protocols</th><td>GDB/MI, JTAG (J-Link, ST-Link, CMSIS-DAP), SWD, OpenOCD</td></tr>\n<tr><th scope=\"row\">RTOS Awareness</th><td>EoS task list, stack usage, mutex/semaphore state, queue depths in real time</td></tr>\n<tr><th scope=\"row\">AI Code Assist</th><td>Context-aware completions for EoS APIs, HAL drivers, and EIPC patterns</td></tr>\n<tr><th scope=\"row\">EoSim Integration</th><td>One-click launch; automatic GDB attachment; peripheral register view</td></tr>\n<tr><th scope=\"row\">Peripheral View</th><td>Live read/write of all 33 HAL peripheral register maps</td></tr>\n<tr><th scope=\"row\">Power Profiler</th><td>Energy trace visualization from J-Link Energy Profiler and custom ADC probes</td></tr>\n<tr><th scope=\"row\">Memory Inspector</th><td>Heap fragmentation map, stack watermark visualization, MPU region viewer</td></tr>\n<tr><th scope=\"row\">Coverage Report</th><td>GCOV/LCOV HTML reports rendered inline in the editor</td></tr>\n<tr><th scope=\"row\">Host Platforms</th><td>Windows 10/11, macOS 12+, Ubuntu 20.04+, Debian 11+</td></tr>\n<tr><th scope=\"row\">License</th><td>MIT — commercial use permitted without royalty</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"code-h\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Quick Start</span>\n<h2 id=\"code-h\">Setting Up EoStudio</h2>\n</div>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\"><span class=\"code-lang\">Shell</span><span class=\"code-copy-hint\">Quick Start</span></div>\n<pre class=\"code-block\"><code># 1. Install VS Code (if not already installed)\n#    https://code.visualstudio.com/\n\n# 2. Install the EoStudio extension\ncode --install-extension embeddedos.eostudio\n\n# 3. Open your EoS project\ncode /path/to/my_eos_project\n\n# 4. Configure the debug probe in .vscode/launch.json\n# EoStudio auto-generates this when you run \"EoStudio: Initialize Project\"\n\n# 5. Build and flash from the Command Palette\n#    Ctrl+Shift+P → \"EoStudio: Build and Flash\"\n\n# 6. Start RTOS-aware debug session\n#    Press F5 — EoStudio attaches GDB and shows the task list\n\n# 7. Launch EoSim for hardware-free debugging\n#    Ctrl+Shift+P → \"EoStudio: Launch in Simulator\"</code></pre>\n<p class=\"code-note\">EoStudio requires the eBuild CLI to be on your PATH.</p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"usecases-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Applications</span>\n<h2 id=\"usecases-h\">Where EoStudio Is Used</h2>\n</div>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">💻</div>\n<h3>Firmware Development</h3>\n<p>Full-featured IDE experience for EoS firmware development with IntelliSense, refactoring, and integrated version control.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🐛</div>\n<h3>RTOS Debugging</h3>\n<p>RTOS-aware debugging shows all task states, stack usage, and blocked resources — not just raw register values.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">⚡</div>\n<h3>Power Optimization</h3>\n<p>Energy trace visualization helps identify power-hungry code paths and optimize sleep/wake cycles for battery-powered devices.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🧪</div>\n<h3>Test-Driven Development</h3>\n<p>Integrated test runner for EoS unit tests with coverage visualization directly in the editor margin.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🤖</div>\n<h3>AI-Assisted Coding</h3>\n<p>Context-aware AI completions understand EoS APIs, suggest HAL driver patterns, and generate EIPC message schemas.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🎓</div>\n<h3>Education</h3>\n<p>University courses use EoStudio's visual task debugger to teach RTOS concepts with immediate, visual feedback.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with EoStudio?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/eostudio\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-eostudio-ide\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
