const rawHead = "<meta content=\"EmbeddedOS Foundation — eOffice — Embedded Office Suite | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"eOffice is the EoS office productivity suite: 11 apps including eDocs, eSheets, eSlides, eMail, eDrive — built for embedded and edge devices. JS/TS.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, eOffice, JavaScript / TypeScript, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"eOffice — Embedded Office Suite — EmbeddedOS\" property=\"og:title\"><meta content=\"eOffice is the EoS office productivity suite: 11 apps including eDocs, eSheets, eSlides, eMail, eDrive — built for embedded and edge devices. JS/TS.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-eoffice\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-eoffice\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"eOffice — Embedded Office Suite — EmbeddedOS\" name=\"twitter:title\"><meta content=\"eOffice is the EoS office productivity suite: 11 apps including eDocs, eSheets, eSlides, eMail, eDrive — built for embedded and edge devices. JS/TS.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>eOffice — Embedded Office Suite | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"eOffice\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"eOffice is the EoS office productivity suite: eleven apps including eDocs, eSheets, eSlides, eMail, and eDrive, all built on eBowser with shared identity, file storage, and offline-first sync.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-eoffice\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"eOffice\", \"item\": \"https://www.embeddedos.org/product-eoffice\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-eoffice.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-eoffice\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>eOffice</span></nav><div class=\"product-hero__visual\"><img alt=\"Productivity workspace — eOffice\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-eoffice.svg\" width=\"1200\"></div><span class=\"lang-badge lang-js\"><span class=\"dot\"></span>JavaScript / TypeScript · v0.1.0</span><h1 id=\"ph-eoffice\">eOffice — Embedded Office Suite</h1><p class=\"lede\">eOffice is the EoS office productivity suite: eleven apps including eDocs, eSheets, eSlides, eMail, and eDrive, all built on eBowser with shared identity, file storage, and offline-first sync.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/eoffice\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">11</div><div class=\"stat-label\">Apps</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Offline</div><div class=\"stat-label\">First-class</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Shared</div><div class=\"stat-label\">Identity / storage</div></div><div class=\"stat-tile\"><div class=\"stat-num\">eBowser</div><div class=\"stat-label\">UI engine</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What eOffice is</h2></div><div class=\"prose\"><p>eOffice gives EoS devices a complete productivity surface without leaving the local network: eDocs (word-processor), eSheets (spreadsheet), eSlides (presentation), eMail, eDrive (file storage), eCalendar, eContacts, eNotes, eTasks, eForms, and eMeet.</p><p>Every app shares a common identity, file vault, and CRDT sync layer through eDB and EIPC, so a document edited offline on a tablet shows up on the desktop the moment they share a network.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of eOffice at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>eDocs</h3><p>Rich-text word processor with comments, suggestions, and revision history.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>eSheets</h3><p>Spreadsheet with formula engine, charts, and pivot tables.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>eSlides</h3><p>Presentation editor with templates and presenter mode.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>eMail</h3><p>IMAP / SMTP client with end-to-end encryption support.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>eDrive</h3><p>File storage with end-to-end encrypted folders, shared spaces, and offline caching.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Offline-First</h3><p>Every app works fully offline; CRDT sync via eDB when a peer is reachable.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Shared Identity</h3><p>Single sign-on across all eOffice apps via eDB JWT.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>eBowser Engine</h3><p>Lightweight, hardware-accelerated rendering on every eos-platform profile.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Open Formats</h3><p>Imports / exports DOCX, XLSX, PPTX, ODF, PDF, Markdown.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>eOffice is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/eoffice</h3><p>11 office apps — eDocs, eSheets, eSlides, eMail, eDrive — built for embedded.</p><div class=\"repo-tags\"><span class=\"repo-tag\">JavaScript / TypeScript</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/eoffice\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>eOffice is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"#a78bfa\" height=\"36\" rx=\"8\" stroke=\"#a78bfa\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that eOffice commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eapps.html\"><span class=\"cl-name\">eApps</span><span class=\"cl-blurb\">A curated library of 60+ ready-to-deploy apps for every EoS device class.</span></a><a class=\"cross-link\" href=\"product-edb.html\"><span class=\"cl-name\">eDB</span><span class=\"cl-blurb\">SQL + Document + KV in one engine, with REST, JWT, and AES-256 at rest.</span></a><a class=\"cross-link\" href=\"product-ebowser.html\"><span class=\"cl-name\">eBowser</span><span class=\"cl-blurb\">A small, hardware-accelerated HTML5 / CSS engine purpose-built for embedded UIs.</span></a></div></div></section><section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with eOffice?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/eoffice\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-eoffice-office\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main>\n<section class=\"section section--alt animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Architecture Overview</h2>\n<div class=\"diagram-wrap\">\n<img alt=\"eOffice architecture diagram\" class=\"arch-diagram\" decoding=\"async\" loading=\"lazy\" src=\"diagrams/diag-eoffice.svg\">\n</div>\n</div>\n</section>\n<section class=\"section animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Technical Specifications</h2>\n<div class=\"specs-table-wrap\">\n<table class=\"specs-table\">\n<thead><tr><th scope=\"col\">Specification</th><th scope=\"col\">Value</th></tr></thead>\n<tbody>\n<tr><td>Components</td><td><code>eDoc, eSheet, ePresent</code></td></tr>\n<tr><td>File Formats</td><td><code>OOXML read/write, ODF read</code></td></tr>\n<tr><td>RAM Usage</td><td><code>1–8 MB</code></td></tr>\n<tr><td>Flash Usage</td><td><code>4–16 MB</code></td></tr>\n<tr><td>Rendering</td><td><code>eBowser compositor</code></td></tr>\n<tr><td>Fonts</td><td><code>TrueType subset</code></td></tr>\n<tr><td>Collaboration</td><td><code>Conflict-free CRDT sync</code></td></tr>\n<tr><td>Encryption</td><td><code>AES-256 document encryption</code></td></tr>\n<tr><td>Export</td><td><code>PDF via eDB print pipeline</code></td></tr>\n<tr><td>License</td><td><code>MIT</code></td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section class=\"section section--alt animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Quick Start</h2>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\">\n<span class=\"code-lang\">C / YAML</span>\n<button class=\"code-block__copy btn-ghost\" type=\"button\">Copy</button>\n</div>\n<pre class=\"code-block\"><code>/* Open a document with eOffice */\n#include <eoffice edoc.h=\"\">\n\nint main(void) {\n    edoc_t *doc = edoc_open(\"/flash/report.docx\");\n    if (!doc) return -1;\n\n    edoc_insert_text(doc, 0, \"Field Report — 2026-06-28\");\n    edoc_save(doc, \"/flash/report_v2.docx\");\n    edoc_close(doc);\n    return 0;\n}</eoffice></code></pre>\n</div>\n</div>\n</section>\n<section class=\"section animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Use Cases</h2>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<h3>Field Reports</h3>\n<p>Offline document editing on rugged handhelds</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Data Logging</h3>\n<p>Spreadsheet-based sensor data capture</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Presentations</h3>\n<p>Slide decks on embedded kiosk displays</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Compliance Docs</h3>\n<p>Encrypted compliance forms on medical devices</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Inventory</h3>\n<p>Warehouse inventory sheets on barcode scanners</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Configuration</h3>\n<p>Spreadsheet-driven device configuration</p>\n</div>\n</div>\n</div>\n</section><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
