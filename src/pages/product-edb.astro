const rawHead = "<meta content=\"EmbeddedOS Foundation — eDB — Embedded Database | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"eDB is the embedded database: SQL + Document + KV in one engine, REST API, JWT auth, AES-256 encryption at rest. Python.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, eDB, Python, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"eDB — Embedded Database — EmbeddedOS\" property=\"og:title\"><meta content=\"eDB is the embedded database: SQL + Document + KV in one engine, REST API, JWT auth, AES-256 encryption at rest. Python.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-edb\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-edb\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"eDB — Embedded Database — EmbeddedOS\" name=\"twitter:title\"><meta content=\"eDB is the embedded database: SQL + Document + KV in one engine, REST API, JWT auth, AES-256 encryption at rest. Python.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>eDB — Embedded Database | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"eDB\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"eDB is the EoS embedded database — a single, embeddable engine that speaks SQL, document, and key-value, exposes a REST API, ships JWT auth, and encrypts data at rest with AES-256.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-edb\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"eDB\", \"item\": \"https://www.embeddedos.org/product-edb\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-edb.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-edb\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>eDB</span></nav><div class=\"product-hero__visual\"><img alt=\"Storage chip macro — eDB\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-edb.svg\" width=\"1200\"></div><span class=\"lang-badge lang-py\"><span class=\"dot\"></span>Python · v0.1.0</span><h1 id=\"ph-edb\">eDB — Embedded Database</h1><p class=\"lede\">eDB is the EoS embedded database — a single, embeddable engine that speaks SQL, document, and key-value, exposes a REST API, ships JWT auth, and encrypts data at rest with AES-256.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/edb\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">3</div><div class=\"stat-label\">Models (SQL/Doc/KV)</div></div><div class=\"stat-tile\"><div class=\"stat-num\">REST</div><div class=\"stat-label\">API surface</div></div><div class=\"stat-tile\"><div class=\"stat-num\">JWT</div><div class=\"stat-label\">Auth</div></div><div class=\"stat-tile\"><div class=\"stat-num\">AES-256</div><div class=\"stat-label\">At-rest encryption</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What eDB is</h2></div><div class=\"prose\"><p>Where embedded apps usually pick between SQLite (relational), a JSON file (document), and a config blob (KV), eDB gives you all three in one process — pick the right model per collection without spinning up another database.</p><p>REST and capability-gated EIPC access make it equally usable from a local app, a remote service, or a federation of devices.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of eDB at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Three Data Models</h3><p>SQL tables, JSON documents, key-value buckets — same transaction surface.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>REST API</h3><p>Auto-generated CRUD endpoints with OpenAPI schemas.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>JWT Auth</h3><p>Pluggable identity providers; per-collection ACLs.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>AES-256 At Rest</h3><p>File-level encryption; keys rooted in the eBoot chain-of-trust.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Replication</h3><p>Multi-master CRDT-based sync across nodes; conflict-free by construction.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Time-Travel Queries</h3><p>Query past snapshots; built-in audit log per collection.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>EIPC Binding</h3><p>Native capability-gated access from any EoS process.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Backup &amp; Restore</h3><p>Point-in-time snapshot, encrypted offsite backup.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Embeddable</h3><p>&lt; 2 MB binary; runs in-process or as a shared service.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>eDB is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/edb</h3><p>SQL + Document + KV in one engine, with REST, JWT, and AES-256 at rest.</p><div class=\"repo-tags\"><span class=\"repo-tag\">Python</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/edb\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>eDB is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"#34d399\" height=\"36\" rx=\"8\" stroke=\"#34d399\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that eDB commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eapps.html\"><span class=\"cl-name\">eApps</span><span class=\"cl-blurb\">A curated library of 60+ ready-to-deploy apps for every EoS device class.</span></a><a class=\"cross-link\" href=\"product-eipc.html\"><span class=\"cl-name\">EIPC</span><span class=\"cl-blurb\">Capability-secured IPC fabric: predictable latency, HMAC-authenticated messages.</span></a><a class=\"cross-link\" href=\"product-eai.html\"><span class=\"cl-name\">EAI</span><span class=\"cl-blurb\">On-device LLM inference, ReAct agents, LoRA, and federated learning — at edge power budgets.</span></a></div></div></section><section aria-labelledby=\"arch-diag\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Architecture</span>\n<h2 id=\"arch-diag\">eDB Embedded Database Architecture</h2>\n<p>The eight-layer eDB architecture from SQL query interface through query planner, transaction manager, B-Tree index, page cache, storage engine, AES-XTS encryption, down to the physical storage media.</p>\n</div>\n<div class=\"diagram-wrap\">\n<img alt=\"eDB Embedded Database Architecture\" class=\"arch-diagram\" height=\"520\" loading=\"lazy\" src=\"img/diagrams/diag-edb.svg\" width=\"860\">\n</div>\n</div>\n</section>\n<section aria-labelledby=\"specs-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Technical Specifications</span>\n<h2 id=\"specs-h\">eDB at a Glance</h2>\n</div>\n<div class=\"specs-table-wrap\">\n<table aria-label=\"eDB at a Glance\" class=\"specs-table\"><thead><tr><th scope=\"row\">Query Language</th><td>Subset SQL (SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, INDEX) + JSON Path</td></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Transaction Model</th><td>ACID transactions with Write-Ahead Logging (WAL) and MVCC</td></tr>\n<tr><th scope=\"row\">Index Types</th><td>B-Tree (range queries), Hash (equality), Full-text (trigram)</td></tr>\n<tr><th scope=\"row\">Encryption</th><td>AES-256-XTS per-page encryption; key derivation via HKDF-SHA256</td></tr>\n<tr><th scope=\"row\">Minimum RAM</th><td>64 KB (page cache + B-Tree nodes for a 4-table schema)</td></tr>\n<tr><th scope=\"row\">Storage Backends</th><td>NOR Flash, NAND Flash, SD/eMMC, QSPI Flash, SRAM/PSRAM, POSIX file system</td></tr>\n<tr><th scope=\"row\">Max Database Size</th><td>Up to 4 GB on 32-bit targets; unlimited on 64-bit</td></tr>\n<tr><th scope=\"row\">Concurrent Readers</th><td>Unlimited concurrent reads (MVCC snapshot isolation)</td></tr>\n<tr><th scope=\"row\">Write Throughput</th><td>Up to 50,000 inserts/second on Cortex-M7 @ 480 MHz with NOR Flash</td></tr>\n<tr><th scope=\"row\">Crash Recovery</th><td>Automatic WAL replay on power-loss recovery; &lt; 100 ms recovery time</td></tr>\n<tr><th scope=\"row\">License</th><td>MIT — commercial use permitted without royalty</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"code-h\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Quick Start</span>\n<h2 id=\"code-h\">Storing Sensor Data with eDB</h2>\n</div>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\"><span class=\"code-lang\">C</span><span class=\"code-copy-hint\">Quick Start</span></div>\n<pre class=\"code-block\"><code>#include \"edb/edb.h\"\n\n/* Open (or create) an encrypted database */\nstatic edb_t *db;\n\nvoid db_init(void) {\n    edb_config_t cfg = {\n        .backend    = EDB_BACKEND_NOR_FLASH,\n        .flash_base = 0x08080000,\n        .flash_size = 512 * 1024,   /* 512 KB */\n        .page_size  = 4096,\n        .encrypt    = true,\n        .key        = device_secret_key,  /* 32-byte AES key */\n    };\n    db = edb_open(&amp;cfg);\n\n    /* Create table if it doesn't exist */\n    edb_exec(db,\n        \"CREATE TABLE IF NOT EXISTS readings (\"\n        \"  id        INTEGER PRIMARY KEY AUTOINCREMENT,\"\n        \"  ts        INTEGER NOT NULL,\"\n        \"  sensor_id INTEGER NOT NULL,\"\n        \"  value     REAL    NOT NULL\"\n        \");\");\n}\n\nvoid db_insert_reading(uint32_t ts, uint8_t sensor_id, float value) {\n    edb_stmt_t *stmt = edb_prepare(db,\n        \"INSERT INTO readings (ts, sensor_id, value) VALUES (?, ?, ?);\");\n    edb_bind_int(stmt, 1, ts);\n    edb_bind_int(stmt, 2, sensor_id);\n    edb_bind_real(stmt, 3, value);\n    edb_step(stmt);\n    edb_finalize(stmt);\n}</code></pre>\n<p class=\"code-note\">eDB uses WAL mode by default — no data loss on power failure.</p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"usecases-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Applications</span>\n<h2 id=\"usecases-h\">Where eDB Is Used</h2>\n</div>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">📊</div>\n<h3>Sensor Data Logging</h3>\n<p>Time-series sensor data storage on microcontrollers with automatic wear leveling and crash-safe writes to NOR Flash.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏥</div>\n<h3>Medical Records</h3>\n<p>Encrypted patient data storage on implantable and wearable medical devices with ACID guarantees and tamper evidence.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🚗</div>\n<h3>Automotive Event Logging</h3>\n<p>Black-box event logging for ADAS and autonomous vehicles with millisecond-precision timestamps and crash recovery.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏭</div>\n<h3>Industrial Historians</h3>\n<p>Process historian functionality on edge PLCs and RTUs, storing production data locally before cloud synchronization.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🔒</div>\n<h3>Secure Configuration</h3>\n<p>Encrypted device configuration and provisioning data storage with integrity verification on IoT devices.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🌐</div>\n<h3>Offline-First IoT</h3>\n<p>Local data buffering on IoT devices during connectivity outages, with automatic sync when connection is restored.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with eDB?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/edb\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-edb-metrics\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
