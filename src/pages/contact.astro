const rawHead = "<meta content=\"EmbeddedOS Foundation — Contact Us — EmbeddedOS Foundation. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"@embeddedos\" name=\"twitter:site\"><meta content=\"Contact Us — EmbeddedOS Foundation\" name=\"twitter:title\"><meta content=\"Contact the EmbeddedOS Research Foundation. General inquiries, technical support, partnerships, and press.\" name=\"twitter:description\"><meta content=\"https://embeddedos-org.github.io/og-image.png\" name=\"twitter:image\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"Contact the EmbeddedOS Research Foundation. General inquiries, technical support, partnerships, and press.\" name=\"description\"><title>Contact Us — EmbeddedOS Foundation</title>\n<meta content=\"Contact — EmbeddedOS Research Foundation\" property=\"og:title\"><meta content=\"Contact the EmbeddedOS Research Foundation. General inquiries, technical support, partnerships, and press.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/contact\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"> <link href=\"https://www.embeddedos.org/contact.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a><span class=\"separator\">›</span><span class=\"current\">Contact</span></nav><main id=\"main-content\"><section class=\"hero\"><div aria-hidden=\"true\" class=\"hero__orb hero__orb--2\"></div>\n<div aria-hidden=\"true\" class=\"hero__orb hero__orb--1\"></div>\n<div aria-hidden=\"true\" class=\"hero__grid\"></div>\n<div aria-hidden=\"true\" class=\"hero__bg\"></div><div class=\"hero-container\"><div class=\"hero-content section-header\"><span class=\"badge badge-blue\">CONTACT</span><h1 class=\"mt-2\">Get in <span>Touch</span></h1><p>Have questions? Want to collaborate? Need support? We're here to help. Reach out to our team and we'll get back to you as soon as possible.</p></div></div></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Reach Out</span><h2>Contact Our Team</h2><p>Choose the right channel for your inquiry</p></div><div class=\"cards-grid cards-grid-3\"><div class=\"contact-info-card\"><div class=\"contact-icon help\"><svg aria-hidden=\"true\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"emailGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#emailGrad)\" height=\"60\" rx=\"12\" width=\"60\"></rect><rect fill=\"none\" height=\"24\" rx=\"3\" stroke=\"white\" stroke-width=\"2.5\" width=\"36\" x=\"12\" y=\"18\"></rect><path d=\"M12 21 L30 33 L48 21\" fill=\"none\" stroke=\"white\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\"></path></svg></div><div class=\"contact-details\"><h3>General Inquiries</h3><p>Questions about partnerships, collaborations, research, or general information</p><a href=\"mailto:help@embeddedos.org\">help@embeddedos.org</a><div class=\"response-time\"><svg aria-hidden=\"true\" fill=\"none\" height=\"14\" viewBox=\"0 0 24 24\" width=\"14\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#6b7280\" stroke-width=\"2\"></circle><path d=\"M12 6v6l4 2\" stroke=\"#6b7280\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg><span>Response within 24-48 hours</span></div></div></div><div class=\"contact-info-card\"><div class=\"contact-icon support\"><svg aria-hidden=\"true\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"toolsGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#toolsGrad)\" height=\"60\" rx=\"12\" width=\"60\"></rect><path d=\"M38 22c-2.2 0-4.2.9-5.7 2.3l-8 8c-1.4 1.5-2.3 3.5-2.3 5.7 0 4.4 3.6 8 8 8 2.2 0 4.2-.9 5.7-2.3l8-8c1.4-1.5 2.3-3.5 2.3-5.7 0-4.4-3.6-8-8-8z\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\"></path><circle cx=\"30\" cy=\"30\" fill=\"white\" r=\"4\"></circle><path d=\"M18 18l6 6M36 36l6 6\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2.5\"></path></svg></div><div class=\"contact-details\"><h3>Website Support</h3><p>Technical issues, bug reports, or website-related questions</p><a href=\"mailto:support@embeddedos.org\">support@embeddedos.org</a><div class=\"response-time\"><svg aria-hidden=\"true\" fill=\"none\" height=\"14\" viewBox=\"0 0 24 24\" width=\"14\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#6b7280\" stroke-width=\"2\"></circle><path d=\"M12 6v6l4 2\" stroke=\"#6b7280\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg><span>Response within 24 hours</span></div></div></div><div class=\"contact-info-card\"><div class=\"contact-icon volunteer\"><svg aria-hidden=\"true\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"handshakeGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#handshakeGrad)\" height=\"60\" rx=\"12\" width=\"60\"></rect><path d=\"M15 32c0-2 1-4 3-5l7-4c1-.5 2-.5 3 0l2 1 2-1c1-.5 2-.5 3 0l7 4c2 1 3 3 3 5v3c0 1-.5 2-1 2h-4c-.5 0-1-.5-1-1v-5l-4-2-3 2v5c0 .5-.5 1-1 1h-4c-.5 0-1-.5-1-1v-5l-3-2-4 2v5c0 .5-.5 1-1 1h-4c-.5 0-1-1-1-2v-3z\" fill=\"white\"></path><circle cx=\"22\" cy=\"22\" fill=\"white\" r=\"4\"></circle><circle cx=\"38\" cy=\"22\" fill=\"white\" r=\"4\"></circle></svg></div><div class=\"contact-details\"><h3>Volunteer Opportunities</h3><p>Interested in contributing your time and skills to our mission?</p><a href=\"mailto:volunteer@embeddedos.org\">volunteer@embeddedos.org</a><div class=\"response-time\"><svg aria-hidden=\"true\" fill=\"none\" height=\"14\" viewBox=\"0 0 24 24\" width=\"14\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#6b7280\" stroke-width=\"2\"></circle><path d=\"M12 6v6l4 2\" stroke=\"#6b7280\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg><span>Response within 48-72 hours</span></div></div></div></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"contact-grid\"><div class=\"contact-form\"><h2>Send Us a Message</h2><p>Fill out the form below and we'll get back to you shortly.</p><form action=\"#\" data-web3forms-action=\"https://api.web3forms.com/submit\" id=\"contactForm\" method=\"POST\"><input id=\"web3forms-key\" name=\"access_key\" type=\"hidden\" value=\"\"><input name=\"from_name\" type=\"hidden\" value=\"EoS Website Contact Form\"><input name=\"subject\" type=\"hidden\" value=\"New Contact Form Submission - EoS Website\"><input hidden=\"\" name=\"botcheck\" type=\"checkbox\"><input name=\"redirect\" type=\"hidden\" value=\"\"><div class=\"form-group\"><label for=\"name\">Full Name *</label><input id=\"name\" name=\"name\" placeholder=\"Your full name\" required=\"\" type=\"text\"></div><div class=\"form-group\"><label for=\"email\">Email Address *</label><input id=\"email\" name=\"email\" placeholder=\"your.email@example.com\" required=\"\" type=\"email\"></div><div class=\"form-group\"><label for=\"organization\">Organization</label><input id=\"organization\" name=\"organization\" placeholder=\"Your company or institution\" type=\"text\"></div><div class=\"form-group\"><label for=\"topic\">Subject *</label><select id=\"topic\" name=\"topic\" required=\"\"><option value=\"\">Select a topic</option><option value=\"General Inquiry\">General Inquiry</option><option value=\"Partnership Opportunity\">Partnership Opportunity</option><option value=\"Research Collaboration\">Research Collaboration</option><option value=\"Membership Questions\">Membership Questions</option><option value=\"Certification Information\">Certification Information</option><option value=\"Internship Program\">Internship Program</option><option value=\"Donation Inquiry\">Donation Inquiry</option><option value=\"Media/Press Request\">Media/Press Request</option><option value=\"Technical Support\">Technical Support</option><option value=\"Volunteer Interest\">Volunteer Interest</option><option value=\"Other\">Other</option></select></div><div class=\"form-group\"><label for=\"message\">Message *</label> <textarea id=\"message\" name=\"message\" placeholder=\"How can we help you?\" required=\"\"></textarea> </div><div class=\"form-group\"><label><input id=\"privacy\" required=\"\" type=\"checkbox\"><span>I agree to the <a href=\"privacy.html\">Privacy Policy</a> and consent to being contacted.</span></label></div><button class=\"btn btn-primary\" id=\"submitBtn\" type=\"submit\"> Send Message </button></form><div class=\"text-center\" hidden=\"\" id=\"formSuccess\"><div><svg aria-hidden=\"true\" height=\"64\" viewBox=\"0 0 64 64\" width=\"64\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"32\" cy=\"32\" fill=\"#22c55e\" r=\"30\"></circle><path d=\"M20 32l8 8 16-16\" fill=\"none\" stroke=\"white\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"4\"></path></svg></div><h3>Message Sent Successfully!</h3><p>Thank you for reaching out. We'll get back to you within 24-48 hours.</p><button class=\"btn btn-secondary mt-3\" data-action=\"reset-contact\" type=\"button\">Send Another Message</button></div><div class=\"text-center mt-2\" hidden=\"\" id=\"formError\"><div>⚠️</div><p>Something went wrong. Please try again or email us directly at <a href=\"mailto:help@embeddedos.org\">help@embeddedos.org</a></p></div></div><div><h2>Other Ways to Connect</h2><div class=\"contact-info-card mb-3\"><div class=\"contact-icon\"><svg aria-hidden=\"true\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"locationGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#locationGrad)\" height=\"60\" rx=\"12\" width=\"60\"></rect><path d=\"M30 12c-7.7 0-14 6.3-14 14 0 10.5 14 22 14 22s14-11.5 14-22c0-7.7-6.3-14-14-14z\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\"></path><circle cx=\"30\" cy=\"26\" fill=\"white\" r=\"5\"></circle></svg></div><div class=\"contact-details\"><h3>Headquarters</h3><p>EmbeddedOS Research Foundation<br> 123 Innovation Drive, Suite 400<br> San Francisco, CA 94105<br> United States</p></div></div><div class=\"contact-info-card mb-3\"><div class=\"contact-icon\"><svg aria-hidden=\"true\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"globeGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#globeGrad)\" height=\"60\" rx=\"12\" width=\"60\"></rect><circle cx=\"30\" cy=\"30\" fill=\"none\" r=\"14\" stroke=\"white\" stroke-width=\"2.5\"></circle><ellipse cx=\"30\" cy=\"30\" fill=\"none\" rx=\"6\" ry=\"14\" stroke=\"white\" stroke-width=\"2\"></ellipse><path d=\"M16 30h28M16 24h28M16 36h28\" opacity=\"0.7\" stroke=\"white\" stroke-width=\"1.5\"></path></svg></div><div class=\"contact-details\"><h3>Social Media</h3><p>Follow us for news, updates, and community discussions</p><div><a href=\"https://x.com/embeddedos\" rel=\"noopener noreferrer\" target=\"_blank\">𝕏</a><a href=\"https://www.linkedin.com/company/embedded-operating-systems-research-foundation\" rel=\"noopener noreferrer\" target=\"_blank\">in</a><a href=\"https://github.com/embeddedos-org\">GH</a><a href=\"https://www.youtube.com/@embeddedos\" rel=\"noopener noreferrer\" target=\"_blank\">YT</a></div></div></div><div class=\"contact-info-card\"><div class=\"contact-icon\"><svg aria-hidden=\"true\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"newsGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#newsGrad)\" height=\"60\" rx=\"12\" width=\"60\"></rect><rect fill=\"none\" height=\"32\" rx=\"3\" stroke=\"white\" stroke-width=\"2.5\" width=\"32\" x=\"14\" y=\"14\"></rect><rect fill=\"white\" height=\"10\" rx=\"1\" width=\"12\" x=\"18\" y=\"18\"></rect><path d=\"M34 20h8M34 25h8M18 32h24M18 38h24\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg></div><div class=\"contact-details\"><h3>Media &amp; Press</h3><p>For press inquiries, interview requests, or media resources</p><a href=\"mailto:press@embeddedos.org\">press@embeddedos.org</a></div></div><div class=\"map-placeholder mt-3\"><svg aria-hidden=\"true\" height=\"80\" viewBox=\"0 0 80 80\" width=\"80\"><circle cx=\"40\" cy=\"40\" fill=\"#e3f2fd\" r=\"35\"></circle><circle cx=\"40\" cy=\"35\" fill=\"#0066cc\" r=\"12\"></circle><path d=\"M40,47 L40,60\" stroke=\"#0066cc\" stroke-linecap=\"round\" stroke-width=\"4\"></path><circle cx=\"40\" cy=\"35\" fill=\"white\" r=\"5\"></circle></svg><p>San Francisco, California</p><a class=\"btn btn-outline btn-sm\" href=\"contact.html\">View on Map</a></div></div></div></div></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Departments</span><h2>Contact by Department</h2><p>Reach the right team directly</p></div><table class=\"data-table\"><thead><tr><th scope=\"col\">Department</th><th scope=\"col\">Contact For</th><th scope=\"col\">Email</th></tr></thead><tbody><tr><td><strong>General Inquiries</strong></td><td>Partnerships, collaborations, general questions</td><td><a href=\"mailto:help@embeddedos.org\">help@embeddedos.org</a></td></tr><tr><td><strong>Technical Support</strong></td><td>Website issues, technical questions, bug reports</td><td><a href=\"mailto:support@embeddedos.org\">support@embeddedos.org</a></td></tr><tr><td><strong>Volunteer Program</strong></td><td>Volunteering opportunities, community involvement</td><td><a href=\"mailto:volunteer@embeddedos.org\">volunteer@embeddedos.org</a></td></tr><tr><td><strong>Membership</strong></td><td>Membership tiers, benefits, enterprise partnerships</td><td><a href=\"mailto:membership@embeddedos.org\">membership@embeddedos.org</a></td></tr><tr><td><strong>Certification</strong></td><td>Certification programs, exams, training</td><td><a href=\"mailto:certification@embeddedos.org\">certification@embeddedos.org</a></td></tr><tr><td><strong>Research</strong></td><td>Research collaborations, academic partnerships</td><td><a href=\"mailto:research@embeddedos.org\">research@embeddedos.org</a></td></tr><tr><td><strong>Donations &amp; Grants</strong></td><td>Corporate giving, grants, sponsorships</td><td><a href=\"mailto:donate@embeddedos.org\">donate@embeddedos.org</a></td></tr><tr><td><strong>Press &amp; Media</strong></td><td>Media inquiries, interviews, press resources</td><td><a href=\"mailto:press@embeddedos.org\">press@embeddedos.org</a></td></tr><tr><td><strong>Careers</strong></td><td>Job opportunities, internships</td><td><a href=\"mailto:careers@embeddedos.org\">careers@embeddedos.org</a></td></tr></tbody></table></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Quick Help</span><h2>Frequently Asked Questions</h2><p>Common questions about contacting us</p></div><div class=\"cards-grid cards-grid-2\"><div class=\"feature-card\"><h3>How quickly will I receive a response?</h3><p>We typically respond to all inquiries within 24-48 business hours. For urgent technical issues, responses may be faster.</p></div><div class=\"feature-card\"><h3>Can I schedule a meeting with your team?</h3><p>Yes! For partnership or research discussions, send us an email and we'll arrange a video call at your convenience.</p></div><div class=\"feature-card\"><h3>Do you have offices outside the US?</h3><p>We're a globally distributed organization with contributors worldwide, but our legal headquarters is in San Francisco.</p></div><div class=\"feature-card\"><h3>How can I contribute to the foundation?</h3><p>You can contribute through code (GitHub), donations, volunteering, or becoming a member. Contact us to learn more!</p></div></div></div></section><section class=\"cta-section\"><h2>Ready to Get Started?</h2><p>Whether you want to collaborate, contribute, or just learn more—we're here for you.</p><div class=\"cta-buttons\"><a class=\"btn btn-dark\" href=\"membership.html\">Join the Foundation</a><a class=\"btn btn-secondary\" href=\"donate.html\">Support Our Mission</a></div></section></main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
