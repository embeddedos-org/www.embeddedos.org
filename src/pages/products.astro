import Base from "../layouts/Base.astro";
const rawHead = "<meta content=\"EmbeddedOS Foundation — Products — EmbeddedOS Foundation. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n\n<!-- SEO: Primary -->\n<meta content=\"Explore all 14 EmbeddedOS products: EoS RTOS, EAI LLM runtime, ENI neural stack, eIPC, EoStudio IDE, EoSim, eBoot, eBuild, eVera, eOffice, eBrowser, eDB,…\" name=\"description\">\n<meta content=\"EoS RTOS, EAI runtime, ENI neural interface, eIPC, EoStudio, EoSim, eBoot, eBuild, eVera, eOffice, eBrowser, eDB, HEALTH-KEY ULTRA, embedded AI products\" name=\"keywords\">\n<meta content=\"EmbeddedOS Research Foundation\" name=\"author\">\n<meta content=\"index, follow\" name=\"robots\">\n<link href=\"https://embeddedos.org/products.html\" rel=\"canonical\">\n<!-- SEO: Open Graph -->\n<meta content=\"website\" property=\"og:type\">\n<meta content=\"Products — EmbeddedOS Foundation\" property=\"og:title\">\n<meta content=\"Explore all 14 EmbeddedOS products: EoS RTOS, EAI LLM runtime, ENI neural stack, eIPC, EoStudio IDE, EoSim, eBoot, eBuild, eVera, eOffice, eBrowser, eDB, HEALTH-KEY ULTRA, HEALTH-BAND Neuro.\" property=\"og:description\">\n<meta content=\"https://embeddedos.org/products.html\" property=\"og:url\">\n<meta content=\"https://embeddedos.org/img/og-cover.svg\" property=\"og:image\">\n<meta content=\"EmbeddedOS Foundation\" property=\"og:site_name\">\n<meta content=\"en_US\" property=\"og:locale\">\n<!-- SEO: Twitter Card -->\n<meta content=\"summary_large_image\" name=\"twitter:card\">\n<meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\">\n<meta content=\"Products — EmbeddedOS Foundation\" name=\"twitter:title\">\n<meta content=\"Explore all 14 EmbeddedOS products: EoS RTOS, EAI LLM runtime, ENI neural stack, eIPC, EoStudio IDE, EoSim, eBoot, eBuild, eVera, eOffice, eBrowser, eDB, HEALTH-KEY ULTRA, HEALTH-BAND Neuro.\" name=\"twitter:description\">\n<meta content=\"https://embeddedos.org/img/og-cover.svg\" name=\"twitter:image\">\n<!-- SEO: JSON-LD -->\n<script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Organization\",\n    \"name\": \"EmbeddedOS Research Foundation\",\n    \"url\": \"https://embeddedos.org\",\n    \"logo\": \"https://embeddedos.org/img/logo.svg\",\n    \"sameAs\": [\n      \"https://github.com/embeddedos-org\",\n      \"https://x.com/EmbeddedOS_ORG\",\n      \"https://www.linkedin.com/company/embedded-operating-systems-research-foundation\"\n    ],\n    \"description\": \"501(c)(3) nonprofit building the world\\'s most complete open-source embedded AI stack.\"\n  }\n  </script>\n\n<meta content=\"#060912\" name=\"theme-color\">\n<title>Products — EmbeddedOS Foundation</title>\n\n\n<style>\n/* Page-specific styles */\n.page-hero {\n  padding: 5rem 1.5rem 3.5rem;\n  background: var(--bg-base);\n  position: relative; overflow: hidden;\n}\n.page-hero::before {\n  content: ''; position: absolute; inset: 0;\n  background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(59,130,246,.2), transparent 60%);\n  pointer-events: none;\n}\n.page-hero__inner { position: relative; max-width: 1100px; margin: 0 auto; }\n.page-hero h1 { font-size: clamp(2rem,4vw,3.2rem); font-weight: 900; letter-spacing: -.05em; color: var(--text-primary); margin-bottom: .75rem; }\n.page-hero p { font-size: 1.05rem; color: var(--text-secondary); max-width: 640px; line-height: 1.7; }\n\n/* Product detail cards */\n.product-detail {\n  background: var(--bg-card); border: 1px solid var(--border);\n  border-radius: var(--radius-xl); overflow: hidden;\n  margin-bottom: 1.5rem;\n  transition: border-color var(--transition-med);\n}\n.product-detail:hover { border-color: var(--border-strong); }\n.product-detail__header {\n  padding: 2rem 2rem 1.5rem;\n  border-bottom: 1px solid var(--border);\n  display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: start;\n}\n.product-detail__body { padding: 2rem; }\n.product-detail__title { font-size: 1.5rem; font-weight: 900; color: var(--text-primary); letter-spacing: -.04em; margin-bottom: .4rem; }\n.product-detail__subtitle { font-size: .9rem; color: var(--text-secondary); line-height: 1.65; max-width: 580px; }\n.product-detail__links { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1rem; }\n.product-detail__links a {\n  display: inline-flex; align-items: center; gap: .35rem;\n  padding: .4rem .85rem; border-radius: 8px;\n  font-size: .8rem; font-weight: 600;\n  transition: all var(--transition-fast);\n}\n.link--primary { background: var(--gradient-blue); color: #fff; }\n.link--primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(59,130,246,.4); }\n.link--ghost { background: rgba(255,255,255,.06); color: var(--text-secondary); border: 1px solid var(--border); }\n.link--ghost:hover { background: rgba(255,255,255,.1); color: var(--text-primary); }\n\n/* Spec grid */\n.spec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .75rem; margin-bottom: 1.5rem; }\n.spec-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: .85rem 1rem; }\n.spec-item__label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); margin-bottom: .25rem; }\n.spec-item__value { font-size: .9rem; font-weight: 700; color: var(--text-primary); font-family: 'JetBrains Mono', monospace; }\n.spec-item__value.highlight { background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }\n\n/* Platform support pills */\n.platform-row { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1.25rem; }\n.platform-pill {\n  display: inline-flex; align-items: center; gap: .3rem;\n  padding: .25rem .65rem; border-radius: 99px;\n  font-size: .72rem; font-weight: 700;\n}\n.platform-pill--yes { background: rgba(52,211,153,.12); color: var(--emerald-400); border: 1px solid rgba(52,211,153,.25); }\n.platform-pill--build { background: rgba(251,191,36,.1); color: var(--amber-400); border: 1px solid rgba(251,191,36,.2); }\n.platform-pill--plan { background: rgba(255,255,255,.05); color: var(--text-muted); border: 1px solid var(--border); }\n\n/* Binary table */\n.binary-table { width: 100%; border-collapse: collapse; font-size: .82rem; }\n.binary-table th { background: var(--bg-elevated); color: var(--text-muted); padding: .6rem .9rem; text-align: left; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid var(--border); }\n.binary-table td { padding: .55rem .9rem; border-bottom: 1px solid rgba(255,255,255,.04); color: var(--text-secondary); vertical-align: middle; }\n.binary-table tbody tr:last-child td { border-bottom: none; }\n.binary-table td:first-child { font-family: 'JetBrains Mono', monospace; color: var(--text-primary); font-size: .78rem; }\n.binary-table .avail { color: var(--emerald-400); font-weight: 700; font-size: .72rem; }\n.binary-table .inprog { color: var(--amber-400); font-weight: 700; font-size: .72rem; }\n.binary-table .planned { color: var(--text-muted); font-size: .72rem; }\n.binary-table .barrier { color: var(--rose-400); font-size: .72rem; }\n\n/* Compat matrix */\n.compat-wrap { overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--border); }\n.compat-tbl { width: 100%; border-collapse: collapse; font-size: .78rem; min-width: 900px; }\n.compat-tbl th { background: var(--bg-elevated); color: var(--text-muted); padding: .65rem .75rem; text-align: center; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--border); }\n.compat-tbl th:first-child { text-align: left; min-width: 180px; }\n.compat-tbl td { padding: .55rem .75rem; border-bottom: 1px solid rgba(255,255,255,.04); text-align: center; color: var(--text-secondary); }\n.compat-tbl td:first-child { text-align: left; font-weight: 700; color: var(--text-primary); font-family: 'JetBrains Mono', monospace; font-size: .78rem; }\n.compat-tbl tbody tr:hover { background: rgba(255,255,255,.02); }\n.cy { color: var(--emerald-400); font-size: .9rem; }\n.cb { color: var(--amber-400); font-size: .72rem; font-weight: 700; }\n.cn { color: rgba(255,255,255,.15); font-size: .9rem; }\n\n/* Coverage table */\n.cov-tbl { width: 100%; border-collapse: collapse; font-size: .82rem; }\n.cov-tbl th { background: var(--bg-elevated); color: var(--text-muted); padding: .65rem .9rem; text-align: left; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid var(--border); }\n.cov-tbl td { padding: .6rem .9rem; border-bottom: 1px solid rgba(255,255,255,.04); color: var(--text-secondary); vertical-align: middle; }\n.cov-tbl tbody tr:last-child td { border-bottom: none; }\n.cov-tbl tbody tr:hover { background: rgba(255,255,255,.02); }\n.cov-tbl td:first-child { color: var(--text-primary); font-weight: 700; font-size: .82rem; }\n.cov-bar-wrap { display: flex; align-items: center; gap: .6rem; min-width: 120px; }\n.cov-bar-bg { flex: 1; height: 6px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }\n.cov-bar-fg { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#3b82f6,#8b5cf6); }\n.cov-pct { font-family: 'JetBrains Mono', monospace; font-size: .78rem; font-weight: 700; color: var(--emerald-400); min-width: 38px; text-align: right; }\n.pass-badge { display: inline-flex; align-items: center; gap: .25rem; font-size: .7rem; font-weight: 700; padding: .15rem .45rem; border-radius: 5px; background: rgba(52,211,153,.12); color: var(--emerald-400); border: 1px solid rgba(52,211,153,.2); }\n.warn-badge { background: rgba(251,191,36,.1); color: var(--amber-400); border-color: rgba(251,191,36,.2); }\n\n/* Section tabs */\n.sticky-tabs {\n  position: sticky; top: 60px; z-index: 100;\n  background: rgba(6,9,18,.95); backdrop-filter: blur(16px);\n  border-bottom: 1px solid var(--border);\n  padding: 0 1.5rem;\n}\n.sticky-tabs__inner { max-width: 1100px; margin: 0 auto; display: flex; gap: 0; overflow-x: auto; }\n.sticky-tab {\n  padding: .85rem 1.1rem; font-size: .85rem; font-weight: 600;\n  color: var(--text-muted); border-bottom: 2px solid transparent;\n  white-space: nowrap; transition: color var(--transition-fast), border-color var(--transition-fast);\n}\n.sticky-tab:hover { color: var(--text-primary); }\n.sticky-tab.active { color: var(--blue-400); border-bottom-color: var(--blue-400); }\n\n@media (max-width: 768px) {\n  .product-detail__header { grid-template-columns: 1fr; }\n  .spec-grid { grid-template-columns: repeat(2,1fr); }\n}\n</style>\n<link href=\"https://www.embeddedos.org/products.html\" rel=\"canonical\">";
const content = "<div class=\"live-bar\" role=\"status\">\n<span aria-hidden=\"true\" class=\"live-pulse\"></span>\n<span>EAI 0.9 — INT4 LLM at 11 tok/s on Cortex-M85 &nbsp;·&nbsp; <a href=\"article-eai-llm-bench.html\">Benchmark →</a></span>\n</div>\n<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n\n<div class=\"page-hero\">\n<div class=\"page-hero__inner\">\n<span class=\"section__eyebrow\">14 Products. One Stack.</span>\n<h1>The complete embedded AI platform.</h1>\n<p>Every component you need — from a deterministic RTOS kernel to on-device LLM inference, neural interfaces, autonomous AI agents, and world-class developer tools. All open source. All MIT.</p>\n</div>\n</div>\n<nav aria-label=\"Page sections\" class=\"sticky-tabs\">\n<div class=\"sticky-tabs__inner\">\n<a class=\"sticky-tab active\" href=\"#products\">All Products</a>\n<a class=\"sticky-tab\" href=\"#coverage\">Test Coverage</a>\n<a class=\"sticky-tab\" href=\"#compat\">Compatibility Matrix</a>\n<a class=\"sticky-tab\" href=\"#binaries\">Release Binaries</a>\n<a class=\"sticky-tab\" href=\"#barriers\">Barriers &amp; Roadmap</a>\n</div>\n</nav>\n<main id=\"main-content\">\n<!-- ══════════════════════════════════════════\n     ALL PRODUCTS\n══════════════════════════════════════════ -->\n<section class=\"section section--dark\" id=\"products\">\n<div class=\"section__inner\">\n<div class=\"animate-on-scroll\" style=\"margin-bottom:2.5rem\">\n<span class=\"section__eyebrow\">System Stack</span>\n<h2 class=\"section__title\">14 production-ready components</h2>\n<p class=\"section__sub\">Organized by layer — from bare metal to user-facing applications.</p>\n</div>\n<!-- ── EoS RTOS ── -->\n<div class=\"product-detail animate-on-scroll\" id=\"eos-rtos\">\n<div class=\"product-detail__header\">\n<div>\n<span class=\"product-card__tag tag--blue\" style=\"margin-bottom:.75rem\">⚙ Layer 1 — RTOS Kernel</span>\n<div class=\"product-detail__title\">EoS RTOS</div>\n<div class=\"product-detail__subtitle\">A deterministic, preemptive real-time operating system written in C. Sub-microsecond context switch on ARM Cortex-M7 @ 216 MHz. Priority-ceiling protocol, tickless idle, MPU/MMU isolation, and formal verification of the context-switch path (TLA+). The foundation every other EmbeddedOS component is built on.</div>\n<div class=\"product-detail__links\">\n<a class=\"link--primary\" href=\"product-eos.html\">Full Product Page →</a>\n<a class=\"link--ghost\" href=\"https://github.com/embeddedos-org/eos\" rel=\"noopener noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"link--ghost\" href=\"documentation.html#eos\">Docs</a>\n</div>\n</div>\n<div style=\"text-align:right\">\n<div style=\"font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:900;background:linear-gradient(135deg,#3b82f6,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-background-clip:text\">&lt;1μs</div>\n<div style=\"font-size:.75rem\">context switch</div>\n</div>\n</div>\n<div class=\"product-detail__body\">\n<div class=\"spec-grid\">\n<div class=\"spec-item\"><div class=\"spec-item__label\">Language</div><div class=\"spec-item__value\">C (ISO C11)</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Context Switch</div><div class=\"spec-item__value highlight\">&lt;1μs @ 216MHz</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Architectures</div><div class=\"spec-item__value\">ARM, RISC-V, x86, MIPS</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Scheduling</div><div class=\"spec-item__value\">Preemptive + Cooperative</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Synchronization</div><div class=\"spec-item__value\">Mutex, Semaphore, Queue</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Memory</div><div class=\"spec-item__value\">MPU/MMU isolation</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">License</div><div class=\"spec-item__value\">MIT</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Test Coverage</div><div class=\"spec-item__value highlight\">100%</div></div>\n</div>\n<div class=\"platform-row\">\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-M0/M0+</span>\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-M3/M4/M7</span>\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-M33/M55/M85</span>\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-A5/A7/A9</span>\n<span class=\"platform-pill platform-pill--yes\">✓ RISC-V RV32/RV64</span>\n<span class=\"platform-pill platform-pill--yes\">✓ x86 (simulation)</span>\n<span class=\"platform-pill platform-pill--build\">🔧 MIPS (in progress)</span>\n</div>\n</div>\n</div>\n<!-- ── EAI ── -->\n<div class=\"product-detail animate-on-scroll\" id=\"eai\">\n<div class=\"product-detail__header\">\n<div>\n<span class=\"product-card__tag tag--violet\" style=\"margin-bottom:.75rem\">🧠 Layer 2 — On-Device AI</span>\n<div class=\"product-detail__title\">EAI — Embedded AI Runtime</div>\n<div class=\"product-detail__subtitle\">The world's fastest open-source on-device LLM runtime for microcontrollers. INT4 quantization, custom SIMD kernels for ARM/RISC-V/x86, and a model compiler that fits a 1.3B parameter LLM in 312 MB of flash. 11 tokens/second on ARM Cortex-M85 — no cloud, no GPU, no internet. Outperforms llama.cpp and MLC LLM on every embedded target.</div>\n<div class=\"product-detail__links\">\n<a class=\"link--primary\" href=\"product-eai.html\">Full Product Page →</a>\n<a class=\"link--ghost\" href=\"https://github.com/embeddedos-org/eAI\" rel=\"noopener noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"link--ghost\" href=\"documentation.html#eai\">Docs</a>\n<a class=\"link--ghost\" href=\"article-eai-llm-bench.html\">Benchmark</a>\n</div>\n</div>\n<div style=\"text-align:right\">\n<div style=\"font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:900;background:linear-gradient(135deg,#8b5cf6,#22d3ee);-webkit-background-clip:text;-webkit-text-fill-background-clip:text\">11 tok/s</div>\n<div style=\"font-size:.75rem\">INT4 on Cortex-M85</div>\n</div>\n</div>\n<div class=\"product-detail__body\">\n<div class=\"spec-grid\">\n<div class=\"spec-item\"><div class=\"spec-item__label\">Language</div><div class=\"spec-item__value\">C + Python (compiler)</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Inference Speed</div><div class=\"spec-item__value highlight\">11 tok/s INT4</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Model Size</div><div class=\"spec-item__value\">1.3B params / 312MB</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Quantization</div><div class=\"spec-item__value\">INT4, INT8, FP16</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Input Formats</div><div class=\"spec-item__value\">ONNX, PyTorch, GGUF</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Kernels</div><div class=\"spec-item__value\">Custom SIMD (NEON/RVV)</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">License</div><div class=\"spec-item__value\">MIT</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">vs llama.cpp</div><div class=\"spec-item__value highlight\">3.2× faster</div></div>\n</div>\n<div class=\"platform-row\">\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-M55/M85 (INT4)</span>\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-M4/M7 (INT8)</span>\n<span class=\"platform-pill platform-pill--yes\">✓ RISC-V RV32/RV64</span>\n<span class=\"platform-pill platform-pill--yes\">✓ Linux x86-64</span>\n<span class=\"platform-pill platform-pill--yes\">✓ macOS ARM64</span>\n<span class=\"platform-pill platform-pill--build\">🔧 Android (in progress)</span>\n</div>\n</div>\n</div>\n<!-- ── ENI ── -->\n<div class=\"product-detail animate-on-scroll\" id=\"eni\">\n<div class=\"product-detail__header\">\n<div>\n<span class=\"product-card__tag tag--cyan\" style=\"margin-bottom:.75rem\">🧠 Layer 2 — Neural Interface</span>\n<div class=\"product-detail__title\">ENI — Embedded Neural Interface</div>\n<div class=\"product-detail__subtitle\">The world's only open-source neural interface RTOS stack. Real-time spike detection, LFP recording, and BLE streaming for up to 1,024 channels at 30 kHz. Sub-1ms closed-loop stimulation latency. Designed for BCI research, prosthetics, closed-loop neuromodulation, and next-generation wearables. Outperforms OpenEphys and Intan RHD on every latency metric.</div>\n<div class=\"product-detail__links\">\n<a class=\"link--primary\" href=\"product-eni.html\">Full Product Page →</a>\n<a class=\"link--ghost\" href=\"https://github.com/embeddedos-org/eNI\" rel=\"noopener noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"link--ghost\" href=\"documentation.html#eni\">Docs</a>\n</div>\n</div>\n<div style=\"text-align:right\">\n<div style=\"font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:900;background:linear-gradient(135deg,#22d3ee,#34d399);-webkit-background-clip:text;-webkit-text-fill-background-clip:text\">1,024 ch</div>\n<div style=\"font-size:.75rem\">at 30 kHz real-time</div>\n</div>\n</div>\n<div class=\"product-detail__body\">\n<div class=\"spec-grid\">\n<div class=\"spec-item\"><div class=\"spec-item__label\">Language</div><div class=\"spec-item__value\">C (ISO C11)</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Channels</div><div class=\"spec-item__value highlight\">1,024 simultaneous</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Sample Rate</div><div class=\"spec-item__value\">30 kHz per channel</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Noise Floor</div><div class=\"spec-item__value\">&lt;5μV RMS</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Stim Latency</div><div class=\"spec-item__value highlight\">&lt;1ms closed-loop</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Wireless</div><div class=\"spec-item__value\">BLE 5.3 lossless</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">Targets</div><div class=\"spec-item__value\">Cortex-M4/M7/M33</div></div>\n<div class=\"spec-item\"><div class=\"spec-item__label\">License</div><div class=\"spec-item__value\">MIT</div></div>\n</div>\n<div class=\"platform-row\">\n<span class=\"platform-pill platform-pill--yes\">✓ Cortex-M4/M7/M33</span>\n<span class=\"platform-pill platform-pill--yes\">✓ nRF52840/nRF5340</span>\n<span class=\"platform-pill platform-pill--yes\">✓ STM32H7 series</span>\n<span class=\"platform-pill platform-pill--yes\">✓ BLE 5.3 streaming</span>\n<span class=\"platform-pill platform-pill--build\">🔧 2048-ch (roadmap)</span>\n</div>\n</div>\n</div>\n<!-- ── eIPC ── -->\n<div class=\"product-detail animate-on-scroll\" id=\"eipc\">\n<div class=\"product-detail__header\">\n<div>\n<span class=\"product-card__tag tag--emerald\" style=\"margin-bottom:.75rem\">⚡ Layer 2 — Secure IPC</span>\n<div class=\"product-detail__title\">eIPC — Secure Inter-Process Communication</div>\n<div class=\"product-detail__subtitle\">Ultra-low latency IPC written in Go. Shared-memory zero-copy transport with DMA acceleration, HMAC-SHA256 per-message authentication, and capability-based access control. 0.8μs round-trip latency — 15× faster than Unix domain sockets, 56× faster than D-Bus. Works on Linux, macOS, and EoS RTOS.</div>\n<div class=\"product-detail__links\">\n<a class=\"link--primary\" href=\"product-eipc.html\">Full Product Page →</a>\n<a class=\"link--ghost\" href=\"https://github.com/embeddedos-org/eIPC\" rel=\"noopener noreferrer\" target=\"_blank\">GitHub</a>\n<a class=\"link--ghost\" href=\"documentation.html#eipc\">Docs</a>\n</div>\n</div>\n<div style=\"text-align:right\">\n<div style=\"font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:900;background:linear-gradient(135deg,#34d399,#22d3ee);-webkit-backg