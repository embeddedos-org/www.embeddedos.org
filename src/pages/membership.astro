const rawHead = "<meta content=\"EmbeddedOS Foundation — Membership — EmbeddedOS Foundation. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"@embeddedos\" name=\"twitter:site\"><meta content=\"Membership — EmbeddedOS Foundation\" name=\"twitter:title\"><meta content=\"Join the EmbeddedOS Foundation. Individual, academic, corporate, and partner memberships supporting open-source embedded AI.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/og-image.png\" name=\"twitter:image\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"Join the EmbeddedOS Foundation. Individual, academic, corporate, and partner memberships supporting open-source embedded AI.\" name=\"description\"><title>Membership — EmbeddedOS Foundation</title>\n<meta content=\"Membership — EmbeddedOS Research Foundation\" property=\"og:title\"><meta content=\"Join the EmbeddedOS Foundation. Individual, academic, corporate, and partner memberships supporting open-source embedded AI.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/membership\" rel=\"ca