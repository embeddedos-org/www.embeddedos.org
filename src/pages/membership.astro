const content = "<nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a><span class=\"separator\">›</span><a href=\"contact.html\">Programs</a><span class=\"separator\">›</span><span class=\"current\">Membership</span></nav><main id=\"main-content\"><a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><section class=\"hero\" id=\"main-content-inner\"><div aria-hidden=\"true\" class=\"hero__orb hero__orb--2\"></div>\n<div aria-hidden=\"true\" class=\"hero__orb hero__orb--1\"></div>\n<div aria-hidden=\"true\" class=\"hero__grid\"></div>\n<div aria-hidden=\"true\" class=\"hero__bg\"></div><div class=\"hero-container\"><div class=\"hero-content section-header\"><span class=\"badge badge-blue\">MEMBERSHIP</span><h1 class=\"mt-2\">Join the EmbeddedOS Research Foundation</h1><p>Be part of a global community advancing AI-based operating systems and neural link technology. Members drive open standards, access premium resources, and shape the future of intelligent embedded systems.</p><div class=\"hero-buttons\"><a class=\"btn btn-primary\" href=\"#tiers\">View Membership Tiers</a><a class=\"btn btn-secondary\" href=\"#benefits\">See Benefits</a></div></div></div></section><div class=\"stats-bar\"><div class=\"stats-grid\"><div class=\"stat-item-large\"><div class=\"number\">10K+</div><div class=\"label\">Global Members</div></div><div class=\"stat-item-large\"><div class=\"number\">50+</div><div class=\"label\">Corporate Partners</div></div><div class=\"stat-item-large\"><div class=\"number\">30+</div><div class=\"label\">Countries</div></div><div class=\"stat-item-large\"><div class=\"number\">100%</div><div class=\"label\">Open Governance</div></div></div></div><section class=\"section section-white\" id=\"benefits\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Why Join</span><h2>Membership Benefits</h2><p>Unlock exclusive resources and opportunities to accelerate your career and projects</p></div><div class=\"cards-grid cards-grid-3\"><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"bookGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M8 8C8 6.89543 8.89543 6 10 6H20C21.1046 6 22 6.89543 22 8V40C22 41.1046 21.1046 42 20 42H10C8.89543 42 8 41.1046 8 40V8Z\" fill=\"url(#bookGrad)\"></path><path d=\"M26 8C26 6.89543 26.8954 6 28 6H38C39.1046 6 40 6.89543 40 8V40C40 41.1046 39.1046 42 38 42H28C26.8954 42 26 41.1046 26 40V8Z\" fill=\"url(#bookGrad)\" opacity=\"0.7\"></path><path d=\"M22 10V38\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path><path d=\"M12 14H18M12 20H18M12 26H18\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path><path d=\"M30 14H36M30 20H36\" opacity=\"0.8\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg></div><h3>Premium Resources</h3><p>Access comprehensive documentation, reference implementations, and technical deep-dives not available to the public.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"gradCapGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 6L4 16L24 26L44 16L24 6Z\" fill=\"url(#gradCapGrad)\"></path><path d=\"M10 20V32C10 32 16 38 24 38C32 38 38 32 38 32V20\" fill=\"none\" stroke=\"url(#gradCapGrad)\" stroke-width=\"3\"></path><path d=\"M40 16V34\" stroke=\"url(#gradCapGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><circle cx=\"40\" cy=\"36\" fill=\"url(#gradCapGrad)\" r=\"3\"></circle><path d=\"M24 26V32\" opacity=\"0.6\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg></div><h3>Certification Discounts</h3><p>Receive vouchers and discounted rates on all EmbeddedOS Research Foundation certifications and training programs.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"voteGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#voteGrad)\" height=\"28\" rx=\"4\" width=\"32\" x=\"8\" y=\"14\"></rect><rect fill=\"url(#voteGrad)\" height=\"8\" opacity=\"0.7\" rx=\"2\" width=\"20\" x=\"14\" y=\"6\"></rect><path d=\"M18 6V14\" opacity=\"0.5\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path><path d=\"M30 6V14\" opacity=\"0.5\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path><path d=\"M20 26L23 30L30 22\" stroke=\"white\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"></path></svg></div><h3>Voting Rights</h3><p>Participate in governance decisions, vote on technical standards, and influence the project roadmap.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"micGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#micGrad)\" height=\"24\" rx=\"8\" width=\"16\" x=\"16\" y=\"6\"></rect><path d=\"M10 22C10 22 10 34 24 34C38 34 38 22 38 22\" fill=\"none\" stroke=\"url(#micGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M24 34V42\" stroke=\"url(#micGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M16 42H32\" stroke=\"url(#micGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M20 14H28M20 20H28\" opacity=\"0.6\" stroke=\"white\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg></div><h3>Events Access</h3><p>Early access and discounts to conferences, workshops, and member-exclusive networking events.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"chatGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M6 12C6 9.79086 7.79086 8 10 8H30C32.2091 8 34 9.79086 34 12V26C34 28.2091 32.2091 30 30 30H16L10 38V30H10C7.79086 30 6 28.2091 6 26V12Z\" fill=\"url(#chatGrad)\"></path><path d=\"M38 18H40C42.2091 18 44 19.7909 44 22V36C44 38.2091 42.2091 40 40 40V40V42L36 40H22C19.7909 40 18 38.2091 18 36V32\" fill=\"none\" opacity=\"0.6\" stroke=\"url(#chatGrad)\" stroke-width=\"2\"></path><circle cx=\"14\" cy=\"19\" fill=\"white\" r=\"2\"></circle><circle cx=\"20\" cy=\"19\" fill=\"white\" r=\"2\"></circle><circle cx=\"26\" cy=\"19\" fill=\"white\" r=\"2\"></circle></svg></div><h3>Community Support</h3><p>Priority access to community forums, expert Q&amp;A sessions, and dedicated support channels.</p></div><div class=\"feature-card\"><div class=\"feature-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"48\" viewBox=\"0 0 48 48\" width=\"48\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"rocketGrad\" x1=\"0%\" x2=\"100%\" y1=\"100%\" y2=\"0%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient><linearGradient id=\"flameGrad\" x1=\"0%\" x2=\"0%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 4C24 4 14 14 14 28C14 32 16 36 16 36H32C32 36 34 32 34 28C34 14 24 4 24 4Z\" fill=\"url(#rocketGrad)\"></path><circle cx=\"24\" cy=\"20\" fill=\"white\" r=\"4\"></circle><path d=\"M8 32C8 32 10 26 14 26\" stroke=\"url(#rocketGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M40 32C40 32 38 26 34 26\" stroke=\"url(#rocketGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M20 36L18 44M24 36L24 46M28 36L30 44\" stroke=\"url(#flameGrad)\" stroke-linecap=\"round\" stroke-width=\"3\"></path></svg></div><h3>Early Access</h3><p>Be the first to try new projects, beta features, and experimental technologies before public release.</p></div></div></div></section><section class=\"section section-gray\" id=\"tiers\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Choose Your Plan</span><h2>Membership Tiers</h2><p>Select the membership level that best fits your needs</p></div><div class=\"membership-tiers\"><div class=\"membership-card\"><div class=\"membership-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"56\" viewBox=\"0 0 48 48\" width=\"56\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"indGradCap\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><path d=\"M24 6L4 16L24 26L44 16L24 6Z\" fill=\"url(#indGradCap)\"></path><path d=\"M10 20V32C10 32 16 38 24 38C32 38 38 32 38 32V20\" fill=\"none\" stroke=\"url(#indGradCap)\" stroke-width=\"3\"></path><path d=\"M40 16V34\" stroke=\"url(#indGradCap)\" stroke-linecap=\"round\" stroke-width=\"3\"></path><circle cx=\"40\" cy=\"36\" fill=\"url(#indGradCap)\" r=\"3\"></circle></svg></div><h3>Individual</h3><p>For students and hobbyists</p><div class=\"membership-price\">Free<span>/year</span></div><ul class=\"membership-features\"><li>Access to open-source repositories</li><li>Community forum participation</li><li>Monthly newsletter</li><li>Basic documentation access</li><li>Event notifications</li><li>Public working group access</li></ul><a class=\"btn btn-outline\" href=\"#apply\">Get Started Free</a></div><div class=\"membership-card featured\"><div class=\"membership-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"56\" viewBox=\"0 0 48 48\" width=\"56\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"starGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient><filter height=\"200%\" id=\"starGlow\" width=\"200%\" x=\"-50%\" y=\"-50%\"><feGaussianBlur result=\"blur\" stdDeviation=\"2\"></feGaussianBlur><feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\"></feComposite></filter></defs><path d=\"M24 4L29.5 17.5L44 19L33 29L36 44L24 37L12 44L15 29L4 19L18.5 17.5L24 4Z\" fill=\"url(#starGrad)\" filter=\"url(#starGlow)\"></path><path d=\"M24 12L27 21L36 22L29 28L31 37L24 33L17 37L19 28L12 22L21 21L24 12Z\" fill=\"white\" opacity=\"0.3\"></path></svg></div><h3>Professional</h3><p>For individual professionals</p><div class=\"membership-price\">$299<span>/year</span></div><ul class=\"membership-features\"><li>Everything in Individual</li><li>2 certification exam vouchers</li><li>Premium documentation &amp; guides</li><li>Priority support channels</li><li>Early access to new projects</li><li>Voting rights on standards</li><li>Member badge &amp; profile</li></ul><a class=\"btn btn-primary\" href=\"#apply\">Join Professional</a></div><div class=\"membership-card\"><div class=\"membership-icon\"><svg aria-hidden=\"true\" fill=\"none\" height=\"56\" viewBox=\"0 0 48 48\" width=\"56\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"buildGrad\" x1=\"0%\" x2=\"100%\" y1=\"100%\" y2=\"0%\"><stop offset=\"0%\" style=\"stop-\"></stop><stop offset=\"100%\" style=\"stop-\"></stop></linearGradient></defs><rect fill=\"url(#buildGrad)\" height=\"28\" rx=\"2\" width=\"14\" x=\"8\" y=\"16\"></rect><rect fill=\"url(#buildGrad)\" height=\"36\" rx=\"2\" width=\"14\" x=\"26\" y=\"8\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"11\" y=\"20\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"11\" y=\"28\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"11\" y=\"36\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"29\" y=\"12\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"29\" y=\"20\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"29\" y=\"28\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.8\" rx=\"1\" width=\"4\" x=\"29\" y=\"36\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.5\" rx=\"1\" width=\"2\" x=\"35\" y=\"12\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.5\" rx=\"1\" width=\"2\" x=\"35\" y=\"20\"></rect><rect fill=\"white\" height=\"4\" opacity=\"0.5\" rx=\"1\" width=\"2\" x=\"35\" y=\"28\"></rect></svg></div><h3>Enterprise</h3><p>For organizations</p><div class=\"membership-price\">Custom</div><ul class=\"membership-features\"><li>Everything in Professional</li><li>Unlimited team seats</li><li>Dedicated support engineer</li><li>Custom training programs</li><li>Board advisory opportunities</li><li>Logo on website &amp; events</li><li>Direct influence on roadmap</li></ul><a class=\"btn btn-dark\" href=\"#apply\">Contact Sales</a></div></div></div></section><section class=\"section section-white\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Enterprise Membership</span><h2>Corporate Member Benefits</h2><p>Leading organizations partner with EmbeddedOS Research Foundation</p></div><div class=\"two-col\"><div class=\"two-col-content\"><h3>Strategic Partnership</h3><p>Enterprise members gain strategic influence over the direction of AI operating system standards and neural link security protocols. Your organization will be at the forefront of embedded AI innovation.</p><ul><li>Seat on Technical Advisory Board</li><li>Early input on specification development</li><li>Co-marketing and PR opportunities</li><li>Access to member-exclusive research</li><li>Talent pipeline through internship program</li><li>Custom workshops and training</li></ul><a class=\"btn btn-primary\" href=\"mailto:enterprise@embeddedos.org\">Contact Enterprise Sales</a></div><div class=\"two-col-image\"><div aria-hidden=\"true\" class=\"hero-img-wrap\" style=\"width:100%;border-radius:12px;overflow:hidden\"><svg aria-label=\"enterprise-partnershipmembership\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" viewBox=\"0 0 800 400\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"uns_381cb091\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#0066cc\"></stop><stop offset=\"55%\" stop-color=\"#0099ff\"></stop><stop offset=\"100%\" stop-color=\"#00d4ff\"></stop></linearGradient></defs><rect fill=\"url(#uns_381cb091)\" height=\"400\" width=\"800\"></rect><g fill=\"none\" opacity=\".5\" stroke=\"rgba(255,255,255,.4)\" stroke-width=\"1.5\"><line x1=\"0\" x2=\"0\" y1=\"0\" y2=\"400\"></line><line x1=\"48\" x2=\"48\" y1=\"0\" y2=\"400\"></line><line x1=\"96\" x2=\"96\" y1=\"0\" y2=\"400\"></line><line x1=\"144\" x2=\"144\" y1=\"0\" y2=\"400\"></line><line x1=\"192\" x2=\"192\" y1=\"0\" y2=\"400\"></line><line x1=\"240\" x2=\"240\" y1=\"0\" y2=\"400\"></line><line x1=\"288\" x2=\"288\" y1=\"0\" y2=\"400\"></line><line x1=\"336\" x2=\"336\" y1=\"0\" y2=\"400\"></line><line x1=\"384\" x2=\"384\" y1=\"0\" y2=\"400\"></line><line x1=\"432\" x2=\"432\" y1=\"0\" y2=\"400\"></line><line x1=\"480\" x2=\"480\" y1=\"0\" y2=\"400\"></line><line x1=\"528\" x2=\"528\" y1=\"0\" y2=\"400\"></line><line x1=\"576\" x2=\"576\" y1=\"0\" y2=\"400\"></line><line x1=\"624\" x2=\"624\" y1=\"0\" y2=\"400\"></line><line x1=\"672\" x2=\"672\" y1=\"0\" y2=\"400\"></line><line x1=\"720\" x2=\"720\" y1=\"0\" y2=\"400\"></line><line x1=\"768\" x2=\"768\" y1=\"0\" y2=\"400\"></line><line x1=\"0\" x2=\"800\" y1=\"0\" y2=\"0\"></line><line x1=\"0\" x2=\"800\" y1=\"48\" y2=\"48\"></line><line x1=\"0\" x2=\"800\" y1=\"96\" y2=\"96\"></line><line x1=\"0\" x2=\"800\" y1=\"144\" y2=\"144\"></line><line x1=\"0\" x2=\"800\" y1=\"192\" y2=\"192\"></line><line x1=\"0\" x2=\"800\" y1=\"240\" y2=\"240\"></line><line x1=\"0\" x2=\"800\" y1=\"288\" y2=\"288\"></line><line x1=\"0\" x2=\"800\" y1=\"336\" y2=\"336\"></line><line x1=\"0\" x2=\"800\" y1=\"384\" y2=\"384\"></line></g><text fill=\"rgba(255,255,255,.95)\" font-family=\"Inter,system-ui\" font-size=\"64\" font-weight=\"800\" text-anchor=\"middle\" x=\"400\" y=\"220\">EoS</text><text fill=\"rgba(255,255,255,.6)\" font-family=\"JetBrains Mono,monospace\" font-size=\"14\" letter-spacing=\"3\" text-anchor=\"middle\" x=\"400\" y=\"280\">EMBEDDEDOS</text></svg></div></div></div></div></section><section class=\"section section-gray\" id=\"apply\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Get Started</span><h2>Apply for Membership</h2><p>Join our community today</p></div><div class=\"application-form\"><form action=\"#\" class=\"contact-form\" id=\"contactForm\" method=\"post\"><div class=\"form-group\"><label for=\"member-name\">Full Name *</label><input id=\"member-name\" name=\"name\" placeholder=\"Your full name\" required=\"\" type=\"text\"></div><div class=\"form-group\"><label for=\"member-email\">Email Address *</label><input id=\"member-email\" name=\"email\" placeholder=\"your.email@example.com\" required=\"\" type=\"email\"></div><div class=\"form-group\"><label for=\"member-org\">Organization</label><input id=\"member-org\" name=\"organization\" placeholder=\"Your company or institution\" type=\"text\"></div><div class=\"form-group\"><label for=\"member-tier\">Membership Tier *</label><select id=\"member-tier\" name=\"tier\" required=\"\"><option value=\"\">Select a tier</option><option value=\"individual\">Individual (Free)</option><option value=\"professional\">Professional ($299/year)</option><option value=\"enterprise\">Enterprise (Contact Sales)</option></select></div><div class=\"form-group\"><label for=\"member-interests\">Areas of Interest</label> <textarea id=\"member-interests\" name=\"interests\" placeholder=\"Tell us about your interests in AI OS, neural link, or embedded systems...\"></textarea> </div><button class=\"btn btn-primary\" type=\"submit\">Submit Application</button></form></div></div></section><section class=\"cta-section\"><h2>Questions About Membership?</h2><p>Our team is here to help you find the right membership tier for your needs.</p><div class=\"cta-buttons\"><a class=\"btn btn-dark\" href=\"mailto:membership@embeddedos.org\">Contact Membership Team</a><a class=\"btn btn-secondary\" href=\"documentation.html\">View FAQ</a></div></section><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button></main>";
