const rawHead = "<meta content=\"EmbeddedOS Foundation — eBowser — Embedded HTML5/CSS Engine | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"eBowser is the embedded HTML5/CSS browser engine: small footprint, hardware-accelerated rendering, and EoS app integration. C.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, eBowser, C, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"eBowser — Embedded HTML5/CSS Engine — EmbeddedOS\" property=\"og:title\"><meta content=\"eBowser is the embedded HTML5/CSS browser engine: small footprint, hardware-accelerated rendering, and EoS app integration. C.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-ebowser\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-ebowser\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"eBowser — Embedded HTML5/CSS Engine — EmbeddedOS\" name=\"twitter:title\"><meta content=\"eBowser is the embedded HTML5/CSS browser engine: small footprint, hardware-accelerated rendering, and EoS app integration. C.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>eBowser — Embedded HTML5/CSS Engine | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"eBowser\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"eBowser is the embedded browser engine for EoS — a compact, hardware-accelerated HTML5 / CSS / JS renderer designed for app UIs, kiosk displays, and in-vehicle infotainment, not for the open web.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-ebowser\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"eBowser\", \"item\": \"https://www.embeddedos.org/product-ebowser\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-ebowser.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-ebowser\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>eBowser</span></nav><div class=\"product-hero__visual\"><img alt=\"Browser interface mockup — eBowser\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-ebowser.svg\" width=\"1200\"></div><span class=\"lang-badge lang-c\"><span class=\"dot\"></span>C · v0.1.0</span><h1 id=\"ph-ebowser\">eBowser — Embedded HTML5 / CSS Engine</h1><p class=\"lede\">eBowser is the embedded browser engine for EoS — a compact, hardware-accelerated HTML5 / CSS / JS renderer designed for app UIs, kiosk displays, and in-vehicle infotainment, not for the open web.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/ebowser\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">HTML5</div><div class=\"stat-label\">Modern subset</div></div><div class=\"stat-tile\"><div class=\"stat-num\">CSS3</div><div class=\"stat-label\">Layout + animation</div></div><div class=\"stat-tile\"><div class=\"stat-num\">GPU</div><div class=\"stat-label\">Accelerated</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Small</div><div class=\"stat-label\">&lt; 8 MB binary</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What eBowser is</h2></div><div class=\"prose\"><p>eBowser implements the subset of HTML5 / CSS3 / ES2022 needed to power product UIs — flexbox, grid, media queries, Canvas 2D, WebGL, and a pinned set of DOM APIs — with hardware-accelerated rendering on the EoS HAL.</p><p>It is intentionally not a general-purpose web browser: no plug-ins, no extensions, no script injection — just a fast, predictable engine for shipping UIs.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of eBowser at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>HTML5 + CSS3 + ES2022</h3><p>Modern subset suited to app UIs, dashboards, infotainment, and kiosks.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Hardware-Accelerated Rendering</h3><p>Compositor uses NPU/GPU/DSP through the EoS HAL when available.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Tiny Footprint</h3><p>Engine binary &lt; 8 MB — runs comfortably on Cortex-A SoCs.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Headless Mode</h3><p>Render to a framebuffer or off-screen surface for embedded displays.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>EIPC Native Bindings</h3><p>JS bridge to call EIPC services with capability checks.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Theming Hooks</h3><p>Pulls eos-platform theme tokens automatically.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Touch + Gesture</h3><p>First-class pointer / touch / gesture event model.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Sandbox-Friendly</h3><p>Each instance runs in its own EoS process with a fixed capability set.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Predictable Performance</h3><p>Frame-time budget enforced by the EoS scheduler.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>eBowser is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/ebowser</h3><p>A small, hardware-accelerated HTML5 / CSS engine purpose-built for embedded UIs.</p><div class=\"repo-tags\"><span class=\"repo-tag\">C</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/ebowser\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>eBowser is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"#22d3ee\" height=\"36\" rx=\"8\" stroke=\"#22d3ee\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that eBowser commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eapps.html\"><span class=\"cl-name\">eApps</span><span class=\"cl-blurb\">A curated library of 60+ ready-to-deploy apps for every EoS device class.</span></a><a class=\"cross-link\" href=\"product-eoffice.html\"><span class=\"cl-name\">eOffice</span><span class=\"cl-blurb\">11 office apps — eDocs, eSheets, eSlides, eMail, eDrive — built for embedded.</span></a><a class=\"cross-link\" href=\"product-eos-platform.html\"><span class=\"cl-name\">eos-platform</span><span class=\"cl-blurb\">Five turn-key device profiles on top of EoS: Desktop, TV, Laptop, Tablet, Kiosk.</span></a></div></div></section><section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with eBowser?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/ebowser\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-ebowser-browser\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main>\n<section class=\"section section--alt animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Architecture Overview</h2>\n<div class=\"diagram-wrap\">\n<img alt=\"eBowser architecture diagram\" class=\"arch-diagram\" decoding=\"async\" loading=\"lazy\" src=\"diagrams/diag-ebowser.svg\">\n</div>\n</div>\n</section>\n<section class=\"section animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Technical Specifications</h2>\n<div class=\"specs-table-wrap\">\n<table class=\"specs-table\">\n<thead><tr><th scope=\"col\">Specification</th><th scope=\"col\">Value</th></tr></thead>\n<tbody>\n<tr><td>HTML Version</td><td><code>HTML5 subset</code></td></tr>\n<tr><td>CSS Support</td><td><code>CSS3 + Flexbox + Grid</code></td></tr>\n<tr><td>JavaScript</td><td><code>ES2020 subset (QuickJS)</code></td></tr>\n<tr><td>Rendering Engine</td><td><code>Custom retained-mode compositor</code></td></tr>\n<tr><td>RAM Usage</td><td><code>512 KB – 4 MB</code></td></tr>\n<tr><td>Flash Usage</td><td><code>2–8 MB</code></td></tr>\n<tr><td>Display Targets</td><td><code>TFT, OLED, e-ink, LVGL</code></td></tr>\n<tr><td>Network</td><td><code>HTTP/1.1 + HTTPS via mbedTLS</code></td></tr>\n<tr><td>Fonts</td><td><code>TrueType subset, bitmap fallback</code></td></tr>\n<tr><td>License</td><td><code>MIT</code></td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section class=\"section section--alt animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Quick Start</h2>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\">\n<span class=\"code-lang\">C / YAML</span>\n<button class=\"code-block__copy btn-ghost\" type=\"button\">Copy</button>\n</div>\n<pre class=\"code-block\"><code>/* Render an HTML page with eBowser */\n#include <ebowser browser.h=\"\">\n\nstatic const char page[] =\n    \"\"\n    \"<h2>Hello EoS!</h2>\"\n    \"<p>Running on eBowser v0.1</p>\"\n    \"\n\";\n\nint main(void) {\n    ebowser_init(&amp;display_cfg);\n    ebowser_load_html(page, sizeof(page));\n    return eos_run();\n}</ebowser></code></pre>\n</div>\n</div>\n</section>\n<section class=\"section animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Use Cases</h2>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<h3>HMI Panels</h3>\n<p>Industrial HMI built with HTML/CSS on bare metal</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Web Dashboards</h3>\n<p>Local web dashboards without a full Linux stack</p>\n</div>\n<div class=\"usecase-card\">\n<h3>E-ink Displays</h3>\n<p>Low-power e-ink rendering with CSS layout</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Kiosk UIs</h3>\n<p>Touch-enabled kiosk interfaces</p>\n</div>\n<div class=\"usecase-card\">\n<h3>OTA Web UI</h3>\n<p>Embedded web interface for firmware updates</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Debug Console</h3>\n<p>Browser-based serial/JTAG debug console</p>\n</div>\n</div>\n</div>\n</section><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
