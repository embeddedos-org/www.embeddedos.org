S\" property=\"article:tag\"><meta content=\"Open Source\" property=\"article:tag\"><meta content=\"https://www.embeddedos.org/article-eni-1024-channel-pipeline\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"ENI's 1,024-channel pipeline: deterministic spike sorting in 800 µs — EmbeddedOS\" name=\"twitter:title\"><meta content=\"How the Embedded Neural Interface stack moves a thousand-electrode array through filtering, sorting, and decoding inside a single RTOS frame — and why the hardest part wasn't the math.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><link href=\"https://www.embeddedos.org/article-eni-1024-channel-pipeline\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><title>ENI 1,024-Channel Spike Sorting Pipeline | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n{\n    \"@context\": \"https://schema.org\",\n    \"@graph\": [\n        {\n            \"@type\": \"Article\",\n            \"headline\": \"ENI's 1,024-channel pipeline: deterministic spike sorting in 800 \\u00b5s\",\n            \"description\": \"How the Embedded Neural Interface stack moves a thousand-electrode array through filtering, sorting, and decoding inside a single RTOS frame \\u2014 and why the hardest part wasn't the math.\",\n            \"datePublished\": \"2026-05-08\",\n            \"dateModified\": \"2026-05-08\",\n            \"author\": {\n                \"@type\": \"Organization\",\n                \"name\": \"EoS Editorial\"\n            },\n            \"publisher\": {\n                \"@type\": \"Organization\",\n                \"name\": \"EmbeddedOS Research Foundation\",\n                \"logo\": {\n                    \"@type\": \"ImageObject\",\n                    \"url\": \"https://www.embeddedos.org/img/logo.svg\"\n                }\n            },\n            \"mainEntityOfPage\": \"https://www.embeddedos.org/article-eni-1024-channel-pipeline\",\n            \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n            \"articleSection\": \"Neural Interface\",\n            \"url\": \"https://www.embeddedos.org/article-eni-1024-channel-pipeline\"\n        },\n        {\n            \"@type\": \"BreadcrumbList\",\n            \"itemListElement\": [\n                {\n                    \"@type\": \"ListItem\",\n                    \"position\": 1,\n                    \"name\": \"Home\",\n                    \"item\": \"https://www.embeddedos.org/\"\n                },\n                {\n                    \"@type\": \"ListItem\",\n                    \"position\": 2,\n                    \"name\": \"News\",\n                    \"item\": \"https://www.embeddedos.org/news\"\n                },\n                {\n                    \"@type\": \"ListItem\",\n                    \"position\": 3,\n                    \"name\": \"ENI's 1,024-channel pipeline: deterministic spike sorting in 800 \\u00b5s\",\n                    \"item\": \"https://www.embeddedos.org/article-eni-1024-channel-pipeline\"\n                }\n            ]\n        }\n    ]\n}\n    </script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://www.embeddedos.org/article-eni-1024-channel-pipeline#webpage\",\"url\":\"https://www.embeddedos.org/article-eni-1024-channel-pipeline\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\".article-hero__title\",\".article-hero__dek\",\".prose p:first-of-type\"]},\"isPartOf\":{\"@id\":\"https://www.embeddedos.org/#website\"}}</script> <link href=\"https://www.embeddedos.org/article-eni-1024-channel-pipeline.html\" rel=\"canonica