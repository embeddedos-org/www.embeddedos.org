const rawHead = "<meta content=\"EmbeddedOS Foundation — eBootloader — Multi-Architecture Bootloader | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"eBootloader is a portable, secure embedded bootloader: 24 boards, 10 architectures, A/B slot updates, signed images, and fast boot. C11.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, eBootloader, C11, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"eBootloader — Multi-Architecture Bootloader — EmbeddedOS\" property=\"og:title\"><meta content=\"eBootloader is a portable, secure embedded bootloader: 24 boards, 10 architectures, A/B slot updates, signed images, and fast boot. C11.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-eboot\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-eboot\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"eBootloader — Multi-Architecture Bootloader — EmbeddedOS\" name=\"twitter:title\"><meta content=\"eBootloader is a portable, secure embedded bootloader: 24 boards, 10 architectures, A/B slot updates, signed images, and fast boot. C11.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>eBootloader — Multi-Architecture Bootloader | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"eBootloader\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"eBootloader is the boot stage of the EoS stack — a portable, signed, A/B-slotted bootloader that already supports 24 reference boards across 10 instruction-set architectures and degrades gracefully under power loss or corrupt updates.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-eboot\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"eBootloader\", \"item\": \"https://www.embeddedos.org/product-eboot\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-eboot.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-eboot\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>eBootloader</span></nav><div class=\"product-hero__visual\"><img alt=\"Secure padlock circuit — eBootloader\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-eboot.svg\" width=\"1200\"></div><span class=\"lang-badge lang-c\"><span class=\"dot\"></span>C11 · v0.1.0</span><h1 id=\"ph-eboot\">eBootloader — Multi-Architecture Bootloader</h1><p class=\"lede\">eBootloader is the boot stage of the EoS stack — a portable, signed, A/B-slotted bootloader that already supports 24 reference boards across 10 instruction-set architectures and degrades gracefully under power loss or corrupt updates.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/eboot\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">24</div><div class=\"stat-label\">Supported boards</div></div><div class=\"stat-tile\"><div class=\"stat-num\">10</div><div class=\"stat-label\">Architectures</div></div><div class=\"stat-tile\"><div class=\"stat-num\">A/B</div><div class=\"stat-label\">Update slots</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Signed</div><div class=\"stat-label\">Secure boot</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What eBootloader is</h2></div><div class=\"prose\"><p>eBootloader handles everything between reset and kernel hand-off: chain-of-trust verification, A/B slot selection, recovery fallback, network boot, and device-tree fixup. It speaks the same configuration model on every supported architecture, so porting a board takes hours, not weeks.</p><p>Robustness is the point: any failed update rolls back automatically; any corrupt slot triggers recovery; any tampering breaks the signature and refuses to boot.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of eBootloader at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>10 Architectures</h3><p>ARMv7-M, ARMv8-A, RISC-V (RV32, RV64), x86_64, AArch64, MIPS, PowerPC, Xtensa, AVR.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>24 Reference Boards</h3><p>STM32, NXP i.MX, Raspberry Pi, BeagleBone, ESP32, RISC-V SiFive, NVIDIA Jetson, and more.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>A/B Update Slots</h3><p>Two firmware slots with automatic fallback if a new image fails to mark itself healthy.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Signed Images</h3><p>Ed25519 / ECDSA signature verification rooted in immutable boot ROM.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Encrypted Updates</h3><p>Optional AES-GCM payload encryption for over-the-air delivery.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Recovery Mode</h3><p>Standalone recovery slot with USB / UART / TFTP firmware upload.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Fast Boot</h3><p>Sub-second cold boot on Cortex-M, sub-3-second on Cortex-A SoCs.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Device-Tree Patcher</h3><p>Run-time DTB overlays for board variants without re-flashing the bootloader.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Watchdog Hand-Off</h3><p>Hard watchdog armed before kernel runs; rolls back if kernel doesn't check in.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>eBootloader is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/eboot</h3><p>Portable, secure, fail-safe boot for 24 boards across 10 architectures.</p><div class=\"repo-tags\"><span class=\"repo-tag\">C11</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/eboot\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>eBootloader is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"#94a3b8\" height=\"36\" rx=\"8\" stroke=\"#94a3b8\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that eBootloader commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eos.html\"><span class=\"cl-name\">EoS</span><span class=\"cl-blurb\">The foundation: a deterministic real-time embedded OS for everything from the bootloader up.</span></a><a class=\"cross-link\" href=\"product-ebuild.html\"><span class=\"cl-name\">eBuild</span><span class=\"cl-blurb\">One CLI to configure, build, package, and ship EoS firmware to any of 14 targets.</span></a><a class=\"cross-link\" href=\"product-eipc.html\"><span class=\"cl-name\">EIPC</span><span class=\"cl-blurb\">Capability-secured IPC fabric: predictable latency, HMAC-authenticated messages.</span></a></div></div></section><section aria-labelledby=\"arch-diag\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Architecture</span>\n<h2 id=\"arch-diag\">eBootloader Secure Boot Chain</h2>\n<p>The five-stage chain of trust from immutable ROM through BL1, BL2, verified firmware, and application, with ECDSA-256 signature verification and anti-rollback counters at each stage.</p>\n</div>\n<div class=\"diagram-wrap\">\n<img alt=\"eBootloader Secure Boot Chain\" class=\"arch-diagram\" height=\"520\" loading=\"lazy\" src=\"img/diagrams/diag-eboot.svg\" width=\"860\">\n</div>\n</div>\n</section>\n<section aria-labelledby=\"specs-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Technical Specifications</span>\n<h2 id=\"specs-h\">eBootloader at a Glance</h2>\n</div>\n<div class=\"specs-table-wrap\">\n<table aria-label=\"eBootloader at a Glance\" class=\"specs-table\"><thead><tr><th scope=\"row\">Signature Algorithm</th><td>ECDSA-256 (NIST P-256 curve)</td></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Hash Function</th><td>SHA-256</td></tr>\n<tr><th scope=\"row\">Encryption</th><td>AES-256-GCM for encrypted firmware images</td></tr>\n<tr><th scope=\"row\">Anti-Rollback</th><td>Monotonic counter in OTP / eFuse; configurable policy</td></tr>\n<tr><th scope=\"row\">Supported Architectures</th><td>ARM Cortex-M/A/R, RISC-V RV32/RV64, x86 (UEFI), MIPS, ARC, Xtensa, MIPS, ARC</td></tr>\n<tr><th scope=\"row\">Footprint</th><td>&lt; 32 KB flash (BL1 + BL2 combined)</td></tr>\n<tr><th scope=\"row\">Boot Time</th><td>&lt; 50 ms from power-on to kernel handoff on Cortex-M4 @ 168 MHz</td></tr>\n<tr><th scope=\"row\">Hardware Trust Anchors</th><td>TPM 2.0, ARM TrustZone, RISC-V PMP, eFuse / OTP</td></tr>\n<tr><th scope=\"row\">Firmware Update</th><td>OTA-ready; dual-bank A/B update with atomic swap</td></tr>\n<tr><th scope=\"row\">Debug Interface</th><td>JTAG/SWD lock-out in production mode; debug unlock via signed token</td></tr>\n<tr><th scope=\"row\">License</th><td>MIT — commercial use permitted without royalty</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"code-h\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Quick Start</span>\n<h2 id=\"code-h\">Signing a Firmware Image</h2>\n</div>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\"><span class=\"code-lang\">Shell</span><span class=\"code-copy-hint\">Quick Start</span></div>\n<pre class=\"code-block\"><code># 1. Generate a signing key pair (one-time setup)\nebuild keygen --algo ecdsa256 --out keys/signing_key\n\n# 2. Build the firmware\nebuild build --profile cortex-m4-generic --out build/firmware.elf\n\n# 3. Sign the firmware image\neboot sign \\\n  --input  build/firmware.elf \\\n  --key    keys/signing_key.pem \\\n  --output build/firmware.signed.bin \\\n  --version 3                      # anti-rollback version\n\n# 4. Verify the signature locally\neboot verify \\\n  --input  build/firmware.signed.bin \\\n  --pubkey keys/signing_key_pub.pem\n\n# 5. Flash to target\nebuild flash --image build/firmware.signed.bin --profile cortex-m4-generic</code></pre>\n<p class=\"code-note\">The bootloader public key is provisioned into OTP/eFuse at manufacturing time.</p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"usecases-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Applications</span>\n<h2 id=\"usecases-h\">Where eBootloader Is Used</h2>\n</div>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🔒</div>\n<h3>Secure Firmware Updates</h3>\n<p>OTA firmware updates with cryptographic verification prevent malicious firmware injection across the entire device fleet.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏭</div>\n<h3>Manufacturing Provisioning</h3>\n<p>Automated key injection and certificate provisioning at the factory floor using eBootloader's signing toolchain.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🚗</div>\n<h3>Automotive Secure Boot</h3>\n<p>Meets ISO 21434 cybersecurity requirements for ECU firmware integrity in connected vehicles.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏥</div>\n<h3>Medical Device Security</h3>\n<p>FDA pre-market cybersecurity guidance compliance through verified boot and anti-rollback protection.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🛰️</div>\n<h3>Satellite Payloads</h3>\n<p>Radiation-tolerant secure boot for space-grade processors with ECDSA verification and redundant boot paths.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🌐</div>\n<h3>Industrial IoT</h3>\n<p>Prevents unauthorized firmware on field devices; supports remote attestation for IEC 62443 compliance.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with eBootloader?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/eboot\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-eboot-chain\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
