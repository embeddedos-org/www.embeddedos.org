const rawHead = "<meta content=\"EmbeddedOS Foundation — eApps — 60+ First-Party Embedded Applications | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"eApps is the curated EoS application suite: 60+ first-party apps including media, productivity, devtools, communications, and system utilities.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, eApps, Multi (C / Python / TS / Dart), embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"eApps — 60+ Embedded Applications — EmbeddedOS\" property=\"og:title\"><meta content=\"eApps is the curated EoS application suite: 60+ first-party apps including media, productivity, devtools, communications, and system utilities.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-eapps\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-eapps\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"eApps — 60+ Embedded Applications — EmbeddedOS\" name=\"twitter:title\"><meta content=\"eApps is the curated EoS application suite: 60+ first-party apps including media, productivity, devtools, communications, and system utilities.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>eApps — 60+ First-Party Embedded Applications | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"eApps\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"eApps is the EoS first-party application catalog — over 60 production-ready apps spanning media, productivity, communications, devtools, and system utilities, each packaged for one-command install across every eos-platform profile.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-eapps\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"eApps\", \"item\": \"https://www.embeddedos.org/product-eapps\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-eapps.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-eapps\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>eApps</span></nav><div class=\"product-hero__visual\"><img alt=\"App grid display — eApps\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-eapps.svg\" width=\"1200\"></div><span class=\"lang-badge lang-multi\"><span class=\"dot\"></span>Multi (C / Python / TS / Dart) · v0.2.0</span><h1 id=\"ph-eapps\">eApps — 60+ First-Party Embedded Applications</h1><p class=\"lede\">eApps is the EoS first-party application catalog — over 60 production-ready apps spanning media, productivity, communications, devtools, and system utilities, each packaged for one-command install across every eos-platform profile.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/eApps\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">60+</div><div class=\"stat-label\">First-party apps</div></div><div class=\"stat-tile\"><div class=\"stat-num\">5</div><div class=\"stat-label\">Categories</div></div><div class=\"stat-tile\"><div class=\"stat-num\">All</div><div class=\"stat-label\">Form factors</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Open</div><div class=\"stat-label\">Source</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What eApps is</h2></div><div class=\"prose\"><p>Where most embedded platforms ship with an empty desktop and a long shopping list, EoS ships with a curated, integration-tested app library: media players, document editors, IDEs, browsers, mail clients, file managers, system monitors, settings panels, and more — all built against the same EoS / EIPC / EAI surface.</p><p>Apps are signed, sandboxed, and delivered through the App Store — install or update with one CLI command or a tap.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of eApps at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Media Suite</h3><p>Audio player, video player, photo viewer, podcast / radio, screen recorder.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Productivity</h3><p>Notes, calendar, file manager, task tracker, calculator — all integrated with eDB.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Communications</h3><p>Mail, chat, video conferencing, contacts — capability-gated through EIPC.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Developer Tools</h3><p>Terminal, code editor, REST inspector, log viewer, system monitor.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Settings &amp; System</h3><p>Settings panel, network manager, user / permission editor, update manager.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Sandboxed by Default</h3><p>Each app runs under a capability profile — explicit grants for filesystem, network, sensors.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Signed Distribution</h3><p>All first-party apps signed by the Foundation; signatures verified by eBuild and eApps.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>App Store CLI &amp; UI</h3><p>`eapps install`, `eapps update`, or browse via the embedded App Store front-end.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Themable</h3><p>All apps respect the eos-platform profile theme and dark/light mode.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>eApps is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/eApps</h3><p>A curated library of 60+ ready-to-deploy apps for every EoS device class.</p><div class=\"repo-tags\"><span class=\"repo-tag\">Multi (C / Python / TS / Dart)</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.2.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/eApps\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>eApps is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"#a78bfa\" height=\"36\" rx=\"8\" stroke=\"#a78bfa\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that eApps commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eoffice.html\"><span class=\"cl-name\">eOffice</span><span class=\"cl-blurb\">11 office apps — eDocs, eSheets, eSlides, eMail, eDrive — built for embedded.</span></a><a class=\"cross-link\" href=\"product-eserviceapps.html\"><span class=\"cl-name\">eServiceApps</span><span class=\"cl-blurb\">Consumer service apps for connected devices: eSocial, eRide, eTravel, eTrack, eWallet.</span></a><a class=\"cross-link\" href=\"product-eos-platform.html\"><span class=\"cl-name\">eos-platform</span><span class=\"cl-blurb\">Five turn-key device profiles on top of EoS: Desktop, TV, Laptop, Tablet, Kiosk.</span></a></div></div></section><section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with eApps?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/eApps\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-eapps-apps\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main>\n<section class=\"section section--alt animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Architecture Overview</h2>\n<div class=\"diagram-wrap\">\n<img alt=\"eApps architecture diagram\" class=\"arch-diagram\" decoding=\"async\" loading=\"lazy\" src=\"diagrams/diag-eapps.svg\">\n</div>\n</div>\n</section>\n<section class=\"section animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Technical Specifications</h2>\n<div class=\"specs-table-wrap\">\n<table class=\"specs-table\">\n<thead><tr><th scope=\"col\">Specification</th><th scope=\"col\">Value</th></tr></thead>\n<tbody>\n<tr><td>Application Count</td><td><code>60+ apps</code></td></tr>\n<tr><td>Runtime</td><td><code>EoS v0.1+</code></td></tr>\n<tr><td>UI Framework</td><td><code>eUI 2.0</code></td></tr>\n<tr><td>Memory Footprint</td><td><code>8–256 KB per app</code></td></tr>\n<tr><td>Storage</td><td><code>16 KB – 2 MB per app</code></td></tr>\n<tr><td>IPC Protocol</td><td><code>eIPC capability tokens</code></td></tr>\n<tr><td>Sandboxing</td><td><code>Per-app capability isolation</code></td></tr>\n<tr><td>Update Mechanism</td><td><code>OTA delta patches</code></td></tr>\n<tr><td>License</td><td><code>MIT / Apache 2.0</code></td></tr>\n<tr><td>Target Boards</td><td><code>ARM Cortex-M/A, RISC-V</code></td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section class=\"section section--alt animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Quick Start</h2>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\">\n<span class=\"code-lang\">C / YAML</span>\n<button class=\"code-block__copy btn-ghost\" type=\"button\">Copy</button>\n</div>\n<pre class=\"code-block\"><code>/* Launch an eApp from EoS shell */\n#include <eos apps.h=\"\">\n\nint main(void) {\n    eapp_handle_t h = eapp_launch(\"system-monitor\", 0);\n    if (!h) { eos_panic(\"app launch failed\"); }\n\n    /* Subscribe to app lifecycle events */\n    eapp_on_exit(h, app_exit_cb, NULL);\n    return eos_run();\n}</eos></code></pre>\n</div>\n</div>\n</section>\n<section class=\"section animate-on-scroll\">\n<div class=\"container\">\n<h2 class=\"section-title\">Use Cases</h2>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<h3>IoT Dashboards</h3>\n<p>Real-time sensor dashboards with eUI widgets</p>\n</div>\n<div class=\"usecase-card\">\n<h3>System Monitor</h3>\n<p>CPU, memory, task scheduler live view</p>\n</div>\n<div class=\"usecase-card\">\n<h3>File Manager</h3>\n<p>Flash/SD card file browser with eDB backend</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Network Config</h3>\n<p>Wi-Fi/BT pairing and IP configuration UI</p>\n</div>\n<div class=\"usecase-card\">\n<h3>OTA Manager</h3>\n<p>Firmware update orchestration and rollback</p>\n</div>\n<div class=\"usecase-card\">\n<h3>Diagnostics</h3>\n<p>Hardware self-test and fault logging</p>\n</div>\n</div>\n</div>\n</section><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
