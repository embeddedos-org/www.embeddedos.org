---
import Base from "../layouts/Base.astro";
const rawHead = "<title>Vision | EmbeddedOS</title>\n  <meta name=\"description\" content=\"EmbeddedOS foundation vision and long-term roadmap for open standards, programs, and impact.\">";
const content = "<a href=\"#main-content\" class=\"skip-to-content\">Skip to content</a>\n\n\n<section class=\"hero\" id=\"main-content\" role=\"main\">\n  <div class=\"hero-content\">\n    <div class=\"hero-text\">\n      <h1>Vision</h1>\n      <p class=\"subtitle\">Build a durable open-source foundation where standards, research, policy, and community programs scale together.</p>\n      <div class=\"hero-buttons\">\n        <a href=\"roadmap.html\" class=\"btn btn-primary\">Roadmap</a>\n        <a href=\"organization.html\" class=\"btn btn-secondary\">Organization</a>\n        <a href=\"donate.html\" class=\"btn btn-outline\">Support Mission</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\">\n  <h2 class=\"section-title\">Strategic Priorities</h2>\n  <div class=\"product-grid\">\n    <div class=\"product-card\"><h3>Open Standards</h3><p>Define interoperable standards and public reference implementations.</p></div>\n    <div class=\"product-card\"><h3>Research Excellence</h3><p>Publish measurable, reproducible research with strong documentation.</p></div>\n    <div class=\"product-card\"><h3>Accessible Education</h3><p>Create beginner-to-advanced educational tracks for broad onboarding.</p></div>\n    <div class=\"product-card\"><h3>Policy and Trust</h3><p>Communicate clearly on digital rights, safety, and responsible technology.</p></div>\n  </div>\n</section>\n\n<section class=\"section-full section-alt\">\n  <div class=\"section\">\n    <h2 class=\"section-title\">Action Paths</h2>\n    <div class=\"product-grid\">\n      <div class=\"product-card\"><h3>Join Community</h3><p>Become a member or volunteer.</p><a href=\"membership.html\" class=\"btn btn-sm btn-primary\">Join</a></div>\n      <div class=\"product-card\"><h3>Build With Us</h3><p>Contribute to products and ecosystem projects.</p><a href=\"projects.html\" class=\"btn btn-sm btn-primary\">Contribute</a></div>\n      <div class=\"product-card\"><h3>Support the Mission</h3><p>Donate or sponsor open-source work.</p><a href=\"donate.html\" class=\"btn btn-sm btn-primary\">Donate</a></div>\n    </div>\n  </div>\n</section>";
---
<Base lang="en" legacy={true} cssHref="/style.css" bodyClass="" rawHead={rawHead}>
<Fragment set:html={content} />

</Base>
