import Base from "../layouts/Base.astro";
const rawHead = "<meta content=\"EmbeddedOS Foundation — EoSim — Embedded Systems Simulator | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"EoSim is the EoS simulator: 52+ platforms, QEMU + Renode + HIL bridges, scriptable scenarios, and CI integration. Python.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, EoSim, Python, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"EoSim — Embedded Systems Simulator — EmbeddedOS\" property=\"og:title\"><meta content=\"EoSim is the EoS simulator: 52+ platforms, QEMU + Renode + HIL bridges, scriptable scenarios, and CI integration. Python.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-eosim\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-eosim\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"EoSim — Embedded Systems Simulator — EmbeddedOS\" name=\"twitter:title\"><meta content=\"EoSim is the EoS simulator: 52+ platforms, QEMU + Renode + HIL bridges, scriptable scenarios, and CI integration. Python.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>EoSim — Embedded Systems Simulator | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"EoSim\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"EoSim is the EoS simulator — a unified harness over QEMU, Renode, and a hardware-in-the-loop bridge that lets you boot, debug, and CI-test EoS firmware against 52+ virtual platforms without touching real silicon.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-eosim\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"EoSim\", \"item\": \"https://www.embeddedos.org/product-eosim\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-eosim.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-eosim\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>EoSim</span></nav><div class=\"product-hero__visual\"><img alt=\"Terminal and oscilloscope — EoSim\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-eosim.svg\" width=\"1200\"></div><span class=\"lang-badge lang-py\"><span class=\"dot\"></span>Python · v0.1.0</span><h1 id=\"ph-eosim\">EoSim — Embedded Systems Simulator</h1><p class=\"lede\">EoSim is the EoS simulator — a unified harness over QEMU, Renode, and a hardware-in-the-loop bridge that lets you boot, debug, and CI-test EoS firmware against 52+ virtual platforms without touching real silicon.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/eosim\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">52+</div><div class=\"stat-label\">Virtual platforms</div></div><div class=\"stat-tile\"><div class=\"stat-num\">QEMU</div><div class=\"stat-label\">Full-system emu</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Renode</div><div class=\"stat-label\">Multi-MCU</div></div><div class=\"stat-tile\"><div class=\"stat-num\">HIL</div><div class=\"stat-label\">Real-hardware bridge</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What EoSim is</h2></div><div class=\"prose\"><p>EoSim wraps QEMU and Renode behind a single Python API and CLI: pick a platform, hand it an EoS firmware image, and you get an inspectable virtual board with simulated peripherals, a GDB stub, and scriptable scenarios.</p><p>For tests that demand real hardware, the HIL bridge proxies the same API onto attached reference boards — so the same scenario runs in CI on a virtual STM32 and on a physical board on an engineer's desk.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of EoSim at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>52+ Virtual Platforms</h3><p>STM32 family, NXP i.MX, ESP32, RISC-V SiFive, ARM Cortex-A SoCs, x86_64 servers, and more.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>QEMU + Renode + HIL</h3><p>Three execution backends behind one API; switch with a flag.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Scriptable Scenarios</h3><p>Drive peripherals, inject faults, advance time — all in Python.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>GDB &amp; Trace Hooks</h3><p>Built-in GDB stub, full instruction trace, and EoS kernel-aware introspection.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>CI Integration</h3><p>Runs in GitHub Actions / GitLab / Jenkins; produces JUnit-format results.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Fault Injection</h3><p>Bit-flip, brown-out, broken-peripheral scenarios for resilience tests.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Multi-Node</h3><p>Networks of simulated boards share a virtual bus / Ethernet / Wi-Fi.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Benchmarks</h3><p>Same harness drives perf / power benchmarks — exports to CSV and Plotly.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Hardware-in-the-Loop</h3><p>Same scenarios run on physical reference boards via the HIL bridge.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>EoSim is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/eosim</h3><p>Simulate, fuzz, and CI-test EoS firmware against 52+ virtual platforms.</p><div class=\"repo-tags\"><span class=\"repo-tag\">Python</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/eosim\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>EoSim is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"#67e8f9\" height=\"36\" rx=\"8\" stroke=\"#67e8f9\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that EoSim commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-ebuild.html\"><span class=\"cl-name\">eBuild</span><span class=\"cl-blurb\">One CLI to configure, build, package, and ship EoS firmware to any of 14 targets.</span></a><a class=\"cross-link\" href=\"product-eostudio.html\"><span class=\"cl-name\">EoStudio</span><span class=\"cl-blurb\">An IDE built for EoS: 12 editors, 30+ generators, simulator-aware debugging.</span></a><a class=\"cross-link\" href=\"product-eos.html\"><span class=\"cl-name\">EoS</span><span class=\"cl-blurb\">The foundation: a deterministic real-time embedded OS for everything from the bootloader up.</span></a></div></div></section><section aria-labelledby=\"arch-diag\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Architecture</span>\n<h2 id=\"arch-diag\">EoSim Simulator Architecture</h2>\n<p>The virtual world (QEMU backend, virtual peripherals, GDB remote debugger, coverage tracing, fault injection) connected to the real hardware world through the HIL bridge with sub-microsecond latency.</p>\n</div>\n<div class=\"diagram-wrap\">\n<img alt=\"EoSim Simulator Architecture\" class=\"arch-diagram\" height=\"520\" loading=\"lazy\" src=\"img/diagrams/diag-eosim.svg\" width=\"860\">\n</div>\n</div>\n</section>\n<section aria-labelledby=\"specs-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Technical Specifications</span>\n<h2 id=\"specs-h\">EoSim at a Glance</h2>\n</div>\n<div class=\"specs-table-wrap\">\n<table aria-label=\"EoSim at a Glance\" class=\"specs-table\"><thead><tr><th scope=\"row\">Simulation Backend</th><td>QEMU 8.x with EoS-specific machine models</td></tr></thead>\n<tbody>\n<tr><th scope=\"row\">HIL Bridge Latency</th><td>&lt; 1 µs virtual-to-real peripheral round-trip</td></tr>\n<tr><th scope=\"row\">Simulated Peripherals</th><td>16 peripheral types: UART, SPI, I²C, GPIO, CAN, USB, ETH, ADC, PWM, Timer, DMA, RTC, Flash, SDIO, QSPI, LCD</td></tr>\n<tr><th scope=\"row\">Debug Interface</th><td>GDB remote protocol (port 1234); RTOS-aware thread list and register views</td></tr>\n<tr><th scope=\"row\">Coverage Tracing</th><td>Basic block coverage with LCOV output; branch coverage in instrumented builds</td></tr>\n<tr><th scope=\"row\">Fault Injection</th><td>Bit-flip injection, peripheral timeout simulation, power-loss scenarios</td></tr>\n<tr><th scope=\"row\">Cycle Accuracy</th><td>Instruction-accurate timing for Cortex-M and RISC-V targets</td></tr>\n<tr><th scope=\"row\">Supported Architectures</th><td>ARM Cortex-M0/M0+/M3/M4/M7/M23/M33/M55/M85, RISC-V RV32/RV64, x86-64</td></tr>\n<tr><th scope=\"row\">Host Platforms</th><td>Linux (x86-64, ARM64), macOS (Apple Silicon), Windows (WSL2)</td></tr>\n<tr><th scope=\"row\">EoStudio Integration</th><td>One-click launch from EoStudio IDE with automatic GDB attachment</td></tr>\n<tr><th scope=\"row\">License</th><td>MIT — commercial use permitted without royalty</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"code-h\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Quick Start</span>\n<h2 id=\"code-h\">Running EoS in the Simulator</h2>\n</div>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\"><span class=\"code-lang\">Shell</span><span class=\"code-copy-hint\">Quick Start</span></div>\n<pre class=\"code-block\"><code># 1. Build for the virtual Cortex-M4 target\nebuild build --profile cortex-m4-qemu\n\n# 2. Launch EoSim (opens QEMU + GDB server on :1234)\neosim run build/firmware.elf --profile cortex-m4-qemu\n\n# 3. In another terminal: connect GDB\narm-none-eabi-gdb build/firmware.elf \\\n  -ex \"target remote :1234\" \\\n  -ex \"monitor reset halt\" \\\n  -ex \"continue\"\n\n# 4. Run with fault injection (simulate flash write failure)\neosim run build/firmware.elf \\\n  --fault flash_write_error:0x08010000:50%\n\n# 5. Collect coverage report\neosim run build/firmware.elf --coverage\neosim coverage-report --format lcov --output coverage/\n\n# 6. HIL mode: bridge virtual UART to real hardware\neosim run build/firmware.elf \\\n  --hil uart0:/dev/ttyUSB0:115200</code></pre>\n<p class=\"code-note\">EoSim requires QEMU 8.x. Install with: <code>ebuild install-deps --sim</code></p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"usecases-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Applications</span>\n<h2 id=\"usecases-h\">Where EoSim Is Used</h2>\n</div>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🧪</div>\n<h3>Hardware-Free Development</h3>\n<p>Develop and test firmware before hardware is available, enabling parallel hardware and software development tracks.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🔄</div>\n<h3>CI/CD Regression Testing</h3>\n<p>Run the full firmware test suite in QEMU on every commit — no physical hardware required in the CI pipeline.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">💥</div>\n<h3>Fault Injection Testing</h3>\n<p>Simulate power loss, flash corruption, and peripheral failures to validate error-handling and recovery code paths.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">📊</div>\n<h3>Coverage Analysis</h3>\n<p>Achieve &gt; 90% branch coverage on embedded firmware using EoSim's instrumented execution mode.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🔌</div>\n<h3>HIL Testing</h3>\n<p>Bridge simulated firmware to real sensors and actuators through the HIL interface for mixed virtual/physical testing.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🎓</div>\n<h3>Education &amp; Training</h3>\n<p>University embedded systems courses use EoSim to teach RTOS concepts without requiring physical development boards.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with EoSim?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/eosim\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-eosim-sim\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
