---
import Base from "../layouts/Base.astro";
const rawHead = "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.github.com; base-uri 'self'; form-action 'self'\">\n    <meta http-equiv=\"X-Content-Type-Options\" content=\"nosniff\">\n    <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\n\n<link rel=\"apple-touch-icon\" href=\"/og-image.png\">\n\n<title>EmbeddedOS Press — Book Library</title>\n<meta name=\"description\" content=\"Official reference books for the EmbeddedOS ecosystem. 14 professional technical guides covering RTOS, bootloaders, AI, databases, browsers, and more.\">\n<meta property=\"og:title\" content=\"EmbeddedOS Press — Book Library\">\n<meta property=\"og:description\" content=\"14 professional technical guides for the EmbeddedOS ecosystem. Free PDF downloads.\">\n<meta property=\"og:url\" content=\"https://www.embeddedos.org/books.html\">\n<meta property=\"og:image\" content=\"https://www.embeddedos.org/og-image.png\">\n<link rel=\"canonical\" href=\"https://www.embeddedos.org/books.html\">\n\n\n\n\n<style>\n/* ═══ Books Page Styles ═══ */\n.books-hero {\n  background: linear-gradient(135deg, #0d1117 0%, #1a1040 40%, #0d2818 70%, #0d1117 100%);\n  padding: 5rem 2rem 4rem;\n  text-align: center;\n  border-bottom: 1px solid var(--border-color);\n}\n.books-hero h1 {\n  font-size: 3rem;\n  background: linear-gradient(135deg, var(--blue), var(--purple), var(--cyan));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  margin-bottom: 1rem;\n}\n.books-hero .publisher-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 1.5rem;\n  background: var(--bg-card);\n  border: 1px solid var(--border-color);\n  border-radius: 100px;\n  color: var(--text-secondary);\n  font-size: 0.9rem;\n  margin-bottom: 1.5rem;\n}\n.books-hero .publisher-badge .dot {\n  width: 8px; height: 8px;\n  background: var(--green);\n  border-radius: 50%;\n  animation: pulse 2s infinite;\n}\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.4; }\n}\n.books-hero p {\n  color: var(--text-secondary);\n  font-size: 1.15rem;\n  max-width: 700px;\n  margin: 0 auto;\n}\n.books-stats {\n  display: flex;\n  justify-content: center;\n  gap: 3rem;\n  margin-top: 2rem;\n  flex-wrap: wrap;\n}\n.books-stats .stat {\n  text-align: center;\n}\n.books-stats .stat-num {\n  font-size: 2rem;\n  font-weight: 800;\n  color: var(--blue);\n}\n.books-stats .stat-label {\n  font-size: 0.85rem;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n/* ═══ Filter Bar ═══ */\n.filter-bar {\n  max-width: 1400px;\n  margin: 2rem auto 0;\n  padding: 0 2rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  flex-wrap: wrap;\n}\n.filter-btn {\n  padding: 0.45rem 1rem;\n  border-radius: 100px;\n  border: 1px solid var(--border-color);\n  background: var(--bg-secondary);\n  color: var(--text-secondary);\n  font-size: 0.85rem;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.filter-btn:hover, .filter-btn.active {\n  background: var(--blue-dim);\n  border-color: var(--blue);\n  color: var(--blue);\n}\n\n/* ═══ Book Grid ═══ */\n.books-grid {\n  max-width: 1400px;\n  margin: 2rem auto 4rem;\n  padding: 0 2rem;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 1.5rem;\n}\n\n.book-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  transition: all 0.3s ease;\n  display: flex;\n  flex-direction: column;\n}\n.book-card:hover {\n  border-color: var(--blue);\n  transform: translateY(-4px);\n  box-shadow: var(--shadow-lg), 0 0 30px rgba(88,166,255,0.1);\n}\n\n.book-cover {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 2/3;\n  overflow: hidden;\n  background: var(--bg-primary);\n}\n.book-cover img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.3s;\n}\n.book-card:hover .book-cover img {\n  transform: scale(1.03);\n}\n.book-cover .badge {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  padding: 0.25rem 0.75rem;\n  border-radius: 100px;\n  font-size: 0.7rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n.badge-free {\n  background: rgba(63,185,80,0.9);\n  color: #fff;\n}\n.badge-new {\n  background: rgba(88,166,255,0.9);\n  color: #fff;\n}\n\n.book-info {\n  padding: 1.25rem;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n.book-info h3 {\n  font-size: 1.1rem;\n  margin: 0 0 0.35rem;\n  color: var(--text-primary);\n}\n.book-info .book-sub {\n  font-size: 0.85rem;\n  color: var(--text-secondary);\n  margin-bottom: 0.75rem;\n  line-height: 1.4;\n}\n.book-meta {\n  display: flex;\n  gap: 1rem;\n  margin-bottom: 0.75rem;\n  flex-wrap: wrap;\n}\n.book-meta span {\n  font-size: 0.75rem;\n  color: var(--text-muted);\n  display: flex;\n  align-items: center;\n  gap: 0.3rem;\n}\n.book-meta .icon {\n  width: 14px;\n  height: 14px;\n  opacity: 0.6;\n}\n.book-tags {\n  display: flex;\n  gap: 0.4rem;\n  flex-wrap: wrap;\n  margin-bottom: 1rem;\n}\n.book-tag {\n  font-size: 0.7rem;\n  padding: 0.15rem 0.5rem;\n  border-radius: 100px;\n  border: 1px solid;\n  font-weight: 500;\n}\n.book-actions {\n  margin-top: auto;\n  display: flex;\n  gap: 0.5rem;\n}\n.btn-pdf {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.4rem;\n  padding: 0.6rem 1rem;\n  border-radius: var(--radius-sm);\n  font-size: 0.85rem;\n  font-weight: 600;\n  transition: all 0.2s;\n  text-decoration: none;\n}\n.btn-pdf:hover { text-decoration: none; }\n.btn-download {\n  background: var(--blue);\n  color: #fff;\n}\n.btn-download:hover {\n  background: #79b8ff;\n  color: #fff;\n}\n.btn-github {\n  background: var(--bg-tertiary);\n  color: var(--text-secondary);\n  border: 1px solid var(--border-color);\n}\n.btn-github:hover {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n}\n\n/* ═══ Featured Book ═══ */\n.featured-book {\n  max-width: 1400px;\n  margin: 3rem auto 2rem;\n  padding: 0 2rem;\n}\n.featured-inner {\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 2.5rem;\n  background: linear-gradient(135deg, var(--bg-card), var(--bg-tertiary));\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-xl);\n  padding: 2rem;\n  align-items: center;\n}\n.featured-inner img {\n  width: 100%;\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-lg);\n}\n.featured-content h2 {\n  font-size: 1.8rem;\n  border: none;\n  margin: 0 0 0.5rem;\n  padding: 0;\n  background: linear-gradient(90deg, var(--blue), var(--purple));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n.featured-content p {\n  color: var(--text-secondary);\n  line-height: 1.6;\n  margin-bottom: 1rem;\n}\n.featured-features {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.5rem 1.5rem;\n  margin-bottom: 1.5rem;\n}\n.featured-features span {\n  font-size: 0.9rem;\n  color: var(--text-secondary);\n}\n.featured-features span::before {\n  content: \"✓ \";\n  color: var(--green);\n  font-weight: bold;\n}\n\n/* ═══ Responsive ═══ */\n@media (max-width: 768px) {\n  .books-hero h1 { font-size: 2rem; }\n  .books-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }\n  .featured-inner { grid-template-columns: 1fr; }\n  .featured-inner img { max-width: 200px; margin: 0 auto; }\n  .books-stats { gap: 1.5rem; }\n  .filter-bar { padding: 0 1rem; }\n}\n</style>";
const content = "<!-- ═══ Navbar ═══ -->\n\n\n<!-- ═══ Hero ═══ -->\n<section class=\"books-hero\">\n  <div class=\"publisher-badge\">\n    <span class=\"dot\"></span>\n    EmbeddedOS Press — Open Source Technical Publishing\n  </div>\n  <h1>📚 Book Library</h1>\n  <p>14 professional reference books covering the entire EmbeddedOS ecosystem. Free PDF downloads with colorful diagrams, architecture illustrations, and academic references.</p>\n  <div class=\"books-stats\">\n    <div class=\"stat\"><div class=\"stat-num\">14</div><div class=\"stat-label\">Books</div></div>\n    <div class=\"stat\"><div class=\"stat-num\" style=\"color:var(--green)\">50+</div><div class=\"stat-label\">Diagrams</div></div>\n    <div class=\"stat\"><div class=\"stat-num\" style=\"color:var(--purple)\">180+</div><div class=\"stat-label\">Citations</div></div>\n    <div class=\"stat\"><div class=\"stat-num\" style=\"color:var(--orange)\">FREE</div><div class=\"stat-label\">Open Source</div></div>\n  </div>\n</section>\n\n<!-- ═══ Featured: Ecosystem Guide ═══ -->\n<section class=\"featured-book\">\n  <div class=\"featured-inner\">\n    <img src=\"https://raw.githubusercontent.com/embeddedos-org/eos/master/docs/book/cover.png\" alt=\"EmbeddedOS Complete Guide Cover\">\n    <div class=\"featured-content\">\n      <h2>EmbeddedOS: The Complete Guide</h2>\n      <p>The definitive 42-chapter reference covering the entire EoS platform — from kernel internals and HAL design to all 13 ecosystem products. 500+ pages with architecture diagrams, API references, and deployment guides.</p>\n      <div class=\"featured-features\">\n        <span>42 Chapters, 7 Parts</span>\n        <span>5 Architecture Diagrams</span>\n        <span>STM32F4 Production Reference</span>\n        <span>14 Academic References</span>\n        <span>13 Product Coverage</span>\n        <span>API Quick Reference</span>\n        <span>Cross-Compilation Guide</span>\n        <span>Safety Certification</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eos/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ Download PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eos/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">📖 Source</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═══ Filter ═══ -->\n<div class=\"filter-bar\">\n  <button class=\"filter-btn active\" onclick=\"filterBooks('all')\">All Books</button>\n  <button class=\"filter-btn\" onclick=\"filterBooks('core')\">Core Platform</button>\n  <button class=\"filter-btn\" onclick=\"filterBooks('tools')\">Dev Tools</button>\n  <button class=\"filter-btn\" onclick=\"filterBooks('apps')\">Apps &amp; Services</button>\n  <button class=\"filter-btn\" onclick=\"filterBooks('ai')\">AI &amp; Neural</button>\n  <button class=\"filter-btn\" onclick=\"filterBooks('hw')\">Hardware</button>\n</div>\n\n<!-- ═══ Book Grid ═══ -->\n<div class=\"books-grid\" id=\"booksGrid\">\n\n  <!-- eBoot -->\n  <div class=\"book-card\" data-cat=\"core\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eBoot/master/docs/book/cover.png\" alt=\"eBoot Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eBoot — Secure Bootloader Platform</h3>\n      <div class=\"book-sub\">Multi-platform secure boot with Ed25519, A/B partitions, and OTA firmware updates for ARM, RISC-V, and x86.</div>\n      <div class=\"book-meta\">\n        <span>📄 30+ Chapters</span>\n        <span>🖼 5 Diagrams</span>\n        <span>📚 13 References</span>\n      </div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--green);border-color:var(--green)\">Bootloader</span>\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">Crypto</span>\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">OTA</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eBoot/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eBoot/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- ebuild -->\n  <div class=\"book-card\" data-cat=\"tools\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/ebuild/master/docs/book/cover.png\" alt=\"ebuild Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>ebuild — Build System &amp; Toolchain</h3>\n      <div class=\"book-sub\">Cross-platform build system supporting CMake, Meson, Yocto, and Ninja with dependency resolution and reproducible builds.</div>\n      <div class=\"book-meta\"><span>📄 25+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 12 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">Build</span>\n        <span class=\"book-tag\" style=\"color:var(--cyan);border-color:var(--cyan)\">CMake</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/ebuild/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/ebuild/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eIPC -->\n  <div class=\"book-card\" data-cat=\"core\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eIPC/master/docs/book/cover.png\" alt=\"eIPC Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eIPC — Inter-Process Communication</h3>\n      <div class=\"book-sub\">Complete IPC framework with gRPC, Protocol Buffers, pub/sub, HMAC security, and 5 transport backends.</div>\n      <div class=\"book-meta\"><span>📄 28+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 12 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--cyan);border-color:var(--cyan)\">IPC</span>\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">gRPC</span>\n        <span class=\"book-tag\" style=\"color:var(--red);border-color:var(--red)\">Security</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eIPC/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eIPC/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eAI -->\n  <div class=\"book-card\" data-cat=\"ai\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eAI/master/docs/book/cover.png\" alt=\"eAI Cover\" loading=\"lazy\">\n      <span class=\"badge badge-new\">NEW</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eAI — Embedded AI &amp; TinyML</h3>\n      <div class=\"book-sub\">Two-tier AI platform with TFLite Micro, LoRA fine-tuning, federated learning, and 8-layer security architecture.</div>\n      <div class=\"book-meta\"><span>📄 30+ Chapters</span><span>🖼 4 Diagrams</span><span>📚 12 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">AI/ML</span>\n        <span class=\"book-tag\" style=\"color:var(--green);border-color:var(--green)\">TinyML</span>\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">Edge</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eAI/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eAI/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eNI -->\n  <div class=\"book-card\" data-cat=\"ai\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eNI/master/docs/book/cover.png\" alt=\"eNI Cover\" loading=\"lazy\">\n      <span class=\"badge badge-new\">NEW</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eNI — Neural Interface Platform</h3>\n      <div class=\"book-sub\">Brain-computer interface with EEG signal processing, neural decoding, and real-time BCI control loops.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 11 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--pink);border-color:var(--pink)\">BCI</span>\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">Neural</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eNI/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eNI/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- EoSim -->\n  <div class=\"book-card\" data-cat=\"tools\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/EoSim/master/docs/book/cover.png\" alt=\"EoSim Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>EoSim — Hardware Simulation Engine</h3>\n      <div class=\"book-sub\">Multi-architecture simulation with QEMU, Renode, SystemC co-simulation, and HIL testing frameworks.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 11 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--red);border-color:var(--red)\">QEMU</span>\n        <span class=\"book-tag\" style=\"color:var(--cyan);border-color:var(--cyan)\">Simulation</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/EoSim/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/EoSim/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- EoStudio -->\n  <div class=\"book-card\" data-cat=\"tools\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/EoStudio/master/docs/book/cover.png\" alt=\"EoStudio Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>EoStudio — IDE &amp; Design Suite</h3>\n      <div class=\"book-sub\">Cross-platform IDE with LSP, Tree-sitter code analysis, KiCad PCB integration, and debug adapter protocol.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 11 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">IDE</span>\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">PCB</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/EoStudio/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/EoStudio/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eApps -->\n  <div class=\"book-card\" data-cat=\"apps\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eApps/master/docs/book/cover.png\" alt=\"eApps Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eApps — Application Framework</h3>\n      <div class=\"book-sub\">Unified app marketplace with LVGL widget toolkit, sandboxed runtime, and touch-based UI rendering pipeline.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 11 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--yellow);border-color:var(--yellow)\">Apps</span>\n        <span class=\"book-tag\" style=\"color:var(--green);border-color:var(--green)\">LVGL</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eApps/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eDB -->\n  <div class=\"book-card\" data-cat=\"apps\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eDB/master/docs/book/cover.png\" alt=\"eDB Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eDB — Embedded Database Engine</h3>\n      <div class=\"book-sub\">Multi-model database with SQL, document, graph, key-value, full-text search, and CRDT replication.</div>\n      <div class=\"book-meta\"><span>📄 25+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 11 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--green);border-color:var(--green)\">SQLite</span>\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">Graph</span>\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">FTS</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eDB/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eDB/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eBrowser -->\n  <div class=\"book-card\" data-cat=\"apps\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eBrowser/master/docs/book/cover.png\" alt=\"eBrowser Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eBrowser — Embedded Web Browser</h3>\n      <div class=\"book-sub\">Lightweight browser with HTML5 parser, CSS layout engine, JavaScript VM, HTTP/2, and TLS 1.3.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 12 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--cyan);border-color:var(--cyan)\">HTML5</span>\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">CSS</span>\n        <span class=\"book-tag\" style=\"color:var(--yellow);border-color:var(--yellow)\">JS</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eBrowser/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eBrowser/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eOffice -->\n  <div class=\"book-card\" data-cat=\"apps\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eOffice/master/docs/book/cover.png\" alt=\"eOffice Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eOffice — Office Productivity Suite</h3>\n      <div class=\"book-sub\">AI-powered office suite with CRDT real-time collaboration, OOXML/ODF format support, and PDF export.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 12 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--orange);border-color:var(--orange)\">Docs</span>\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">CRDT</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eOffice/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eOffice/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- eHardware -->\n  <div class=\"book-card\" data-cat=\"hw\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/eCAD-Hardware-Products/master/docs/book/cover.png\" alt=\"eHardware Cover\" loading=\"lazy\">\n      <span class=\"badge badge-free\">FREE</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>eHardware — Design &amp; Products</h3>\n      <div class=\"book-sub\">Hardware engineering with KiCad PCB design, radar systems, health sensors, EMC compliance, and manufacturing.</div>\n      <div class=\"book-meta\"><span>📄 20+ Chapters</span><span>🖼 3 Diagrams</span><span>📚 13 References</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--green);border-color:var(--green)\">PCB</span>\n        <span class=\"book-tag\" style=\"color:var(--red);border-color:var(--red)\">Radar</span>\n        <span class=\"book-tag\" style=\"color:var(--cyan);border-color:var(--cyan)\">Sensors</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org/eCAD-Hardware-Products/releases/latest\" class=\"btn-pdf btn-download\" target=\"_blank\">⬇ PDF</a>\n        <a href=\"https://github.com/embeddedos-org/eCAD-Hardware-Products/tree/master/docs/book\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Ecosystem Guide -->\n  <div class=\"book-card\" data-cat=\"core\">\n    <div class=\"book-cover\">\n      <img src=\"https://raw.githubusercontent.com/embeddedos-org/www.embeddedos.org/master/docs/book/cover.png\" alt=\"Ecosystem Cover\" loading=\"lazy\">\n      <span class=\"badge badge-new\">NEW</span>\n    </div>\n    <div class=\"book-info\">\n      <h3>Ecosystem — Complete Platform Guide</h3>\n      <div class=\"book-sub\">Overview of all 13 EmbeddedOS products, how they integrate, deployment architectures, and the full product roadmap.</div>\n      <div class=\"book-meta\"><span>📄 Overview Guide</span><span>🖼 Cover Art</span><span>📚 Cross-refs</span></div>\n      <div class=\"book-tags\">\n        <span class=\"book-tag\" style=\"color:var(--purple);border-color:var(--purple)\">Ecosystem</span>\n        <span class=\"book-tag\" style=\"color:var(--blue);border-color:var(--blue)\">Platform</span>\n      </div>\n      <div class=\"book-actions\">\n        <a href=\"https://github.com/embeddedos-org\" class=\"btn-pdf btn-download\" target=\"_blank\">🌐 Explore</a>\n        <a href=\"https://github.com/embeddedos-org/www.embeddedos.org\" class=\"btn-pdf btn-github\" target=\"_blank\">Source</a>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<!-- ═══ Footer ═══ -->\n<footer style=\"text-align:center; padding:3rem 2rem; border-top:1px solid var(--border-color); color:var(--text-muted); font-size:0.85rem;\">\n  <p><strong>EmbeddedOS Press</strong> — Open Source Technical Publishing</p>\n  <p style=\"margin-top:0.5rem;\">All books are free and open source under CC BY-SA 4.0. PDFs auto-generated via GitHub Actions CI/CD.</p>\n  <p style=\"margin-top:0.5rem;\">© 2026 Srikanth Patchava &amp; EmbeddedOS Contributors</p>\n  <ul class=\"social-list\" style=\"display:flex; justify-content:center; gap:0.6rem; flex-wrap:wrap; margin-top:1.2rem;\">\n    <li><a class=\"social-link social-youtube\" href=\"https://www.youtube.com/@EmbeddedOS_ORG\" target=\"_blank\" rel=\"noopener\" aria-label=\"YouTube\"><span class=\"social-icon\">▶</span> YouTube</a></li>\n    <li><a class=\"social-link social-linkedin\" href=\"https://www.linkedin.com/company/embedded-operating-systems-research-foundation\" target=\"_blank\" rel=\"noopener\" aria-label=\"LinkedIn\"><span class=\"social-icon\">in</span> LinkedIn</a></li>\n    <li><a class=\"social-link social-x\" href=\"https://x.com/EmbeddedOS_ORG\" target=\"_blank\" rel=\"noopener\" aria-label=\"X (Twitter)\"><span class=\"social-icon\">𝕏</span> X (Twitter)</a></li>\n    <li><a class=\"social-link social-facebook\" href=\"https://www.facebook.com/people/Embedded-Operating-Systems-Research-Foundation/61588978691494/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Facebook\"><span class=\"social-icon\">f</span> Facebook</a></li>\n  </ul>\n</footer>\n\n<div id=\"eos-search-overlay\" class=\"search-overlay\" hidden=\"\">\n<div class=\"search-modal\">\n<div class=\"search-header\">\n<span class=\"search-icon\">🔍</span>\n<input type=\"text\" id=\"eos-search-input\" class=\"search-input\" placeholder=\"Search EmbeddedOS docs...\" autocomplete=\"off\">\n<kbd class=\"search-kbd\">Esc</kbd>\n</div>\n<ul id=\"eos-search-results\" class=\"search-results\"></ul>\n</div>\n</div>";
