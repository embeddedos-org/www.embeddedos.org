---
import Base from "../../layouts/Base.astro";
const rawHead = "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.github.com; base-uri 'self'; form-action 'self'\">\n    <meta http-equiv=\"X-Content-Type-Options\" content=\"nosniff\">\n    <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\n\n<link rel=\"apple-touch-icon\" href=\"/og-image.png\">\n\n<title>eApps - EoSim Play and Browser Extensions - EmbeddedOS</title>\n<meta name=\"description\" content=\"Interactive 3D simulation games, browser extensions, and apps for EmbeddedOS. Play aircraft, drone, and vehicle simulators in your browser.\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.embeddedos.org/eApps/\">\n<meta property=\"og:title\" content=\"eApps - EoSim Play and Browser Extensions - EmbeddedOS\">\n<meta property=\"og:description\" content=\"Interactive 3D simulation games, browser extensions, and apps for EmbeddedOS. Play aircraft, drone, and vehicle simulators in your browser.\">\n<meta property=\"og:image\" content=\"https://www.embeddedos.org/og-image.png\">\n<meta property=\"og:image:secure_url\" content=\"https://www.embeddedos.org/og-image.png\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta property=\"og:image:alt\" content=\"EmbeddedOS — open-source embedded operating system, 13 products, 14 books, 60+ apps\">\n<meta property=\"article:publisher\" content=\"https://www.facebook.com/people/Embedded-Operating-Systems-Research-Foundation/61588978691494/\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"eApps - EoSim Play and Browser Extensions - EmbeddedOS\">\n<meta name=\"twitter:description\" content=\"Interactive 3D simulation games, browser extensions, and apps for EmbeddedOS. Play aircraft, drone, and vehicle simulators in your browser.\">\n<meta name=\"twitter:image\" content=\"https://www.embeddedos.org/og-image.png\">\n<meta name=\"twitter:site\" content=\"@EmbeddedOS_ORG\">\n<meta name=\"twitter:creator\" content=\"@EmbeddedOS_ORG\">\n<meta name=\"twitter:url\" content=\"https://www.embeddedos.org/\">\n<meta name=\"twitter:domain\" content=\"embeddedos-org.github.io\">\n<meta name=\"twitter:image:alt\" content=\"EmbeddedOS — open-source embedded operating system, 13 products, 14 books, 60+ apps\">\n<link rel=\"canonical\" href=\"https://www.embeddedos.org/eApps/\">\n\n<style>\n.sim-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem;margin:2rem 0}\n.sim-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius-lg);padding:1.5rem;text-align:center;transition:all .3s}\n.sim-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}\n.sim-card img{width:80px;height:80px;margin:0 auto 1rem;display:block;border-radius:16px}\n.sim-card h3{border:none;margin:0 0 .5rem;font-size:1.2rem}\n.cmd-table{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.85rem}\n.cmd-table th{text-align:left;padding:8px 12px;background:var(--bg-secondary);border:1px solid var(--border-color);color:var(--cyan)}\n.cmd-table td{padding:8px 12px;border:1px solid var(--border-color)}\n.cmd-table code{color:var(--green);font-size:.82rem}\n.section-icon{font-size:1.8rem;margin-right:8px;vertical-align:middle}\n.layer-diagram{background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:var(--radius-md);padding:1.5rem;margin:1.5rem 0;font-family:monospace;font-size:.82rem;color:var(--text-secondary);line-height:1.8}\n.reuse-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:12px;background:rgba(52,211,153,.15);color:var(--green);font-size:.75rem;font-weight:700;letter-spacing:.3px}\n</style><link rel=\"me\" href=\"https://www.youtube.com/@EmbeddedOS_ORG\">\n<link rel=\"me\" href=\"https://www.linkedin.com/company/embedded-operating-systems-research-foundation\">\n<link rel=\"me\" href=\"https://x.com/EmbeddedOS_ORG\">\n<link rel=\"me\" href=\"https://www.facebook.com/people/Embedded-Operating-Systems-Research-Foundation/61588978691494/\">";
const content = "<section class=\"hero\" style=\"padding:4rem 2rem 3rem\"><div class=\"hero-content\">\n<h1 style=\"font-size:2.6rem\">🎮 EoSim Play &amp; eApps</h1>\n<p class=\"subtitle\">Interactive 3D simulation games ported from EoSim renderers — play in your browser, install as mobile app, or use as a browser extension.</p>\n<div class=\"hero-buttons\">\n<a href=\"#games\" class=\"btn btn-primary\">Play Games</a>\n<a href=\"#extension\" class=\"btn btn-secondary\">Browser Extension</a>\n<a href=\"#cli\" class=\"btn btn-outline\">CLI Commands</a>\n</div>\n</div></section>\n\n<div class=\"content-wrapper\" style=\"max-width:1000px\">\n\n<h2 id=\"games\" style=\"border:none;text-align:center;font-size:1.8rem\"><span class=\"section-icon\">🕹️</span>Simulation Games</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1.5rem\">\nEach game reuses the <strong style=\"color:var(--green)\">exact same 3D geometry and physics</strong> from EoSim's Python renderers\n(<code>eosim/gui/renderers/</code>), ported to JavaScript/Canvas. <span class=\"reuse-badge\">♻️ Code Reused</span>\n</p>\n\n<div class=\"sim-grid\">\n<div class=\"sim-card\" style=\"border-top:3px solid #60a5fa\">\n<img src=\"icons/sim-aircraft.svg\" alt=\"Aircraft Sim\">\n<h3 style=\"color:#60a5fa\">✈️ Aircraft Simulator</h3>\n<p>Fly a fixed-wing aircraft with pitch, roll, heading, airspeed, gear, and flaps. Ported from <code>aircraft.py</code>.</p>\n<span class=\"reuse-badge\">From AircraftRenderer</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #34d399\">\n<img src=\"icons/sim-vehicle.svg\" alt=\"Car Sim\">\n<h3 style=\"color:#34d399\">🚗 Car Simulator</h3>\n<p>Drive a car with steering, acceleration, braking, speed-based colors, and odometer. Ported from <code>vehicle.py</code>.</p>\n<span class=\"reuse-badge\">From VehicleRenderer</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #a78bfa\">\n<img src=\"icons/sim-drone.svg\" alt=\"Drone Sim\">\n<h3 style=\"color:#a78bfa\">🚁 Drone Simulator</h3>\n<p>Fly a quadrotor with roll, pitch, yaw, altitude, motor RPM visualization. Ported from <code>drone.py</code>.</p>\n<span class=\"reuse-badge\">From DroneRenderer</span>\n</div>\n</div>\n\n<h2 id=\"eosim-tool\" style=\"border:none;text-align:center;font-size:1.8rem\"><span class=\"section-icon\">🖥️</span>EoSim — Official Simulation Platform</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1.5rem\">\n<strong style=\"color:var(--red)\">EoSim</strong> is the multi-architecture embedded simulation platform — supporting <strong>52+ platforms</strong> across 12 architectures with native Python simulation, QEMU, Renode, VirtualBox, VMware, Docker-like layers, and snapshots.\n</p>\n\n<div class=\"sim-grid\">\n<div class=\"sim-card\" style=\"border-top:3px solid #f87171\">\n<img src=\"icons/eosim.svg\" alt=\"EoSim\">\n<h3 style=\"color:#f87171\">🖥️ EoSim Engine</h3>\n<p>52+ platform definitions — ARM, RISC-V, Xtensa, x86, MIPS, PowerPC. Native + QEMU + Renode + VirtualBox + VMware engines.</p>\n<span class=\"reuse-badge\">Python · 12 Architectures</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #fb923c\">\n<h3 style=\"color:#fb923c;margin-top:0.5rem\">🎨 14 3D Renderers</h3>\n<p>Aircraft, Vehicle, Drone, Robot, Medical, Satellite, Gaming, Weather, Finance, Aerodynamics, Physiology, Consumer, Generic — all reusable.</p>\n<span class=\"reuse-badge\">Ported to JS for browser</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #ef4444\">\n<h3 style=\"color:#ef4444;margin-top:0.5rem\">📊 GUI Dashboard</h3>\n<p>GPIO panel, UART terminal, CPU state, memory view, peripheral registers, 3D product viewer — Tkinter + Web.</p>\n<span class=\"reuse-badge\">7 Widget Panels</span>\n</div>\n</div>\n\n<div class=\"sim-grid\">\n<div class=\"sim-card\" style=\"border-top:3px solid #f97316\">\n<h3 style=\"color:#f97316;margin-top:0.5rem\">📦 VirtualBox + VMware</h3>\n<p>Generate <code>.vbox</code> + <code>.vdi</code> for VirtualBox and <code>.vmx</code> + <code>.vmdk</code> for VMware directly from platform hardware configs.</p>\n<span class=\"reuse-badge\">eosim vbox create · eosim vmware create</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #ea580c\">\n<h3 style=\"color:#ea580c;margin-top:0.5rem\">🐳 Docker-like Layers</h3>\n<p>Incremental layered VM builds — base (FROM), overlay (COPY/ADD), commit (tag), flatten (export), history — just like Docker.</p>\n<span class=\"reuse-badge\">eosim layer create/add/commit</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #dc2626\">\n<h3 style=\"color:#dc2626;margin-top:0.5rem\">📸 Snapshots</h3>\n<p>Save, restore, export, import VM snapshots across VirtualBox and VMware — with snapshot trees and portable <code>.tar.gz</code> archives.</p>\n<span class=\"reuse-badge\">eosim snapshot save/restore</span>\n</div>\n</div>\n\n<div class=\"callout callout-tip\"><div class=\"callout-title\">Quick Start — EoSim</div>\n<pre><code>pip install git+https://github.com/embeddedos-org/eosim.git\n\neosim list                            # 52+ platforms\neosim run stm32f4 --gui               # launch simulation with GUI\neosim vbox create x86_64-linux        # generate VirtualBox VM\neosim vmware create raspi4            # generate VMware VM\neosim snapshot save my-vm checkpoint1 # save snapshot\neosim layer create my-vm ./out/vbox/my-vm  # create base layer\neosim layer add my-vm ./apps --name apps   # add overlay layer\neosim layer commit my-vm v1.0              # tag as v1.0</code></pre></div>\n\n<p style=\"text-align:center;margin:1.5rem 0\"><a href=\"../docs/eosim.html\" class=\"btn btn-primary\">📖 EoSim API Docs</a>&nbsp;&nbsp;<a href=\"https://github.com/embeddedos-org/eosim\" class=\"btn btn-secondary\" target=\"_blank\" rel=\"noopener\">⭐ GitHub</a></p>\n\n<h2 id=\"eostudio-tool\" style=\"border:none;text-align:center;font-size:1.8rem\"><span class=\"section-icon\">🎨</span>EoStudio — Design Suite with LLM</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1.5rem\">\n<strong style=\"color:var(--purple)\">EoStudio</strong> is the unified cross-platform design tool suite — <strong>12 editors</strong>, <strong>30+ code generators</strong>, AI/LLM integration, and native EoSim plugin for hardware simulation directly from the design canvas.\n</p>\n\n<div class=\"sim-grid\">\n<div class=\"sim-card\" style=\"border-top:3px solid #a855f7\">\n<img src=\"icons/eostudio.svg\" alt=\"EoStudio\">\n<h3 style=\"color:#a855f7\">🎨 12 Design Editors</h3>\n<p>3D Modeler, CAD, Image Editor, Game Editor, UI/UX, Product Design, Interior, UML, Simulation, Database, Hardware PCB, IDE.</p>\n<span class=\"reuse-badge\">Python · tkinter · Cross-Platform</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #c084fc\">\n<h3 style=\"color:#c084fc;margin-top:0.5rem\">⚡ 30+ Code Generators</h3>\n<p>Flutter, React Native, Electron, Tauri, React+FastAPI, Vue+Flask, Angular, Svelte, OpenSCAD, STL, Godot, Unity, EoS firmware.</p>\n<span class=\"reuse-badge\">Mobile · Desktop · Web · Game · Firmware</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #d946ef\">\n<h3 style=\"color:#d946ef;margin-top:0.5rem\">🤖 AI / LLM Powered</h3>\n<p>Design Agent, Smart Chat, Text-to-UI, Text-to-3D, AI Simulator, Kids Tutor — powered by Ollama (local) or OpenAI API.</p>\n<span class=\"reuse-badge\">Ollama · OpenAI · GPT-4</span>\n</div>\n</div>\n\n<div class=\"callout callout-tip\"><div class=\"callout-title\">Quick Start — EoStudio</div>\n<pre><code>pip install -e \".[all]\"\n\nEoStudio launch                       # open design suite\nEoStudio new --template todo-app      # create from template\nEoStudio codegen my-app.eostudio --framework react  # generate code\nEoStudio ask \"Design a responsive dashboard\"        # AI design agent\nEoStudio teach --lesson shapes                      # kids learning mode</code></pre></div>\n\n<p style=\"text-align:center;margin:1.5rem 0\"><a href=\"../docs/eostudio.html\" class=\"btn btn-primary\">📖 EoStudio API Docs</a>&nbsp;&nbsp;<a href=\"https://github.com/embeddedos-org/EoStudio\" class=\"btn btn-secondary\" target=\"_blank\" rel=\"noopener\">⭐ GitHub</a></p>\n\n<h2 id=\"plugins\" style=\"border:none;text-align:center;font-size:1.8rem\"><span class=\"section-icon\">🔌</span>EoSim Plugins — Everywhere</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1.5rem\">\nEoSim is available as a <strong style=\"color:var(--green)\">plugin for every platform</strong> in the EoS ecosystem — from EoStudio design tools to browser extensions, mobile apps, VSCode, JetBrains, Slack, and more.\n</p>\n\n<div class=\"sim-grid\" style=\"grid-template-columns:repeat(auto-fill,minmax(220px,1fr))\">\n<div class=\"sim-card\" style=\"border-top:3px solid #a855f7;padding:1rem\">\n<h3 style=\"color:#a855f7;font-size:1rem;margin-top:0\">🎨 EoStudio Plugin</h3>\n<p style=\"font-size:.8rem\">Simulate hardware directly from the design canvas. Menu items, toolbar, status panel, 3D product viewer.</p>\n<span class=\"reuse-badge\">eosim_plugin.py</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #60a5fa;padding:1rem\">\n<h3 style=\"color:#60a5fa;font-size:1rem;margin-top:0\">🧩 Chrome Extension</h3>\n<p style=\"font-size:.8rem\">EoSim Play games in the eOffice Suite browser extension popup — Aircraft, Car, Drone sims.</p>\n<span class=\"reuse-badge\">extensions/browser/</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #22c55e;padding:1rem\">\n<h3 style=\"color:#22c55e;font-size:1rem;margin-top:0\">📱 Mobile PWA</h3>\n<p style=\"font-size:.8rem\">Touch-optimized sim games with D-pad controls. Installable on iOS &amp; Android via \"Add to Home Screen\".</p>\n<span class=\"reuse-badge\">mobile-apps/eosim-play/</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #38bdf8;padding:1rem\">\n<h3 style=\"color:#38bdf8;font-size:1rem;margin-top:0\">🌐 eBrowser Native</h3>\n<p style=\"font-size:.8rem\">EoSim sims render natively inside eBrowser on embedded devices, kiosks, and IoT dashboards.</p>\n<span class=\"reuse-badge\">eBrowser + sim-engine.js</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #06b6d4;padding:1rem\">\n<h3 style=\"color:#06b6d4;font-size:1rem;margin-top:0\">💻 VSCode Extension</h3>\n<p style=\"font-size:.8rem\">EoSim sidebar provider, app launcher, CSV editor — integrated into VS Code.</p>\n<span class=\"reuse-badge\">extensions/vscode/</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #8b5cf6;padding:1rem\">\n<h3 style=\"color:#8b5cf6;font-size:1rem;margin-top:0\">🔧 JetBrains Plugin</h3>\n<p style=\"font-size:.8rem\">EoSim tool window and eBot action for IntelliJ, CLion, PyCharm — simulate from your IDE.</p>\n<span class=\"reuse-badge\">extensions/jetbrains/</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #f59e0b;padding:1rem\">\n<h3 style=\"color:#f59e0b;font-size:1rem;margin-top:0\">💬 Slack Bot</h3>\n<p style=\"font-size:.8rem\">Run <code>/eosim simulate stm32f4</code> in Slack channels. Share results with your team.</p>\n<span class=\"reuse-badge\">extensions/slack/</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #ec4899;padding:1rem\">\n<h3 style=\"color:#ec4899;font-size:1rem;margin-top:0\">🍎 Safari Extension</h3>\n<p style=\"font-size:.8rem\">Same eOffice Suite with EoSim Play games — works in Safari on macOS &amp; iOS.</p>\n<span class=\"reuse-badge\">extensions/safari/</span>\n</div>\n</div>\n\n<div class=\"callout callout-info\"><div class=\"callout-title\">EoSim Plugin Architecture</div>\n<pre><code>┌─────────────────────────────────────────────────────────────┐\n│                    EoSim Core Engine                         │\n│  (52+ platforms, 14 renderers, QEMU/Renode/VBox/VMware)     │\n├─────────────────────────────────────────────────────────────┤\n│                  Plugin Interfaces                           │\n│  ┌──────────┐ ┌──────────┐ ┌──────────┐ ┌──────────┐       │\n│  │ EoStudio │ │ eBrowser │ │  Chrome  │ │  VSCode  │       │\n│  │  Plugin  │ │  Native  │ │Extension │ │Extension │       │\n│  └────┬─────┘ └────┬─────┘ └────┬─────┘ └────┬─────┘       │\n│       │             │            │             │             │\n│  ┌────┴─────┐ ┌────┴─────┐ ┌────┴─────┐ ┌────┴─────┐       │\n│  │ JetBrains│ │  Slack   │ │  Safari  │ │  Mobile  │       │\n│  │  Plugin  │ │   Bot    │ │Extension │ │   PWA    │       │\n│  └──────────┘ └──────────┘ └──────────┘ └──────────┘       │\n├─────────────────────────────────────────────────────────────┤\n│              Shared: sim-engine.js (Canvas 2D)              │\n│         Ported from eosim/gui/renderers/*.py (Python)       │\n└─────────────────────────────────────────────────────────────┘</code></pre></div>\n\n<h2 id=\"architecture\" style=\"border:none;text-align:center;font-size:1.6rem\"><span class=\"section-icon\">🌐</span>eBrowser — Embedded Web Browser</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1.5rem\">\n<strong style=\"color:var(--cyan)\">eBrowser</strong> is the EmbeddedOS lightweight web browser engine — built from scratch in C/C++ for embedded devices, kiosks, and IoT dashboards. It renders the EoSim Play games natively and powers the browser extension platform.\n</p>\n\n<div class=\"sim-grid\">\n<div class=\"sim-card\" style=\"border-top:3px solid #38bdf8\">\n<img src=\"icons/ebrowser.svg\" alt=\"eBrowser\">\n<h3 style=\"color:#38bdf8\">🌐 eBrowser Engine</h3>\n<p>Lightweight HTML5/CSS3 rendering engine with DOM, layout, and networking — all under 1 MB binary.</p>\n<span class=\"reuse-badge\">C/C++ · LVGL · SDL2 · WASM</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #0ea5e9\">\n<h3 style=\"color:#0ea5e9;margin-top:0.5rem\">🧩 Extension Support</h3>\n<p>eBrowser loads eOffice Suite extensions and EoSim Play sims as browser-native apps — same extensions run in Chrome, eBrowser, and mobile.</p>\n<span class=\"reuse-badge\">Same JS · Same HTML</span>\n</div>\n<div class=\"sim-card\" style=\"border-top:3px solid #06b6d4\">\n<h3 style=\"color:#06b6d4;margin-top:0.5rem\">🖥️ 3 Backends</h3>\n<p><strong>SDL2</strong> (desktop), <strong>EoS native</strong> (embedded framebuffer), <strong>WASM</strong> (run in any browser via Emscripten).</p>\n<span class=\"reuse-badge\">Cross-Platform</span>\n</div>\n</div>\n\n<div class=\"callout callout-tip\"><div class=\"callout-title\">Quick Start — eBrowser</div>\n<pre><code># Linux / macOS\ngit clone --recursive https://github.com/embeddedos-org/eBrowser.git\ncd eBrowser &amp;&amp; ./setup.sh\n\n# Windows\ngit clone --recursive https://github.com/embeddedos-org/eBrowser.git\ncd eBrowser &amp;&amp; setup.bat\n\n# Open EoSim Play games in eBrowser\n./eBrowser https://www.embeddedos.org/eApps/</code></pre></div>\n\n<div class=\"callout callout-info\"><div class=\"callout-title\">eBrowser Architecture</div>\n<pre><code>┌─────────────────────────────────────────────┐\n│          Browser UI (tabs, URL bar)          │\n├─────────────────────────────────────────────┤\n│   Core Engine (HTML / CSS / Layout / JS)     │\n├──────────────┬──────────────┬───────────────┤\n│  Rendering   │   Network    │    Input       │\n│  (LVGL)      │   (HTTP/S)   │  (touch/kb)    │\n├──────────────┴──────────────┴───────────────┤\n│      Platform Abstraction Layer (PAL)        │\n├─────────────────────────────────────────────┤\n│   SDL2 (desktop)  │  EoS (embedded)  │ WASM  │\n└─────────────────────────────────────────────┘</code></pre></div>\n\n<div class=\"callout callout-info\"><div class=\"callout-title\">eBrowser C API</div>\n<pre><code>#include &lt;ebrowser/ebrowser.h&gt;\n\neb_config cfg = eb_config_default();\neb_instance *browser = eb_create(&amp;cfg);\neb_navigate(browser, \"https://www.embeddedos.org/eApps/\");\neb_run(browser);\neb_destroy(browser);</code></pre></div>\n\n<p style=\"text-align:center;margin:1.5rem 0\"><a href=\"../docs/ebrowser.html\" class=\"btn btn-primary\">📖 Full eBrowser API Docs</a>&nbsp;&nbsp;<a href=\"https://github.com/embeddedos-org/eBrowser\" class=\"btn btn-secondary\" target=\"_blank\" rel=\"noopener\">⭐ GitHub</a></p>\n\n<h2 id=\"reuse-arch\" style=\"border:none;text-align:center;font-size:1.6rem\"><span class=\"section-icon\">🔄</span>Code Reuse Architecture</h2>\n<div class=\"layer-diagram\">\nEoSim Python Renderers (source of truth)\n  eosim/gui/renderers/aircraft.py  ─┐\n  eosim/gui/renderers/vehicle.py   ─┼──→  eApps/shared/js/sim-engine.js  (ported geometry + math)\n  eosim/gui/renderers/drone.py     ─┘           │\n                                                 ├──→  Browser Extension (eosim-play.html)\n                                                 ├──→  Mobile PWA (mobile-apps/eosim-play/)\n                                                 └──→  GitHub Pages (embeddedos-org.github.io/eApps/)\n\nLayer Reuse (Docker-like):\n  ┌────────────────────────────────────────────┐\n  │  Layer 3: Custom Designs (per-deployment)  │  ← eosim layer add\n  ├────────────────────────────────────────────┤\n  │  Layer 2: App Layer (sim-engine.js)        │  ← eosim layer add\n  ├────────────────────────────────────────────┤\n  │  Layer 1: Base OS (VirtualBox / VMware)    │  ← eosim layer create\n  └────────────────────────────────────────────┘\n</div>\n\n<h2 id=\"downloads\" style=\"border:none;text-align:center;font-size:1.8rem\"><span class=\"section-icon\">📥</span>Downloads by Platform</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1.5rem\">All releases are hosted on <a href=\"https://github.com/embeddedos-org/eApps/releases\" style=\"color:var(--blue)\" target=\"_blank\" rel=\"noopener\">GitHub Releases</a>. Pick your platform:</p>\n\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-bottom:2rem\">\n\n<div class=\"callout\" style=\"border-left:4px solid var(--blue)\"><div class=\"callout-title\">🌐 Browser Extensions</div>\n<table class=\"cmd-table\"><tbody><tr><th>Browser</th><th>Format</th><th>Download</th></tr>\n<tr><td>Chrome / Edge / Brave</td><td><code>.crx</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--blue)\" target=\"_blank\" rel=\"noopener\">Latest .crx</a></td></tr>\n<tr><td>Firefox</td><td><code>.xpi</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--blue)\" target=\"_blank\" rel=\"noopener\">Latest .xpi</a></td></tr>\n<tr><td>Safari</td><td><code>.safariextz</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--blue)\" target=\"_blank\" rel=\"noopener\">Latest .safariextz</a></td></tr>\n<tr><td>Opera</td><td><code>.nex</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--blue)\" target=\"_blank\" rel=\"noopener\">Latest .nex</a></td></tr>\n</tbody></table></div>\n\n<div class=\"callout\" style=\"border-left:4px solid var(--purple)\"><div class=\"callout-title\">🛠️ IDE &amp; Editor Extensions</div>\n<table class=\"cmd-table\"><tbody><tr><th>Editor</th><th>Format</th><th>Download</th></tr>\n<tr><td>VS Code</td><td><code>.vsix</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--purple)\" target=\"_blank\" rel=\"noopener\">Latest .vsix</a></td></tr>\n<tr><td>JetBrains</td><td><code>.jar</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--purple)\" target=\"_blank\" rel=\"noopener\">Latest .jar</a></td></tr>\n<tr><td>Obsidian</td><td><code>.zip</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--purple)\" target=\"_blank\" rel=\"noopener\">Latest .zip</a></td></tr>\n<tr><td>Sublime Text</td><td><code>.sublime-package</code></td><td><a href=\"https://github.com/embeddedos-org/eApps/releases/latest\" style=\"color:var(--purple)\" target=\"_blank\" rel=\"noopener\">Latest</a></td></tr>\n</tbody></table></div>\n\n<div class=\"callout\" style=\"border-left:4px solid var(--green)\"><div class=\"callout-title\">📱 Mobile Apps</div>\n<table class=\"cmd-table\"><tbody><tr><th>Platform</th><th>Format</th><th>Install</th></tr>\n<tr><td>Android (Phone/Tablet)</td><td><code>.apk</code></td><td>Settings → Unknown Sources → Install</td></tr>\n<tr><td>Google Play (AAB)</td><td><code>.aab</code></td><td>Via Play Console upload</td></tr>\n<tr><td>iOS</td><td><code>.ipa</code></td><td>TestFlight or Enterprise cert</td></tr>\n<tr><td>Android TV</td><td><code>.apk</code></td><td>Sideload via ADB</td></tr>\n<tr><td>PWA</td><td>Web</td><td>\"Add to Home Screen\" in browser</td></tr>\n</tbody></table></div>\n\n<div class=\"callout\" style=\"border-left:4px solid var(--orange)\"><div class=\"callout-title\">🖥️ Desktop Apps</div>\n<table class=\"cmd-table\"><tbody><tr><th>OS</th><th>Format</th><th>Apps</th></tr>\n<tr><td>Windows x64</td><td><code>.exe</code> / <code>.msi</code></td><td>eOffice, EoStudio, EoSim, eBrowser</td></tr>\n<tr><td>macOS (Apple Silicon)</td><td><code>.dmg</code> / <code>.pkg</code></td><td>eOffice, EoStudio, EoSim, eBrowser</td></tr>\n<tr><td>Linux x64</td><td><code>.AppImage</code> / <code>.deb</code> / <code>.rpm</code></td><td>eOffice, EoStudio, EoSim, eBrowser</td></tr>\n<tr><td>EmbeddedOS</td><td><code>.eapp</code></td><td>All 45+ native apps</td></tr>\n<tr><td>WASM</td><td><code>.wasm</code></td><td>Web-based deployment</td></tr>\n</tbody></table></div>\n\n<div class=\"callout\" style=\"border-left:4px solid var(--cyan)\"><div class=\"callout-title\">💿 OS &amp; VM Images</div>\n<table class=\"cmd-table\"><tbody><tr><th>Format</th><th>Platform</th><th>Use</th></tr>\n<tr><td><code>.ova</code></td><td>VirtualBox</td><td>Import → Start</td></tr>\n<tr><td><code>.vmdk</code></td><td>VMware</td><td>Create VM → Attach disk</td></tr>\n<tr><td><code>.qcow2</code></td><td>QEMU/KVM</td><td><code>qemu-system-x86_64 -hda eos.qcow2</code></td></tr>\n<tr><td><code>.iso</code></td><td>Bare Metal</td><td>Flash USB → Boot</td></tr>\n<tr><td><code>.img</code></td><td>Raspberry Pi</td><td><code>dd if=eos.img of=/dev/sdX</code></td></tr>\n<tr><td><code>.bin</code></td><td>STM32/ESP32</td><td>Flash via ST-Link / esptool</td></tr>\n</tbody></table></div>\n\n<div class=\"callout\" style=\"border-left:4px solid var(--pink)\"><div class=\"callout-title\">☁️ Services &amp; Integrations</div>\n<table class=\"cmd-table\"><tbody><tr><th>Platform</th><th>Format</th><th>Install</th></tr>\n<tr><td>Slack</td><td>Bot App</td><td>Add to workspace via manifest</td></tr>\n<tr><td>GitHub</td><td>Probot App</td><td>Install via GitHub Apps</td></tr>\n<tr><td>Google Workspace</td><td>Apps Script</td><td>Deploy via clasp</td></tr>\n<tr><td>Office 365</td><td>Add-in</td><td>Sideload manifest.xml</td></tr>\n<tr><td>Raycast</td><td>Extension</td><td><code>raycast import</code></td></tr>\n<tr><td>Docker</td><td><code>.tar.gz</code></td><td><code>docker load</code></td></tr>\n</tbody></table></div>\n</div>\n\n<div class=\"callout callout-tip\" style=\"margin-bottom:2rem\"><div class=\"callout-title\">⚡ Quick Install Commands</div>\n<pre><code># VS Code Extension\ncode --install-extension eoffice-vscode-0.1.0.vsix\n\n# Chrome Extension (unpacked)\n# chrome://extensions → Developer Mode → Load unpacked → extensions/browser/\n\n# Firefox Extension\n# about:addons → ⚙️ → Install from file → eoffice-firefox-0.1.0.xpi\n\n# Android APK\nadb install eride-0.1.0-release.apk\n\n# EoS Native\neosim install eoffice-0.1.0.eapp\n\n# Docker\ndocker pull ghcr.io/embeddedos-org/eosim:latest</code></pre></div>\n\n<h2 id=\"extension\" style=\"border:none;text-align:center;font-size:1.6rem\"><span class=\"section-icon\">🧩</span>Browser Extension</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1rem\">The EoSim sims are integrated into the <strong>eOffice Suite</strong> Chrome extension. Click any sim in the extension popup to launch a full-screen interactive game tab.</p>\n<div class=\"callout callout-tip\"><div class=\"callout-title\">Install</div>\n<ol><li>Clone <code>eApps</code> repo</li>\n<li>Open <code>chrome://extensions</code></li>\n<li>Enable Developer Mode → Load Unpacked → select <code>extensions/browser/</code></li>\n<li>Click the extension icon → scroll to \"🎮 EoSim Simulations\"</li></ol></div>\n\n<h2 id=\"mobile\" style=\"border:none;text-align:center;font-size:1.6rem\"><span class=\"section-icon\">📱</span>Mobile App (PWA)</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1rem\">The same <code>sim-engine.js</code> powers a mobile-optimized PWA with touch D-pad controls, HUD overlay, and landscape orientation. Installable on iOS and Android.</p>\n<div class=\"callout callout-info\"><div class=\"callout-title\">Run Locally</div>\n<pre><code>cd eApps/mobile-apps/eosim-play\nnpx serve .\n# Open on phone → \"Add to Home Screen\"</code></pre></div>\n\n<h2 id=\"cli\" style=\"border:none;text-align:center;font-size:1.8rem\"><span class=\"section-icon\">💻</span>EoSim CLI Commands</h2>\n\n<h3 style=\"color:var(--cyan);border:none\">📸 Snapshot Commands</h3>\n<table class=\"cmd-table\">\n<tbody><tr><th>Command</th><th>Description</th></tr>\n<tr><td><code>eosim snapshot save &lt;vm&gt; &lt;name&gt;</code></td><td>Save a snapshot of a VirtualBox or VMware VM</td></tr>\n<tr><td><code>eosim snapshot restore &lt;vm&gt; &lt;id&gt;</code></td><td>Restore a VM to a saved snapshot state</td></tr>\n<tr><td><code>eosim snapshot list</code></td><td>List all saved snapshots</td></tr>\n<tr><td><code>eosim snapshot delete &lt;vm&gt; &lt;id&gt;</code></td><td>Delete a snapshot and its files</td></tr>\n<tr><td><code>eosim snapshot export &lt;vm&gt; &lt;id&gt;</code></td><td>Export snapshot to portable <code>.tar.gz</code></td></tr>\n<tr><td><code>eosim snapshot import &lt;vm&gt; &lt;archive&gt;</code></td><td>Import snapshot from archive</td></tr>\n</tbody></table>\n\n<h3 style=\"color:var(--green);border:none\">🖥️ VMware Commands</h3>\n<table class=\"cmd-table\">\n<tbody><tr><th>Command</th><th>Description</th></tr>\n<tr><td><code>eosim vmware create &lt;platform&gt;</code></td><td>Create VMware <code>.vmx</code> + <code>.vmdk</code> from platform config</td></tr>\n<tr><td><code>eosim vmware info &lt;platform&gt;</code></td><td>Show VMware config mapping for a platform</td></tr>\n<tr><td><code>eosim vmware export-ova &lt;vmx&gt;</code></td><td>Export to OVA format (requires ovftool)</td></tr>\n</tbody></table>\n\n<h3 style=\"color:var(--purple);border:none\">🐳 Layer Commands (Docker-like)</h3>\n<table class=\"cmd-table\">\n<tbody><tr><th>Command</th><th>Description</th></tr>\n<tr><td><code>eosim layer create &lt;vm&gt; &lt;dir&gt;</code></td><td>Create base layer from VM directory (like Docker <code>FROM</code>)</td></tr>\n<tr><td><code>eosim layer add &lt;vm&gt; &lt;dir&gt;</code></td><td>Add overlay layer on top (like Docker <code>COPY</code>/<code>ADD</code>)</td></tr>\n<tr><td><code>eosim layer commit &lt;vm&gt; &lt;tag&gt;</code></td><td>Tag current layer stack (like Docker <code>tag</code>/<code>commit</code>)</td></tr>\n<tr><td><code>eosim layer list</code></td><td>List all layers across all VMs</td></tr>\n<tr><td><code>eosim layer history &lt;vm&gt;</code></td><td>Show layer history (like <code>docker history</code>)</td></tr>\n<tr><td><code>eosim layer flatten &lt;vm&gt;</code></td><td>Merge all layers into single directory (like <code>docker export</code>)</td></tr>\n<tr><td><code>eosim layer images</code></td><td>List all VM images with layer counts and tags</td></tr>\n</tbody></table>\n\n<h3 style=\"color:var(--blue);border:none\">📦 VirtualBox Commands</h3>\n<table class=\"cmd-table\">\n<tbody><tr><th>Command</th><th>Description</th></tr>\n<tr><td><code>eosim vbox create &lt;platform&gt;</code></td><td>Create VirtualBox <code>.vbox</code> + <code>.vdi</code> from platform config</td></tr>\n<tr><td><code>eosim vbox list</code></td><td>List VirtualBox VMs (requires VBoxManage)</td></tr>\n<tr><td><code>eosim vbox info &lt;platform&gt;</code></td><td>Show VirtualBox config mapping for a platform</td></tr>\n</tbody></table>\n\n<h2 id=\"images\" style=\"border:none;text-align:center;font-size:1.6rem\"><span class=\"section-icon\">🖼️</span>Hosted Assets</h2>\n<p style=\"text-align:center;color:var(--text-secondary);max-width:700px;margin:0 auto 1rem\">All icons and images are hosted at:</p>\n<div class=\"callout callout-info\"><div class=\"callout-title\">Image URLs</div>\n<pre><code>https://www.embeddedos.org/eApps/icons/eosim.svg\nhttps://www.embeddedos.org/eApps/icons/eosim-play.svg\nhttps://www.embeddedos.org/eApps/icons/ebrowser.svg\nhttps://www.embeddedos.org/eApps/icons/sim-aircraft.svg\nhttps://www.embeddedos.org/eApps/icons/sim-vehicle.svg\nhttps://www.embeddedos.org/eApps/icons/sim-drone.svg</code></pre></div>\n\n</div>\n\n<div id=\"eos-search-overlay\" class=\"search-overlay\" hidden=\"\">\n<div class=\"search-modal\">\n<div class=\"search-header\">\n<span class=\"search-icon\">🔍</span>\n<input type=\"text\" id=\"eos-search-input\" class=\"search-input\" placeholder=\"Search EmbeddedOS docs...\" autocomplete=\"off\">\n<kbd class=\"search-kbd\">Esc</kbd>\n</div>\n<ul id=\"eos-search-results\" class=\"search-results\"></ul>\n</div>\n</div>";
