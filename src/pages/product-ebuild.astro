const rawHead = "<meta content=\"EmbeddedOS Foundation — eBuild — Build System &amp; SDK Generator | EmbeddedOS. Open-source embedded OS, neural interfaces, and AI-powered edge computing.\" name=\"description\">\n<meta content=\"eBuild is the EoS build system: 18 CLI commands, SDK generation for 14 targets, profile-based composition, reproducible builds. Python.\" name=\"description\"><meta content=\"EmbeddedOS, EoS, eBuild, Python, embedded AI, open source\" name=\"keywords\"><meta content=\"#0066cc\" name=\"theme-color\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"robots\"><meta content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\" name=\"googlebot\"><meta content=\"index,follow\" name=\"bingbot\"><meta content=\"general\" name=\"rating\"><meta content=\"telephone=no\" name=\"format-detection\"><meta content=\"en_US\" property=\"og:locale\"><meta content=\"EmbeddedOS Research Foundation — open-source embedded AI systems stack\" property=\"og:image:alt\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:site\"><meta content=\"@EmbeddedOS_ORG\" name=\"twitter:creator\"><link href=\"rss.xml\" rel=\"alternate\" title=\"EmbeddedOS Newsroom\" type=\"application/rss+xml\"><meta content=\"eBuild — Build System &amp; SDK Generator — EmbeddedOS\" property=\"og:title\"><meta content=\"eBuild is the EoS build system: 18 CLI commands, SDK generation for 14 targets, profile-based composition, reproducible builds. Python.\" property=\"og:description\"><meta content=\"website\" property=\"og:type\"><link href=\"https://www.embeddedos.org/product-ebuild\" rel=\"canonical\"><link href=\"img/logo.svg\" rel=\"apple-touch-icon\"><meta content=\"https://www.embeddedos.org/product-ebuild\" property=\"og:url\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" property=\"og:image\"><meta content=\"1200\" property=\"og:image:width\"><meta content=\"630\" property=\"og:image:height\"><meta content=\"EmbeddedOS\" property=\"og:site_name\"><meta content=\"summary_large_image\" name=\"twitter:card\"><meta content=\"eBuild — Build System &amp; SDK Generator — EmbeddedOS\" name=\"twitter:title\"><meta content=\"eBuild is the EoS build system: 18 CLI commands, SDK generation for 14 targets, profile-based composition, reproducible builds. Python.\" name=\"twitter:description\"><meta content=\"https://www.embeddedos.org/img/og-cover.svg\" name=\"twitter:image\"><title>eBuild — Build System &amp; SDK Generator | EmbeddedOS</title>\n <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"eBuild\",\n      \"applicationCategory\": \"DeveloperApplication\",\n      \"operatingSystem\": \"EmbeddedOS\",\n      \"description\": \"eBuild is the EoS build system and SDK generator — an 18-command CLI that drives configuration, cross-compilation, signing, packaging, and SDK generation for all 14 EoS components across every supported target.\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"url\": \"https://www.embeddedos.org/product-ebuild\",\n      \"image\": \"https://www.embeddedos.org/img/og-cover.svg\",\n      \"publisher\": { \"@type\": \"Organization\", \"name\": \"EmbeddedOS Research Foundation\", \"url\": \"https://www.embeddedos.org\" }\n    }\n    </script> <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.embeddedos.org/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Ecosystem\", \"item\": \"https://www.embeddedos.org/ecosystem\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"eBuild\", \"item\": \"https://www.embeddedos.org/product-ebuild\" }\n      ]\n    }\n    </script>\n<link href=\"https://www.embeddedos.org/product-ebuild.html\" rel=\"canonical\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a><main id=\"main-content\"><section aria-labelledby=\"ph-ebuild\" class=\"product-hero\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" class=\"breadcrumb\"><a href=\"index.html\">Home</a> · <a href=\"ecosystem.html\">Ecosystem</a>\n            <a href=\"sponsors.html\">Sponsors</a> · <span>eBuild</span></nav><div class=\"product-hero__visual\"><img alt=\"Build pipeline visualisation — eBuild\" decoding=\"async\" height=\"620\" loading=\"lazy\" src=\"img/photos/p-ebuild.svg\" width=\"1200\"></div><span class=\"lang-badge lang-py\"><span class=\"dot\"></span>Python · v0.1.0</span><h1 id=\"ph-ebuild\">eBuild — Build System &amp; SDK Generator</h1><p class=\"lede\">eBuild is the EoS build system and SDK generator — an 18-command CLI that drives configuration, cross-compilation, signing, packaging, and SDK generation for all 14 EoS components across every supported target.</p><div class=\"hero-cta-row\"><a class=\"btn btn-primary\" href=\"https://github.com/embeddedos-org/ebuild\" rel=\"noopener noreferrer\" target=\"_blank\">View on GitHub →</a><a class=\"btn btn-secondary\" href=\"documentation.html\">Read the Docs</a></div><div class=\"stat-tile-row\"><div class=\"stat-tile\"><div class=\"stat-num\">18</div><div class=\"stat-label\">CLI commands</div></div><div class=\"stat-tile\"><div class=\"stat-num\">14</div><div class=\"stat-label\">SDK targets</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Reproducible</div><div class=\"stat-label\">Deterministic builds</div></div><div class=\"stat-tile\"><div class=\"stat-num\">Python</div><div class=\"stat-label\">Build language</div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Overview</span><h2>What eBuild is</h2></div><div class=\"prose\"><p>eBuild treats firmware as a composition: pick a board, pick a profile, pick a feature set, and eBuild resolves the dependency graph, fetches sources at pinned revisions, cross-compiles, signs, and produces a flashable artifact plus a matching SDK for downstream apps.</p><p>Builds are reproducible by default: same inputs, byte-identical outputs. CI integration is first-class — the same `ebuild` commands run locally and in pipelines.</p></div></div></section><section class=\"section section-gray\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Capabilities</span><h2>Features</h2><p>The shape of eBuild at a glance.</p></div><div class=\"feature-grid\"><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>18-Command CLI</h3><p>init, configure, build, sign, package, sdk, test, fuzz, deploy, bench, debug, …</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>14 SDK Targets</h3><p>Auto-generates a build SDK for every component (EoS, EAI, ENI, EIPC, eBoot, eApps, …).</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Profile Composition</h3><p>Combine board + product profile + feature flags; resolves the full dependency graph.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Reproducible Builds</h3><p>Pinned source revs, isolated toolchains, hash-stable outputs.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Cross-Compile Matrix</h3><p>ARM, AArch64, RISC-V, x86_64 toolchains managed automatically.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Signing &amp; Packaging</h3><p>Built-in Ed25519 signing, .eos / .img / .hex / .uf2 packaging.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>CI-First</h3><p>GitHub Actions, GitLab CI, Jenkins recipes shipped; same commands locally and in CI.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Bench &amp; Fuzz</h3><p>Integrated micro-benchmark and fuzzer drivers for kernel / app modules.</p></div><div class=\"feature-tile\"><div class=\"ft-icon\">▣</div><h3>Workspace Mode</h3><p>Multi-repo monorepos with shared toolchain caches.</p></div></div></div></section><section class=\"section section-dark\"><div class=\"container\"><div class=\"cards-grid cards-grid-2\" style=\"gap: var(--sp-6);\"><div><span class=\"overline\">Source</span><h2 style=\"margin-top: var(--sp-2);\">Open source on GitHub</h2><p>eBuild is MIT licensed and developed in the open. Issues, discussions, and pull requests welcome.</p><div class=\"repo-card\" style=\"margin-top: var(--sp-5);\"><div class=\"repo-mark\">⌥</div><div class=\"repo-meta\"><h3>embeddedos-org/ebuild</h3><p>One CLI to configure, build, package, and ship EoS firmware to any of 14 targets.</p><div class=\"repo-tags\"><span class=\"repo-tag\">Python</span><span class=\"repo-tag\">MIT</span><span class=\"repo-tag\">v0.1.0</span></div></div><a class=\"repo-cta\" href=\"https://github.com/embeddedos-org/ebuild\" rel=\"noopener noreferrer\" target=\"_blank\">Open ↗</a></div></div><div><span class=\"overline\">Where it sits</span><h2 style=\"margin-top: var(--sp-2);\">In the EoS stack</h2><p>eBuild is the highlighted layer below.</p><div class=\"stack-diagram\" style=\"margin-top: var(--sp-5);\"><svg aria-label=\"Stack diagram\" role=\"img\" viewBox=\"0 0 480 448\" xmlns=\"http://www.w3.org/2000/svg\"><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"8\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"31.0\">App layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"52\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"75.0\">UI / browser layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"96\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"119.0\">Data layer</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"140\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"163.0\">AI runtime</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"184\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"207.0\">Neural interface</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"228\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"251.0\">IPC fabric</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"272\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"295.0\">EoS kernel + HAL</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"316\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"339.0\">eos-platform profile</text><rect fill=\"rgba(148,163,184,0.10)\" height=\"36\" rx=\"8\" stroke=\"rgba(148,163,184,0.25)\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"360\"></rect><text fill=\"#94a3b8\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\" x=\"240.0\" y=\"383.0\">eBootloader</text><rect fill=\"#67e8f9\" height=\"36\" rx=\"8\" stroke=\"#67e8f9\" stroke-width=\"1.5\" width=\"440\" x=\"20\" y=\"404\"></rect><text fill=\"#0f172a\" font-family=\"Inter,system-ui,sans-serif\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" x=\"240.0\" y=\"427.0\">Build / IDE / Sim</text></svg></div></div></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"section-header\"><span class=\"overline\">Together</span><h2>Pairs well with</h2><p>Sibling components that eBuild commonly works alongside.</p></div><div class=\"cross-links\"><a class=\"cross-link\" href=\"product-eos.html\"><span class=\"cl-name\">EoS</span><span class=\"cl-blurb\">The foundation: a deterministic real-time embedded OS for everything from the bootloader up.</span></a><a class=\"cross-link\" href=\"product-eboot.html\"><span class=\"cl-name\">eBootloader</span><span class=\"cl-blurb\">Portable, secure, fail-safe boot for 24 boards across 10 architectures.</span></a><a class=\"cross-link\" href=\"product-eostudio.html\"><span class=\"cl-name\">EoStudio</span><span class=\"cl-blurb\">An IDE built for EoS: 12 editors, 30+ generators, simulator-aware debugging.</span></a></div></div></section><section aria-labelledby=\"arch-diag\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Architecture</span>\n<h2 id=\"arch-diag\">eBuild Build System Pipeline</h2>\n<p>The six-stage build pipeline from source code through eBuild configuration, CMake generation, Ninja compilation, link and packaging, to SDK/binary output, with 41 target profiles across 6 hardware categories.</p>\n</div>\n<div class=\"diagram-wrap\">\n<img alt=\"eBuild Build System Pipeline\" class=\"arch-diagram\" height=\"520\" loading=\"lazy\" src=\"img/diagrams/diag-ebuild.svg\" width=\"860\">\n</div>\n</div>\n</section>\n<section aria-labelledby=\"specs-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Technical Specifications</span>\n<h2 id=\"specs-h\">eBuild at a Glance</h2>\n</div>\n<div class=\"specs-table-wrap\">\n<table aria-label=\"eBuild at a Glance\" class=\"specs-table\"><thead><tr><th scope=\"row\">Build System Backend</th><td>CMake 3.25+ with Ninja generator (parallel builds)</td></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Supported Toolchains</th><td>GCC 13+, Clang/LLVM 17+, ARM Compiler 6, IAR EWARM, RISC-V GCC, Xtensa GCC, MinGW-w64, MSVC 2022</td></tr>\n<tr><th scope=\"row\">Target Profiles</th><td>41 pre-configured BSP profiles across 6 categories</td></tr>\n<tr><th scope=\"row\">SDK Generation</th><td>Automatic SDK generation with headers, libraries, and CMake package config</td></tr>\n<tr><th scope=\"row\">Cross-Compilation</th><td>First-class cross-compilation with sysroot management and toolchain files</td></tr>\n<tr><th scope=\"row\">Package Manager</th><td>Built-in component registry with semantic versioning and dependency resolution</td></tr>\n<tr><th scope=\"row\">CI/CD Integration</th><td>GitHub Actions, GitLab CI, Jenkins, and Buildkite native support</td></tr>\n<tr><th scope=\"row\">Incremental Builds</th><td>Ninja-based incremental builds; typical rebuild &lt; 2 s for single-file changes</td></tr>\n<tr><th scope=\"row\">Static Analysis</th><td>Integrated clang-tidy, cppcheck, and MISRA-C 2012 checker</td></tr>\n<tr><th scope=\"row\">Code Coverage</th><td>GCOV/LCOV coverage reports with HTML output</td></tr>\n<tr><th scope=\"row\">License</th><td>MIT — commercial use permitted without royalty</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"code-h\" class=\"section section-gray\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Quick Start</span>\n<h2 id=\"code-h\">Building Your First EoS Project</h2>\n</div>\n<div class=\"code-block-wrap\">\n<div class=\"code-block-header\"><span class=\"code-lang\">Shell</span><span class=\"code-copy-hint\">Quick Start</span></div>\n<pre class=\"code-block\"><code># 1. Create a new project from template\nebuild new my_sensor_node --profile cortex-m4-stm32f4\n\n# 2. Navigate to project directory\ncd my_sensor_node\n\n# 3. Configure the build (generates CMake files)\nebuild configure --release\n\n# 4. Build the project\nebuild build\n\n# 5. Run static analysis\nebuild lint --misra\n\n# 6. Flash to target hardware\nebuild flash --port /dev/ttyUSB0\n\n# 7. Generate SDK for distribution\nebuild sdk --output dist/my_sensor_node_sdk_v1.0.0.tar.gz\n\n# 8. Run unit tests (host-side)\nebuild test --host</code></pre>\n<p class=\"code-note\">eBuild auto-detects the connected debug probe (J-Link, ST-Link, CMSIS-DAP).</p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"usecases-h\" class=\"section\">\n<div class=\"container\">\n<div class=\"section-header\">\n<span class=\"overline\">Applications</span>\n<h2 id=\"usecases-h\">Where eBuild Is Used</h2>\n</div>\n<div class=\"usecases-grid\">\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🏭</div>\n<h3>Production Firmware Builds</h3>\n<p>Reproducible, hermetic firmware builds with pinned toolchain versions and cryptographic build manifests for supply-chain security.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🔄</div>\n<h3>CI/CD Pipelines</h3>\n<p>Native GitHub Actions integration enables automated build, test, and sign workflows triggered on every pull request.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">📦</div>\n<h3>SDK Distribution</h3>\n<p>Automatic SDK generation packages headers, pre-built libraries, and CMake config files for third-party integrators.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🧪</div>\n<h3>Multi-Target Testing</h3>\n<p>Build and test the same codebase against all 41 target profiles in parallel to catch hardware-specific regressions early.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🔒</div>\n<h3>MISRA Compliance</h3>\n<p>Integrated MISRA-C 2012 checker with suppression management for automotive and medical device certification workflows.</p>\n</div>\n<div class=\"usecase-card\">\n<div class=\"usecase-icon\">🌐</div>\n<h3>Multi-Platform Support</h3>\n<p>Build Windows, Linux, and macOS host tools alongside embedded firmware from a single eBuild workspace.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"section section-gray\"><div class=\"container\" style=\"text-align:center;\"><h2 style=\"margin-bottom:var(--sp-3);\">Ready to build with eBuild?</h2><p style=\"margin-bottom:var(--sp-6);\">Start with the docs, browse the source, or join the community.</p><div class=\"hero-cta-row\" style=\"justify-content:center;\"><a class=\"btn btn-primary\" href=\"documentation.html\">Read the Docs</a><a class=\"btn btn-secondary\" href=\"https://github.com/embeddedos-org/ebuild\" rel=\"noopener noreferrer\" target=\"_blank\">View Source</a><a class=\"btn btn-secondary\" href=\"contact.html\">Contact Us</a></div></div></section>\n<section class=\"product-simulation\">\n<div class=\"container\">\n<h2>Live Simulation</h2>\n<p class=\"section-desc\">Real-time visualization of core system behavior.</p>\n<div class=\"canvas-wrap\">\n<canvas aria-label=\"Live system simulation\" height=\"320\" id=\"canvas-ebuild-pipeline\" width=\"800\"></canvas>\n</div>\n</div>\n</section>\n</main><button aria-label=\"Scroll to top\" class=\"scroll-top\" type=\"button\">↑</button>";
