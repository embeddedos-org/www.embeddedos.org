---
import Base from "../../layouts/Base.astro";
const rawHead = "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.github.com; base-uri 'self'; form-action 'self'\">\n    <meta http-equiv=\"X-Content-Type-Options\" content=\"nosniff\">\n    <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\n\n<link rel=\"apple-touch-icon\" href=\"/og-image.png\">\n<title>Documentation Hub v1.0.0 - EmbeddedOS</title>\n<meta name=\"description\" content=\"Complete developer documentation for all EmbeddedOS components including EoS kernel, eBoot, EAI, ENI, EIPC, ebuild, EoSim, and more.\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.embeddedos.org/docs/\">\n<meta property=\"og:title\" content=\"Documentation Hub - EmbeddedOS\">\n<meta property=\"og:description\" content=\"Complete developer documentation for all EmbeddedOS components including EoS kernel, eBoot, EAI, ENI, EIPC, ebuild, EoSim, and more.\">\n<meta property=\"og:image\" content=\"https://www.embeddedos.org/og-image.png\">\n<meta property=\"og:image:secure_url\" content=\"https://www.embeddedos.org/og-image.png\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta property=\"og:image:alt\" content=\"EmbeddedOS — open-source embedded operating system, 13 products, 14 books, 60+ apps\">\n<meta property=\"article:publisher\" content=\"https://www.facebook.com/people/Embedded-Operating-Systems-Research-Foundation/61588978691494/\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Documentation Hub - EmbeddedOS\">\n<meta name=\"twitter:description\" content=\"Complete developer documentation for all EmbeddedOS components including EoS kernel, eBoot, EAI, ENI, EIPC, ebuild, EoSim, and more.\">\n<meta name=\"twitter:image\" content=\"https://www.embeddedos.org/og-image.png\">\n<meta name=\"twitter:site\" content=\"@EmbeddedOS_ORG\">\n<meta name=\"twitter:creator\" content=\"@EmbeddedOS_ORG\">\n<meta name=\"twitter:url\" content=\"https://www.embeddedos.org/\">\n<meta name=\"twitter:domain\" content=\"www.embeddedos.org\">\n<meta name=\"twitter:image:alt\" content=\"EmbeddedOS — open-source embedded operating system, 13 products, 14 books, 60+ apps\">\n<link rel=\"canonical\" href=\"https://www.embeddedos.org/docs/\">\n\n\n\n\n<link rel=\"me\" href=\"https://www.youtube.com/@EmbeddedOS_ORG\">\n<link rel=\"me\" href=\"https://www.linkedin.com/company/embedded-operating-systems-research-foundation\">\n<link rel=\"me\" href=\"https://x.com/EmbeddedOS_ORG\">\n<link rel=\"me\" href=\"https://www.facebook.com/people/Embedded-Operating-Systems-Research-Foundation/61588978691494/\">";
const content = "<div class=\"content-wrapper\" style=\"max-width:1100px;margin:0 auto;padding:3rem 2rem\">\n<h1>EmbeddedOS Documentation Hub <span class=\"version-badge\">v1.0.0</span></h1>\n<p class=\"section-subtitle\" style=\"color:var(--text-secondary);font-size:1.1rem;margin-bottom:2rem\">Complete developer documentation for all EmbeddedOS components. Each page includes full API signatures, parameter tables, return values, and working code examples.</p>\n\n<h2>Core Platform</h2>\n<div class=\"product-grid\">\n<div class=\"product-card card-eos\"><div class=\"card-icon\">EoS</div><h3>EoS Kernel &amp; HAL</h3>\n<p>Modular RTOS kernel with HAL (GPIO, UART, SPI, I2C, Timer), multicore framework, power management, networking (TCP/UDP, HTTP, MQTT, mDNS), crypto, OTA, sensors, motor control, filesystem, debug (GDB stub, coredump), driver model, service manager, and structured logging.</p>\n<div class=\"card-tags\"><span class=\"badge badge-blue\">14 Modules</span><span class=\"badge badge-green\">200+ Functions</span><span class=\"badge badge-orange\">98 KB</span></div>\n<div class=\"card-buttons\"><a href=\"eos.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n\n<div class=\"product-card card-eboot\"><div class=\"card-icon\">eBt</div><h3>eBoot Bootloader</h3>\n<p>Secure A/B bootloader with CRC-protected boot control block, dual-copy redundancy, slot management, image verification, rollback support, structured boot log, recovery mode, and factory reset. Full porting guide included.</p>\n<div class=\"card-tags\"><span class=\"badge badge-orange\">Bootloader</span><span class=\"badge badge-cyan\">A/B Slots</span><span class=\"badge badge-green\">32 KB</span></div>\n<div class=\"card-buttons\"><a href=\"eboot.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n</div>\n\n<h2>AI &amp; Neural Interface</h2>\n<div class=\"product-grid\">\n<div class=\"product-card card-eai\"><div class=\"card-icon\">EAI</div><h3>EAI Framework</h3>\n<p>Embedded AI for on-device LLM inference with tool-calling ReAct agents, model registry (8+ curated models from 33M to 7B params), runtime configuration, key-value memory persistence, and complete agent loop walkthrough.</p>\n<div class=\"card-tags\"><span class=\"badge badge-purple\">AI Agents</span><span class=\"badge badge-green\">LLM Models</span><span class=\"badge badge-blue\">37 KB</span></div>\n<div class=\"card-buttons\"><a href=\"eai.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n\n<div class=\"product-card card-eni\"><div class=\"card-icon\">ENI</div><h3>ENI Neural Interface</h3>\n<p>Neural interface framework with pluggable provider contracts, structured events (intents, features, raw), safety policy engine (allow/deny/confirm), signal filtering, normalization, Neuralink BCI adapter (1024 channels, 30kHz), calibration workflow, and custom provider implementation guide.</p>\n<div class=\"card-tags\"><span class=\"badge badge-pink\">BCI</span><span class=\"badge badge-orange\">Neuralink</span><span class=\"badge badge-green\">34 KB</span></div>\n<div class=\"card-buttons\"><a href=\"eni.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n</div>\n\n<h2>Communication &amp; Build</h2>\n<div class=\"product-grid\">\n<div class=\"product-card card-eipc\"><div class=\"card-icon\">IPC</div><h3>EIPC Protocol</h3>\n<p>Inter-process communication with length-prefixed binary framing, JSON payloads, HMAC-SHA256 authentication, TCP/Unix socket transport. Complete C SDK and Go server/client with frame format diagram and security setup guide.</p>\n<div class=\"card-tags\"><span class=\"badge badge-cyan\">IPC</span><span class=\"badge badge-orange\">HMAC</span><span class=\"badge badge-green\">24 KB</span></div>\n<div class=\"card-buttons\"><a href=\"eipc.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n\n<div class=\"product-card card-ebuild\"><div class=\"card-icon\">eBd</div><h3>ebuild CLI</h3>\n<p>Unified build system with project scaffolding (init), cross-compilation (build), flash programming, serial monitoring, unit testing with coverage, SDK management, and build.yaml configuration reference. Supports 9+ platforms.</p>\n<div class=\"card-tags\"><span class=\"badge badge-blue\">Build</span><span class=\"badge badge-purple\">CLI</span><span class=\"badge badge-green\">14 KB</span></div>\n<div class=\"card-buttons\"><a href=\"ebuild.html\" class=\"btn btn-sm btn-primary\">CLI Reference</a></div></div>\n</div>\n\n<h2>Tools &amp; Simulation</h2>\n<div class=\"product-grid\">\n<div class=\"product-card card-eosim\"><div class=\"card-icon\">Sim</div><h3>EoSim Simulator</h3>\n<p>Multi-architecture simulation with native Python engine, QEMU binary emulation, Renode, and HIL bridge. 63 platform definitions across 12 architectures, 7 simulation engines, GPIO/UART/Timer register maps, and GUI dashboard.</p>\n<div class=\"card-tags\"><span class=\"badge badge-green\">Simulator</span><span class=\"badge badge-blue\">63 Platforms</span><span class=\"badge badge-orange\">7 Engines</span></div>\n<div class=\"card-buttons\"><a href=\"eosim.html\" class=\"btn btn-sm btn-primary\">CLI Reference</a></div></div>\n\n<div class=\"product-card card-eosuite\"><div class=\"card-icon\">Apps</div><h3>eApps — Unified App Store</h3>\n<p><strong>60+ apps across all platforms:</strong> 40+ native C/LVGL apps, 11 browser/editor extensions (Chrome, Firefox, VS Code, JetBrains, Obsidian, Slack), 4 desktop apps (eOffice, EoStudio, EoSim, eBrowser), 5 Flutter mobile apps. Hosted at <a href=\"https://www.embeddedos.org/eApps/\" style=\"color:var(--blue)\" target=\"_blank\" rel=\"noopener\">www.embeddedos.org/eApps/</a>.</p>\n<div class=\"card-tags\"><span class=\"badge badge-purple\">60+ Apps</span><span class=\"badge badge-cyan\">All Platforms</span><span class=\"badge badge-green\">App Store</span></div>\n<div class=\"card-buttons\"><a href=\"https://www.embeddedos.org/eApps/\" class=\"btn btn-sm btn-primary\" target=\"_blank\" rel=\"noopener\">🏪 App Store</a><a href=\"eosuite.html\" class=\"btn btn-sm btn-outline\">Docs</a></div></div>\n</div>\n\n<h2>Database, Browser &amp; Office</h2>\n<div class=\"product-grid\">\n<div class=\"product-card\" style=\"border-top:3px solid var(--green)\"><div class=\"card-icon\">eDB</div><h3>eDB Database</h3>\n<p>Unified multi-model database combining SQL, Document/NoSQL, and Key-Value storage. Built on SQLite with zero dependencies. REST API via FastAPI, JWT auth, RBAC, AES-256-GCM encryption, full-text search, and eBot AI natural language interface.</p>\n<div class=\"card-tags\"><span class=\"badge badge-green\">Multi-Model</span><span class=\"badge badge-blue\">REST API</span><span class=\"badge badge-purple\">Python</span></div>\n<div class=\"card-buttons\"><a href=\"edb.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n\n<div class=\"product-card\" style=\"border-top:3px solid var(--cyan)\"><div class=\"card-icon\">eBw</div><h3>eBrowser Browser</h3>\n<p>Lightweight web browser engine for embedded/IoT devices. HTML5/CSS rendering, modular architecture with rendering/network/input layers, platform abstraction for SDL2, EoS, and WASM. 130+ test cases across 7 suites.</p>\n<div class=\"card-tags\"><span class=\"badge badge-cyan\">Browser</span><span class=\"badge badge-orange\">HTML5/CSS</span><span class=\"badge badge-blue\">C/C++</span></div>\n<div class=\"card-buttons\"><a href=\"ebrowser.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n\n<div class=\"product-card\" style=\"border-top:3px solid var(--orange)\"><div class=\"card-icon\">eOf</div><h3>eOffice Suite</h3>\n<p>AI-powered office suite with 11 apps: eDocs, eSheets, eSlides, eNotes, eMail, eDrive, eConnect, eForms, eSway, ePlanner. Powered by eBot AI for text rewriting, formula suggestions, and slide generation. Browser, Electron, Docker deployment.</p>\n<div class=\"card-tags\"><span class=\"badge badge-orange\">11 Apps</span><span class=\"badge badge-purple\">eBot AI</span><span class=\"badge badge-blue\">TypeScript</span></div>\n<div class=\"card-buttons\"><a href=\"eoffice.html\" class=\"btn btn-sm btn-primary\">API Reference</a></div></div>\n</div>\n\n<h2 style=\"margin-top:3rem\">Quick Reference</h2>\n<div class=\"struct-card\"><table>\n<tbody><tr style=\"font-weight:bold;color:var(--cyan)\"><td>Component</td><td>Language</td><td>Headers / Entry</td><td>Key Functions</td></tr>\n<tr><td>EoS HAL</td><td>C</td><td><code>&lt;eos/hal.h&gt;</code></td><td>eos_gpio_init, eos_uart_write, eos_spi_transfer, eos_i2c_read_reg</td></tr>\n<tr><td>EoS Kernel</td><td>C</td><td><code>&lt;eos/kernel.h&gt;</code></td><td>eos_task_create, eos_mutex_lock, eos_queue_send, eos_swtimer_create</td></tr>\n<tr><td>EoS Power</td><td>C</td><td><code>&lt;eos/power.h&gt;</code></td><td>eos_power_enter_mode, eos_power_get_battery_pct</td></tr>\n<tr><td>EoS Net</td><td>C</td><td><code>&lt;eos/net.h&gt;</code></td><td>eos_net_socket, eos_http_get, eos_mqtt_connect</td></tr>\n<tr><td>eBoot</td><td>C</td><td><code>eos_bootctl.h</code></td><td>eos_bootctl_load, eos_bootctl_confirm, eos_slot_scan_all</td></tr>\n<tr><td>EAI</td><td>C</td><td><code>&lt;eai/tool.h&gt;</code></td><td>eai_tool_register, eai_min_agent_run, eai_model_find_best_fit</td></tr>\n<tr><td>ENI</td><td>C</td><td><code>&lt;eni/event.h&gt;</code></td><td>eni_provider_poll, eni_policy_evaluate, eni_neuralink_init</td></tr>\n<tr><td>EIPC</td><td>C/Go</td><td><code>&lt;eipc.h&gt;</code></td><td>eipc_client_connect, eipc_client_send_intent, eipc_hmac_sign</td></tr>\n<tr><td>ebuild</td><td>Go</td><td>CLI</td><td>ebuild init, build, flash, monitor, test</td></tr>\n<tr><td>EoSim</td><td>Python</td><td>CLI</td><td>eosim list, search, run, stats, gui</td></tr>\n<tr><td>eApps</td><td>C + LVGL</td><td><code>eapps/registry.h</code></td><td>43 apps: Snake, eCalc, eSSH, eBot, eGuard</td></tr>\n<tr><td>eDB</td><td>Python</td><td><code>edb.core</code></td><td>SQL, Document, Key-Value, REST API, eBot AI</td></tr>\n<tr><td>eBrowser</td><td>C/C++</td><td><code>ebrowser.h</code></td><td>eb_create, eb_navigate, eb_run, eb_destroy</td></tr>\n<tr><td>eOffice</td><td>TypeScript</td><td>React + Node.js</td><td>11 apps: eDocs, eSheets, eSlides, eBot AI</td></tr>\n</tbody></table></div>\n\n</div>\n\n\n<div id=\"eos-search-overlay\" class=\"search-overlay\" hidden=\"\">\n<div class=\"search-modal\">\n<div class=\"search-header\">\n<span class=\"search-icon\">🔍</span>\n<input type=\"text\" id=\"eos-search-input\" class=\"search-input\" placeholder=\"Search EmbeddedOS docs...\" autocomplete=\"off\">\n<kbd class=\"search-kbd\">Esc</kbd>\n</div>\n<ul id=\"eos-search-results\" class=\"search-results\"></ul>\n</div>\n</div>";
---
<Base lang="en" legacy={true} cssHref="/style.css" bodyClass="" rawHead={rawHead}>
<Fragment set:html={content} />
<script is:inline set:html={"\nconst EosSearch={pages:[\n{t:'Home',u:'../index.html',d:'The Operating System for Every Device'},\n{t:'Get Started',u:'../getting-started.html',d:'Choose your path and get running in minutes'},\n{t:'Documentation Hub',u:'index.html',d:'Complete developer documentation for all components'},\n{t:'Platform Flow',u:'../flow.html',d:'EoS platform build and deployment flow'},\n{t:'Kids Guide',u:'../kids.html',d:'Welcome young explorers to EmbeddedOS'},\n{t:'Hardware Lab',u:'../hardware-lab.html',d:'Pick your board and get EoS running on real hardware'},\n{t:'App Store',u:'https://www.embeddedos.org/eApps/',d:'60+ apps across all platforms'},\n{t:'EoS Kernel',u:'eos.html',d:'Modular RTOS kernel with HAL and multicore framework'},\n{t:'eBoot Bootloader',u:'eboot.html',d:'Secure A/B bootloader with verified boot chain'},\n{t:'ebuild CLI',u:'ebuild.html',d:'Unified build system with cross-compilation'},\n{t:'EIPC Protocol',u:'eipc.html',d:'Secure real-time IPC framework'},\n{t:'EAI Framework',u:'eai.html',d:'Embedded AI for on-device LLM inference'},\n{t:'ENI Neural Interface',u:'eni.html',d:'Brain-computer interface framework'},\n{t:'EoSim Simulator',u:'eosim.html',d:'Multi-architecture simulation platform'},\n{t:'EoStudio',u:'eostudio.html',d:'Unified design suite with 12 editors'},\n{t:'eApps Suite',u:'eosuite.html',d:'60+ apps for all platforms'},\n{t:'eDB Database',u:'edb.html',d:'Unified multi-model database'},\n{t:'eBrowser Browser',u:'ebrowser.html',d:'Lightweight web browser engine'},\n{t:'eOffice Suite',u:'eoffice.html',d:'AI-powered office suite with 11 apps'}\n],\noverlay:null,input:null,results:null,\ninit(){this.overlay=document.getElementById('eos-search-overlay');this.input=document.getElementById('eos-search-input');this.results=document.getElementById('eos-search-results')},\nopen(){if(!this.overlay)this.init();this.overlay.hidden=false;this.input.value='';this.render(this.pages);this.input.focus()},\nclose(){if(this.overlay)this.overlay.hidden=true},\nrender(items){this.results.innerHTML=items.map(p=>'<li class=\"search-result-item\"><a href=\"'+p.u+'\"><strong>'+p.t+'</strong><span>'+p.d+'</span></a></li>').join('')||'<li class=\"search-result-item\" style=\"color:var(--text-secondary)\">No results found.</li>'},\nfilter(q){const l=q.toLowerCase();this.render(this.pages.filter(p=>p.t.toLowerCase().includes(l)||p.d.toLowerCase().includes(l)))}\n};\ndocument.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();EosSearch.open()}if(e.key==='Escape')EosSearch.close()});\ndocument.addEventListener('DOMContentLoaded',()=>{const i=document.getElementById('eos-search-input');if(i)i.addEventListener('input',e=>EosSearch.filter(e.target.value));const o=document.getElementById('eos-search-overlay');if(o)o.addEventListener('click',e=>{if(e.target===o)EosSearch.close()})});\n"} />
</Base>
