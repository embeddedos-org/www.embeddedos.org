---
import Base from "../layouts/Base.astro";
const rawHead = "<title>Fundraising — EmbeddedOS Foundation</title>\n<meta content=\"Support the EmbeddedOS Foundation. 100% of donations fund open-source OS development, free certifications, and education for embedded engineers worldwide.\" name=\"description\">\n<meta content=\"Fundraising — EmbeddedOS Foundation\" property=\"og:title\">\n<meta content=\"Support the EmbeddedOS Foundation. 100% of donations fund open-source OS development, free certifications, and education for embedded engineers worldwide.\" property=\"og:description\">\n<meta content=\"website\" property=\"og:type\">\n<meta content=\"summary_large_image\" name=\"twitter:card\">\n<meta content=\"Fundraising — EmbeddedOS Foundation\" name=\"twitter:title\">\n<meta content=\"Support the EmbeddedOS Foundation. 100% of donations fund open-source OS development, free certifications, and education for embedded engineers worldwide.\" name=\"twitter:description\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n\n<main id=\"main-content\">\n<div class=\"page-header\">\n<div class=\"page-header__bg\"></div>\n<div class=\"container\">\n<nav aria-label=\"Breadcrumb\" class=\"breadcrumb\">\n<a href=\"index.html\">Home</a>\n<span aria-hidden=\"true\">›</span>\n<span aria-current=\"page\">Fundraising</span>\n</nav>\n<h1>Support the <span class=\"grad\">EmbeddedOS Mission</span></h1>\n<p class=\"page-header__sub\">Your donation funds open-source OS development, free certifications, and education for embedded engineers worldwide. 100% of every dollar goes to the mission — 0% platform fees via Zeffy.</p>\n</div>\n</div>\n<!-- Campaign Progress -->\n<section class=\"section section--surface\" style=\"padding:4rem 0;\">\n<div class=\"container\" style=\"max-width:900px;\">\n<div class=\"mkt-campaign-progress\">\n<div class=\"mkt-campaign-progress__header\">\n<div>\n<div class=\"mkt-campaign-progress__raised\">$85,000 <span>raised</span></div>\n<div class=\"mkt-campaign-progress__goal\">of $250,000 goal · 2025 Campaign</div>\n</div>\n<div class=\"mkt-campaign-progress__pct\">34%</div>\n</div>\n<div class=\"mkt-progress-bar mkt-progress-bar--lg\">\n<div class=\"mkt-progress-fill\" style=\"width:34%\">\n<div class=\"mkt-progress-glow\"></div>\n</div>\n</div>\n<div class=\"mkt-campaign-progress__stats\">\n<div class=\"mkt-campaign-stat\"><strong>347</strong><span>Donors</span></div>\n<div class=\"mkt-campaign-stat\"><strong>$165,000</strong><span>Still needed</span></div>\n<div class=\"mkt-campaign-stat\"><strong>Dec 31</strong><span>Campaign ends</span></div>\n<div class=\"mkt-campaign-stat\"><strong>0%</strong><span>Platform fees</span></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Zeffy Donation Form Embed -->\n<section class=\"section section--dark\" id=\"donate-form\" style=\"padding:4rem 0;\">\n<div class=\"container\" style=\"max-width:900px;\">\n<div style=\"text-align:center;margin-bottom:2rem;\">\n<span class=\"section__eyebrow\">Donate Now</span>\n<h2 class=\"section__title\" style=\"font-size:clamp(1.6rem,3vw,2.4rem);\">Every Dollar Makes a Difference</h2>\n<p class=\"section__sub\" style=\"margin:0 auto 1rem;\">Secure payment form. Tax-deductible donation receipt sent automatically.</p>\n</div>\n<div class=\"mkt-zeffy-embed\">\n<iframe allow=\"payment\" allowpaymentrequest=\"\" loading=\"lazy\" src=\"https://www.zeffy.com/embed/donation-form/donate-to-change-lives-17596\" style=\"width:100%;min-height:680px;border:none;border-radius:16px;\" title=\"Donation Form — EmbeddedOS Foundation\">\n</iframe>\n</div>\n<p class=\"mkt-zeffy-note\">\n        🔒 Secure payment &nbsp;·&nbsp; 0% platform fees &nbsp;·&nbsp; SSL encrypted &nbsp;·&nbsp; Tax receipt by email &nbsp;·&nbsp;\n        <a href=\"https://www.zeffy.com/en-US/donation-form/donate-to-change-lives-17596\" rel=\"noopener noreferrer\" target=\"_blank\">Open full page →</a>\n</p>\n</div>\n</section>\n<!-- Impact Tiers -->\n<section class=\"section section--surface\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">Your Impact</span>\n<h2 class=\"section__title\">What Your Donation Funds</h2>\n</div>\n<div class=\"mkt-impact-tiers\">\n<div class=\"mkt-impact-tier\">\n<div class=\"mkt-impact-tier__amount\">$25</div>\n<div class=\"mkt-impact-tier__icon\">📚</div>\n<h3>Supporter</h3>\n<p>Funds one month of documentation hosting and keeps the developer wiki running for 500+ engineers.</p>\n<a class=\"btn-secondary\" href=\"#donate-form\" style=\"margin-top:auto;\">Give $25</a>\n</div>\n<div class=\"mkt-impact-tier mkt-impact-tier--featured\">\n<div class=\"mkt-impact-tier__badge\">Most Popular</div>\n<div class=\"mkt-impact-tier__amount\">$100</div>\n<div class=\"mkt-impact-tier__icon\">🎓</div>\n<h3>Educator</h3>\n<p>Sponsors one free certification exam for an engineer in a developing nation who cannot afford it.</p>\n<a class=\"btn-primary\" href=\"#donate-form\" style=\"margin-top:auto;\">Give $100</a>\n</div>\n<div class=\"mkt-impact-tier\">\n<div class=\"mkt-impact-tier__amount\">$500</div>\n<div class=\"mkt-impact-tier__icon\">⚡</div>\n<h3>Builder</h3>\n<p>Funds one week of a core developer's time working on the EoS kernel or EAI inference engine.</p>\n<a class=\"btn-secondary\" href=\"#donate-form\" style=\"margin-top:auto;\">Give $500</a>\n</div>\n<div class=\"mkt-impact-tier\">\n<div class=\"mkt-impact-tier__amount\">$2,500</div>\n<div class=\"mkt-impact-tier__icon\">🚀</div>\n<h3>Innovator</h3>\n<p>Funds a full month of infrastructure costs: CI/CD, servers, security audits, and release pipelines.</p>\n<a class=\"btn-secondary\" href=\"#donate-form\" style=\"margin-top:auto;\">Give $2,500</a>\n</div>\n</div>\n</div>\n</section>\n<!-- Why Donate -->\n<section class=\"section section--dark\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div class=\"mkt-why-donate\">\n<div class=\"mkt-why-donate__text\">\n<span class=\"section__eyebrow\">Why Donate</span>\n<h2 class=\"section__title\">The Problem We're Solving</h2>\n<p>Proprietary embedded operating systems like VxWorks and QNX cost $50,000–$500,000 per deployment in licensing fees. This locks out:</p>\n<ul class=\"mkt-why-list\">\n<li>🎓 University researchers and students</li>\n<li>🌍 Engineers in developing nations</li>\n<li>🚀 Early-stage startups building hardware</li>\n<li>🏥 Non-profit medical device projects</li>\n<li>🛰 Open-source space and robotics projects</li>\n</ul>\n<p style=\"margin-top:1.5rem;\">EmbeddedOS Foundation eliminates this barrier. Every product we build is free, open-source, and production-grade. Your donation makes this possible.</p>\n</div>\n<div class=\"mkt-why-donate__stats\">\n<div class=\"mkt-why-stat\">\n<div class=\"mkt-why-stat__num\">$500K</div>\n<div class=\"mkt-why-stat__label\">Avg. annual licensing cost saved per enterprise deployment</div>\n</div>\n<div class=\"mkt-why-stat\">\n<div class=\"mkt-why-stat__num\">10,000+</div>\n<div class=\"mkt-why-stat__label\">Engineers who will benefit from free certifications by 2026</div>\n</div>\n<div class=\"mkt-why-stat\">\n<div class=\"mkt-why-stat__num\">14</div>\n<div class=\"mkt-why-stat__label\">Open-source products replacing proprietary alternatives</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Sponsor CTA -->\n<section class=\"mkt-fundraise-banner\" style=\"padding:5rem 0;\">\n<div class=\"mkt-fundraise-banner__bg\"></div>\n<div class=\"container mkt-fundraise-banner__inner\">\n<div class=\"mkt-fundraise-banner__text\">\n<h2>Corporate Sponsor?</h2>\n<p>Platinum, Gold, and Silver sponsorship tiers available. Get your logo on every page, speaking slots at our annual summit, and early access to all releases.</p>\n</div>\n<div class=\"mkt-fundraise-banner__actions\">\n<a class=\"btn-primary\" href=\"sponsors.html\">View Sponsorship Tiers →</a>\n<a class=\"btn-secondary\" href=\"contact.html\">Contact Us</a>\n</div>\n</div>\n</section>\n</main>";
---
<Base lang="en" legacy={false} cssHref="/css/style.v7.css" bodyClass="page-fundraising" rawHead={rawHead}>
<Fragment set:html={content} />
<script is:inline src="js/main.js" defer></script>
</Base>
