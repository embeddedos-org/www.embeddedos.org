---
import Base from "../layouts/Base.astro";
const rawHead = "<title>Organization | EmbeddedOS</title>\n  <meta name=\"description\" content=\"EmbeddedOS Foundation organization focus, governance model, and community structure.\">";
const content = "<a href=\"#main-content\" class=\"skip-to-content\">Skip to content</a>\n\n\n\n<section class=\"hero\" id=\"main-content\" role=\"main\">\n  <div class=\"hero-content\">\n    <div class=\"hero-text\">\n      <h1>Organization</h1>\n      <p class=\"subtitle\">A foundation-driven, open-source organization with clear focus areas, transparent governance, and community-first programs.</p>\n      <div class=\"hero-buttons\">\n        <a href=\"donate.html\" class=\"btn btn-primary\">Donate</a>\n        <a href=\"careers.html\" class=\"btn btn-secondary\">Careers</a>\n        <a href=\"projects.html\" class=\"btn btn-outline\">Projects</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\">\n  <h2 class=\"section-title\">Focus Areas</h2>\n  <p class=\"section-subtitle\">Grouped by impact and ecosystem value</p>\n  <div class=\"product-grid\">\n    <div class=\"product-card\"><h3>Software Foundation</h3><p>Open-source governance inspired by Apache and OSI: standards, neutral stewardship, and long-term maintainability.</p></div>\n    <div class=\"product-card\"><h3>Open Knowledge</h3><p>Creative Commons and Internet Archive style publishing: open docs, reusable content, and preservation of technical knowledge.</p></div>\n    <div class=\"product-card\"><h3>Research &amp; Publications</h3><p>Publication-quality technical outputs with reproducible methods and transparent benchmarks.</p></div>\n    <div class=\"product-card\"><h3>Policy &amp; Advocacy</h3><p>Public-interest communication model inspired by EFF: clear policy explainers and action pathways.</p></div>\n    <div class=\"product-card\"><h3>AI for Social Impact</h3><p>Responsible AI programs and measurable impact inspired by Mozilla Foundation and AI for Good approaches.</p></div>\n    <div class=\"product-card\"><h3>Inclusion &amp; Youth Programs</h3><p>Accessible onboarding and volunteer pathways influenced by Code.org and Women Who Code community models.</p></div>\n  </div>\n</section>\n\n<section class=\"section-full section-alt\">\n  <div class=\"section\">\n    <h2 class=\"section-title\">Program Paths</h2>\n    <p class=\"section-subtitle\">Find the right entry point quickly</p>\n    <div class=\"product-grid\">\n      <div class=\"product-card\"><h3>Donation</h3><p>Support mission work and ecosystem development.</p><a href=\"donate.html\" class=\"btn btn-sm btn-primary\">Open Donate</a></div>\n      <div class=\"product-card\"><h3>Careers</h3><p>Join engineering, research, programs, or operations.</p><a href=\"careers.html\" class=\"btn btn-sm btn-primary\">Open Careers</a></div>\n      <div class=\"product-card\"><h3>Products &amp; Projects</h3><p>Explore active products, ecosystem maps, and roadmaps.</p><a href=\"projects.html\" class=\"btn btn-sm btn-primary\">Open Projects</a></div>\n      <div class=\"product-card\"><h3>Vision</h3><p>Understand long-term goals and strategic direction.</p><a href=\"vision.html\" class=\"btn btn-sm btn-primary\">Open Vision</a></div>\n    </div>\n  </div>\n</section>";
---
<Base lang="en" legacy={true} cssHref="/style.css" bodyClass="" rawHead={rawHead}>
<Fragment set:html={content} />

</Base>
