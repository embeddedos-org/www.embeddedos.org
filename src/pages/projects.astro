---
import Base from "../layouts/Base.astro";
const rawHead = "<title>Projects | EmbeddedOS</title>\n  <meta name=\"description\" content=\"EmbeddedOS projects and products grouped clearly by technical and community tracks.\">";
const content = "<a href=\"#main-content\" class=\"skip-to-content\">Skip to content</a>\n\n\n<section class=\"hero\" id=\"main-content\" role=\"main\">\n  <div class=\"hero-content\">\n    <div class=\"hero-text\">\n      <h1>Projects</h1>\n      <p class=\"subtitle\">All work is grouped into product stack, research tracks, and community programs so visitors can navigate quickly.</p>\n      <div class=\"hero-buttons\">\n        <a href=\"products.html\" class=\"btn btn-primary\">Product Stack</a>\n        <a href=\"research.html\" class=\"btn btn-secondary\">Research</a>\n        <a href=\"events.html\" class=\"btn btn-outline\">Events</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\">\n  <h2 class=\"section-title\">Technical Tracks</h2>\n  <div class=\"product-grid\">\n    <div class=\"product-card\"><h3>Core Products</h3><p>Kernel, AI, IPC, build, simulation, database, browser, office, and platform components.</p><a href=\"products.html\" class=\"btn btn-sm btn-primary\">Open Products</a></div>\n    <div class=\"product-card\"><h3>Ecosystem Map</h3><p>Cross-component architecture and integration view.</p><a href=\"ecosystem.html\" class=\"btn btn-sm btn-primary\">Open Ecosystem</a></div>\n    <div class=\"product-card\"><h3>Documentation</h3><p>Guides, references, and implementation details for contributors and users.</p><a href=\"documentation.html\" class=\"btn btn-sm btn-primary\">Open Docs</a></div>\n  </div>\n</section>\n\n<section class=\"section-full section-alt\">\n  <div class=\"section\">\n    <h2 class=\"section-title\">Community Tracks</h2>\n    <div class=\"product-grid\">\n      <div class=\"product-card\"><h3>Publications</h3><p>Research papers and technical reports.</p><a href=\"resources.html\" class=\"btn btn-sm btn-outline\">Open Publications</a></div>\n      <div class=\"product-card\"><h3>Programs</h3><p>Membership, certifications, internships, and learning pathways.</p><a href=\"membership.html\" class=\"btn btn-sm btn-outline\">Open Programs</a></div>\n      <div class=\"product-card\"><h3>Funding</h3><p>Donations and sponsorship channels supporting open work.</p><a href=\"fundraising.html\" class=\"btn btn-sm btn-outline\">Open Funding</a></div>\n    </div>\n  </div>\n</section>";
---
<Base lang="en" legacy={true} cssHref="/style.css" bodyClass="" rawHead={rawHead}>
<Fragment set:html={content} />

</Base>
