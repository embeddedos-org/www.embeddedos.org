---
import Base from "../layouts/Base.astro";
const rawHead = "<title>Sponsors &amp; Partners — EmbeddedOS Foundation</title>\n<meta content=\"Partner with EmbeddedOS Foundation. Platinum, Gold, Silver, and Community sponsorship tiers available. Tax-deductible. Access to talent, roadmap influence, and brand visibility.\" name=\"description\">\n<meta content=\"Sponsors &amp; Partners — EmbeddedOS Foundation\" property=\"og:title\">\n<meta content=\"Partner with EmbeddedOS Foundation. Platinum, Gold, Silver, and Community sponsorship tiers available. Tax-deductible. Access to talent, roadmap influence, and brand visibility.\" property=\"og:description\">\n<meta content=\"website\" property=\"og:type\">\n<meta content=\"summary_large_image\" name=\"twitter:card\">\n<meta content=\"Sponsors &amp; Partners — EmbeddedOS Foundation\" name=\"twitter:title\">\n<meta content=\"Partner with EmbeddedOS Foundation. Platinum, Gold, Silver, and Community sponsorship tiers available. Tax-deductible. Access to talent, roadmap influence, and brand visibility.\" name=\"twitter:description\">";
const content = "<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n\n<main id=\"main-content\">\n<div class=\"page-header\">\n<div class=\"page-header__bg\"></div>\n<div class=\"container\">\n<nav aria-label=\"Breadcrumb\" class=\"breadcrumb\">\n<a href=\"index.html\">Home</a>\n<span aria-hidden=\"true\">›</span>\n<span aria-current=\"page\">Sponsors &amp; Partners</span>\n</nav>\n<h1>Partner with the <span class=\"grad\">EmbeddedOS Foundation</span></h1>\n<p class=\"page-header__sub\">Join leading companies supporting open-source embedded systems. Your sponsorship funds the infrastructure, developers, and education programs that the entire embedded industry depends on.</p>\n</div>\n</div>\n<!-- Why Sponsor -->\n<section class=\"section section--surface\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">Why Sponsor</span>\n<h2 class=\"section__title\">Invest in the Embedded Ecosystem</h2>\n<p class=\"section__sub\" style=\"margin:0 auto;\">Sponsoring EmbeddedOS Foundation gives your company direct access to the embedded engineering community, talent pipeline, and open-source innovation.</p>\n</div>\n<div class=\"mkt-sponsor-why-grid\">\n<div class=\"mkt-sponsor-why-card\">\n<div class=\"mkt-sponsor-why-card__icon\">👥</div>\n<h3>Talent Pipeline</h3>\n<p>Access 500+ certified engineers and interns trained on the EoS stack. First look at top talent before they hit the job market.</p>\n</div>\n<div class=\"mkt-sponsor-why-card\">\n<div class=\"mkt-sponsor-why-card__icon\">🔬</div>\n<h3>R&amp;D Collaboration</h3>\n<p>Co-develop features, influence the roadmap, and get early access to new products like EAI and ENI before public release.</p>\n</div>\n<div class=\"mkt-sponsor-why-card\">\n<div class=\"mkt-sponsor-why-card__icon\">📣</div>\n<h3>Brand Visibility</h3>\n<p>Logo placement on all pages, newsletter (2,000+ subscribers), GitHub repos, and our annual EmbeddedOS Summit.</p>\n</div>\n<div class=\"mkt-sponsor-why-card\">\n<div class=\"mkt-sponsor-why-card__icon\">🌍</div>\n<h3>ESG &amp; CSR Impact</h3>\n<p>Demonstrate commitment to open-source, education, and democratising technology access in developing nations.</p>\n</div>\n<div class=\"mkt-sponsor-why-card\">\n<div class=\"mkt-sponsor-why-card__icon\">🛡</div>\n<h3>Security Influence</h3>\n<p>Shape the security architecture of embedded systems used in medical devices, automotive, and aerospace.</p>\n</div>\n<div class=\"mkt-sponsor-why-card\">\n<div class=\"mkt-sponsor-why-card__icon\">💰</div>\n<h3>Tax Deductible</h3>\n<p>All sponsorships are tax-deductible donations to a 501(c)(3) non-profit. Receive a formal tax receipt.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Sponsorship Tiers -->\n<section class=\"section section--dark\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">Sponsorship Tiers</span>\n<h2 class=\"section__title\">Choose Your Level of Impact</h2>\n</div>\n<div class=\"mkt-sponsor-tiers\">\n<div class=\"mkt-sponsor-tier mkt-sponsor-tier--platinum\">\n<div class=\"mkt-sponsor-tier__badge\">🏆 Platinum</div>\n<div class=\"mkt-sponsor-tier__price\">$50,000 <span>/year</span></div>\n<ul class=\"mkt-sponsor-tier__benefits\">\n<li>✅ Logo on every page (top position)</li>\n<li>✅ Keynote slot at EmbeddedOS Summit</li>\n<li>✅ Dedicated blog post + press release</li>\n<li>✅ 10 free corporate memberships</li>\n<li>✅ Roadmap advisory board seat</li>\n<li>✅ Co-branded certification track</li>\n<li>✅ Monthly 1:1 with core team</li>\n<li>✅ First access to all new products</li>\n</ul>\n<a class=\"btn-primary\" href=\"contact.html?tier=platinum\" style=\"width:100%;justify-content:center;\">Apply for Platinum →</a>\n</div>\n<div class=\"mkt-sponsor-tier mkt-sponsor-tier--gold\">\n<div class=\"mkt-sponsor-tier__badge\">🥇 Gold</div>\n<div class=\"mkt-sponsor-tier__price\">$25,000 <span>/year</span></div>\n<ul class=\"mkt-sponsor-tier__benefits\">\n<li>✅ Logo on homepage + sponsors page</li>\n<li>✅ Speaking slot at EmbeddedOS Summit</li>\n<li>✅ Featured in quarterly newsletter</li>\n<li>✅ 5 free corporate memberships</li>\n<li>✅ Roadmap input sessions (quarterly)</li>\n<li>✅ Early access to new products</li>\n<li>✅ Quarterly progress report</li>\n</ul>\n<a class=\"btn-primary\" href=\"contact.html?tier=gold\" style=\"width:100%;justify-content:center;\">Apply for Gold →</a>\n</div>\n<div class=\"mkt-sponsor-tier mkt-sponsor-tier--silver\">\n<div class=\"mkt-sponsor-tier__badge\">🥈 Silver</div>\n<div class=\"mkt-sponsor-tier__price\">$10,000 <span>/year</span></div>\n<ul class=\"mkt-sponsor-tier__benefits\">\n<li>✅ Logo on sponsors page</li>\n<li>✅ Mention in annual report</li>\n<li>✅ 2 free corporate memberships</li>\n<li>✅ Access to talent pool</li>\n<li>✅ Annual progress report</li>\n</ul>\n<a class=\"btn-secondary\" href=\"contact.html?tier=silver\" style=\"width:100%;justify-content:center;\">Apply for Silver →</a>\n</div>\n<div class=\"mkt-sponsor-tier mkt-sponsor-tier--community\">\n<div class=\"mkt-sponsor-tier__badge\">🤝 Community</div>\n<div class=\"mkt-sponsor-tier__price\">$1,000 <span>/year</span></div>\n<ul class=\"mkt-sponsor-tier__benefits\">\n<li>✅ Name on sponsors page</li>\n<li>✅ 1 free corporate membership</li>\n<li>✅ Community supporter badge</li>\n</ul>\n<a class=\"btn-secondary\" href=\"fundraising.html#donate-form\" style=\"width:100%;justify-content:center;\">Donate $1,000 →</a>\n</div>\n</div>\n</div>\n</section>\n<!-- Current Sponsors Placeholder -->\n<section class=\"section section--surface\" style=\"padding:5rem 0;\">\n<div class=\"container section__inner\">\n<div style=\"text-align:center;margin-bottom:3rem;\">\n<span class=\"section__eyebrow\">Our Sponsors</span>\n<h2 class=\"section__title\">Join Our Growing Sponsor Family</h2>\n<p class=\"section__sub\" style=\"margin:0 auto;\">We are actively seeking our founding sponsors. Be the first to partner with EmbeddedOS Foundation and shape the future of open embedded systems.</p>\n</div>\n<div class=\"mkt-sponsor-placeholder\">\n<div class=\"mkt-sponsor-placeholder__card\">\n<div class=\"mkt-sponsor-placeholder__logo\">Your Logo Here</div>\n<div class=\"mkt-sponsor-placeholder__tier\">Platinum Sponsor</div>\n</div>\n<div class=\"mkt-sponsor-placeholder__card\">\n<div class=\"mkt-sponsor-placeholder__logo\">Your Logo Here</div>\n<div class=\"mkt-sponsor-placeholder__tier\">Gold Sponsor</div>\n</div>\n<div class=\"mkt-sponsor-placeholder__card\">\n<div class=\"mkt-sponsor-placeholder__logo\">Your Logo Here</div>\n<div class=\"mkt-sponsor-placeholder__tier\">Gold Sponsor</div>\n</div>\n</div>\n<div style=\"text-align:center;margin-top:3rem;\">\n<a class=\"btn-primary\" href=\"contact.html\">Become a Founding Sponsor →</a>\n</div>\n</div>\n</section>\n<!-- Contact CTA -->\n<section class=\"mkt-fundraise-banner\" style=\"padding:5rem 0;\">\n<div class=\"mkt-fundraise-banner__bg\"></div>\n<div class=\"container mkt-fundraise-banner__inner\">\n<div class=\"mkt-fundraise-banner__text\">\n<h2>Ready to Partner?</h2>\n<p>Contact our partnerships team to discuss custom sponsorship packages, in-kind contributions, or research collaborations.</p>\n</div>\n<div class=\"mkt-fundraise-banner__actions\">\n<a class=\"btn-primary\" href=\"contact.html\">Contact Partnerships Team →</a>\n<a class=\"btn-secondary\" href=\"fundraising.html\">Make a Donation</a>\n</div>\n</div>\n</section>\n</main>";
---
<Base lang="en" legacy={false} cssHref="/css/style.v7.css" bodyClass="page-sponsors" rawHead={rawHead}>
<Fragment set:html={content} />
<script is:inline src="js/main.js" defer></script>
</Base>
